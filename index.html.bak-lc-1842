  <!-- ===== HERO PLAYER AO VIVO (rádio no topo, acima da dobra) ===== -->
  <style>
    .hr-wrap{position:relative;margin:0 0 16px;padding:20px 18px 26px;text-align:center;border-radius:0 0 18px 18px;
      min-height:clamp(540px,82vw,700px);display:flex;flex-direction:column;justify-content:flex-end;align-items:center;
      background:linear-gradient(180deg,rgba(10,10,15,.02) 0%,rgba(10,10,15,.10) 40%,rgba(10,10,15,.94) 100%),url('delorean_cover.jpg') center 14%/cover no-repeat;
      border-bottom:2px solid rgba(247,147,26,.75);box-shadow:0 14px 50px -14px rgba(247,147,26,.6)}
    .hr-seo{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
    .hr-sub{color:#fff;font-size:13px;font-weight:600;margin-bottom:16px;text-shadow:0 2px 8px rgba(0,0,0,.95)}
    .hr-live{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;letter-spacing:1.5px;color:#16c784;margin-bottom:14px}
    .hr-live i{width:9px;height:9px;border-radius:50%;background:#ea3943;display:inline-block;animation:hrPulse 1.2s infinite}
    .hr-play{display:inline-flex;align-items:center;gap:12px;border:0;cursor:pointer;
      background:linear-gradient(90deg,#f7931a,#ffce4d);color:#1a1206;font-weight:900;font-size:17px;letter-spacing:.5px;
      padding:15px 38px;border-radius:999px;box-shadow:0 8px 30px -6px rgba(247,147,26,.9);transition:transform .15s}
    .hr-play:hover{transform:translateY(-2px)}
    .hr-play .ic{font-size:20px}
    .hr-btns{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;align-items:center}
    .hr-play--econ{background:linear-gradient(90deg,#16c784,#3ddc9a);color:#04140d;box-shadow:0 8px 30px -6px rgba(22,199,132,.8)}
    .hr-nowplaying{color:#c8ffd4;font-size:12px;font-weight:600;margin-top:12px;min-height:16px;text-shadow:0 2px 8px rgba(0,0,0,.95)}
    .hr-aggs{margin-top:20px}
    .hr-aggs__lbl{color:#8a8a99;font-size:11px;text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px}
    .hr-aggs__row{display:flex;flex-wrap:wrap;justify-content:center;gap:9px}
    .hr-agg{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:700;color:#fff;text-decoration:none;
      background:#1b1b25;border:1px solid #2c2c3a;border-radius:10px;padding:9px 14px;transition:.15s}
    .hr-agg:hover{border-color:#f7931a;color:#f7931a;transform:translateY(-1px)}
    .hr-agg--soon{opacity:.5;cursor:default}
    .hr-agg--soon:hover{border-color:#2c2c3a;color:#fff;transform:none}
    .hr-agg .tag{font-size:8px;background:#33333f;color:#9a9aab;border-radius:5px;padding:1px 5px;letter-spacing:.5px}
    @keyframes hrPulse{0%,100%{opacity:1}50%{opacity:.25}}
  </style>
<!-- ===== AGENDA GLOBAL BITCOIN ===== -->
<style>
.agb{max-width:1100px;margin:18px auto 0;padding:0 14px}
.agb__head{background:linear-gradient(135deg,#06080f 0%,#0d1122 50%,#06080f 100%);border:1px solid rgba(242,169,0,.4);border-bottom:none;border-radius:14px 14px 0 0;padding:18px 24px 14px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.agb__logo{width:54px;height:54px;flex-shrink:0}
.agb__titles{flex:1;min-width:160px}
.agb__title{font-size:clamp(18px,5vw,28px);font-weight:900;color:#f2a900;letter-spacing:1px;font-family:ui-monospace,Menlo,monospace;line-height:1}
.agb__sub{font-size:11px;color:#8a8fa0;letter-spacing:2px;text-transform:uppercase;margin-top:4px}
.agb__yr{border:2px solid #f2a900;border-radius:8px;padding:6px 18px;font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:800;color:#f2a900;white-space:nowrap}
.agb__table{width:100%;border-collapse:collapse;background:#08090f;border:1px solid rgba(242,169,0,.3);border-radius:0 0 14px 14px;overflow:hidden}
.agb__table thead tr{background:rgba(242,169,0,.15)}
.agb__table thead th{padding:10px 16px;font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:2px;color:#f2a900;text-align:left;font-weight:800;text-transform:uppercase}
.agb__table thead th:first-child{width:42px;text-align:center}
.agb__table thead th:last-child{text-align:right}
.agb__row{border-top:1px solid rgba(255,255,255,.06);cursor:default;transition:background .15s}
.agb__row:hover{background:rgba(242,169,0,.05)}
.agb__row.clickable{cursor:pointer}
.agb__row.featured{background:linear-gradient(90deg,rgba(180,110,0,.25),rgba(242,169,0,.15),rgba(180,110,0,.25));border-top:1px solid rgba(242,169,0,.4)}
.agb__row.featured td{color:#f2d060;font-weight:800}
.agb__row.past td{opacity:.4}
.agb__row.next{background:rgba(34,197,94,.07)}
.agb__num{text-align:center;font-family:ui-monospace,Menlo,monospace;font-size:13px;font-weight:700;color:#555;padding:12px 10px}
.agb__row.featured .agb__num{color:#f2a900}
.agb__name{padding:12px 16px;font-size:14px;font-weight:700;color:#dde3f0}
.agb__name a{color:inherit;text-decoration:none}
.agb__name a:hover{color:#f2a900}
.agb__loc{padding:12px 16px;font-size:13px;color:#7a8090}
.agb__date{padding:12px 16px;font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#aab0c0;text-align:right;white-space:nowrap}
.agb__row.featured .agb__date{color:#f2d060}
.agb__badge{display:inline-block;font-size:9px;letter-spacing:1.5px;padding:2px 7px;border-radius:5px;margin-left:7px;font-family:ui-monospace,Menlo,monospace;vertical-align:middle}
.agb__badge.star{background:rgba(242,169,0,.2);color:#f2a900;border:1px solid rgba(242,169,0,.5)}
.agb__badge.next{background:rgba(34,197,94,.15);color:#22c55e;border:1px solid rgba(34,197,94,.4)}
.agb__footer{text-align:center;padding:10px 16px 14px;background:#08090f;border:1px solid rgba(242,169,0,.3);border-top:1px solid rgba(242,169,0,.15);border-radius:0 0 14px 14px;font-family:ui-monospace,Menlo,monospace;font-size:10px;letter-spacing:2px;color:#f2a900;text-transform:uppercase;margin-top:-1px}
@media(max-width:540px){.agb__loc{display:none}.agb__yr{display:none}.agb__head{gap:10px}}
</style>
<div class="agb">
  <a href="https://radiobitcoin.org/agenda.html" target="_blank" rel="noopener" style="display:block;border-radius:14px 14px 0 0;overflow:hidden;line-height:0">
    <img src="/agenda_global_banner.png" alt="Agenda Global Bitcoin 2026-2027 — Rádio Bitcoin" style="width:100%;height:auto;display:block;border-radius:14px 14px 0 0">
  </a>
  <div class="agb__head" style="border-radius:0;border-top:none">
    <svg class="agb__logo" viewBox="0 0 54 54" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="27" cy="27" r="26" stroke="#f2a900" stroke-width="1.5" fill="#06080f"/>
      <circle cx="27" cy="27" r="20" stroke="rgba(242,169,0,.35)" stroke-width="1"/>
      <text x="27" y="34" text-anchor="middle" font-size="22" font-weight="900" fill="#f2a900" font-family="monospace">₿</text>
    </svg>
    <div class="agb__titles">
      <div class="agb__title">AGENDA GLOBAL BITCOIN</div>
      <div class="agb__sub">Eventos que estão movendo a liberdade financeira</div>
    </div>
    <div class="agb__yr">2026 — 2027</div>
  </div>
  <table class="agb__table">
    <thead><tr>
      <th>#</th><th>EVENTO</th><th>LOCAL</th><th>DATA</th>
    </tr></thead>
    <tbody id="agbBody"></tbody>
  </table>
  <div class="agb__footer">Rádio Bitcoin &nbsp;·&nbsp; Conexões Globais &nbsp;·&nbsp; Liberdade Financeira</div>
</div>
<script>
(function(){
  var EVENTS=[
    {name:"Bitcoin Asia",loc:"🇭🇰 Hong Kong",date:"2026-08-27",url:"https://bitcoin.com/conferences"},
    {name:"Missão Bitcoin · 2ª Ed.",loc:"🇵🇾 Ciudad del Este, PY",date:"2026-09-19",url:"https://radiobitcoin.org/agenda.html"},
    {name:"Baltic Honeybadger",loc:"🇱🇻 Riga, Letônia",date:"2026-09-20",url:"https://baltichoneybadger.com"},
    {name:"Plan ₿ Forum Lugano",loc:"🇨🇭 Lugano, Suíça",date:"2026-10-23",url:"https://planb.lugano.ch"},
    {name:"Bitcoin Amsterdam",loc:"🇳🇱 Amsterdam",date:"2026-11-05",url:"https://b.tc/conference/amsterdam"},
    {name:"Bitcoin Histórico",loc:"🇸🇻 San Salvador, El Salvador",date:"2026-11-11",url:"https://bitcoinhistorico.com",featured:true},
    {name:"Africa Bitcoin Conference",loc:"🇲🇼 Blantyre, Malawi",date:"2026-12-02",url:"https://afrobitcoin.org"},
    {name:"Bitcoin MENA",loc:"🇦🇪 Abu Dhabi",date:"2026-12-15",url:"https://b.tc/conference/mena"},
    {name:"Plan ₿ Forum El Salvador",loc:"🇸🇻 San Salvador, El Salvador",date:"2027-01-29",url:"https://planb.lu"},
    {name:"Adopting Bitcoin 2027",loc:"🇿🇦 Cape Town, África do Sul",date:"2027-02-26",url:"https://za27.adoptingbitcoin.org"},
    {name:"Bitcoin 2027",loc:"🇺🇸 Nashville, EUA",date:"2027-07-15",url:"https://conference.b.tc"},
  ];
  var body=document.getElementById("agbBody");
  if(!body)return;
  var today=new Date(); today.setHours(0,0,0,0);
  var nextFound=false;
  EVENTS.forEach(function(ev,i){
    var d=new Date(ev.date+"T12:00:00"); d.setHours(0,0,0,0);
    var diff=Math.round((d-today)/(864e5));
    var isPast=diff<-1;
    var isNext=!nextFound&&!isPast; if(isNext)nextFound=true;
    var dateStr=ev.date.slice(8)+"/"+ev.date.slice(5,7)+"/"+ev.date.slice(0,4);
    var cls="agb__row"+(ev.featured?" featured":"")+(isPast?" past":"")+(isNext&&!ev.featured?" next":"");
    var badge=ev.featured?'<span class="agb__badge star">★ DESTAQUE</span>':(isNext?'<span class="agb__badge next">PRÓXIMO</span>':'');
    var nameCell=ev.url
      ?'<a href="'+ev.url+'" target="_blank" rel="noopener">'+ev.name+'</a>'+badge
      :ev.name+badge;
    var tr=document.createElement("tr");
    tr.className=cls+(ev.url?" clickable":"");
    if(ev.url){tr.onclick=function(u){return function(){window.open(u,"_blank")}}(ev.url);}
    tr.innerHTML='<td class="agb__num">'+(i+1)+'</td>'
      +'<td class="agb__name">'+nameCell+'</td>'
      +'<td class="agb__loc">'+ev.loc+'</td>'
      +'<td class="agb__date">'+dateStr+'</td>';
    body.appendChild(tr);
  });
})();
</script>
<!-- ===== FIM AGENDA GLOBAL BITCOIN ===== -->

<!-- ===== TOP ROTATOR: Novo por aqui ↔ Votação Satoshi ===== -->
<style>
@keyframes satoshi-pulse{0%,100%{opacity:1}50%{opacity:.82}}
.tpr{max-width:1100px;margin:12px auto 0;padding:0 14px}
.tpr__wrap{position:relative}
.tpr__slide{width:100%;opacity:0;transform:translateY(10px);transition:opacity .42s,transform .42s;position:absolute;top:0;left:0;pointer-events:none}
.tpr__slide.tpr-on{opacity:1;transform:translateY(0);position:relative;pointer-events:auto}
.tpr__nav{display:flex;justify-content:center;align-items:center;gap:8px;margin-top:8px}
.tpr__dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.18);cursor:pointer;border:none;padding:0;transition:.2s}
.tpr__dot.tpr-on{background:#f7931a;transform:scale(1.35)}
.tpr__arr{background:none;border:none;color:rgba(255,255,255,.3);font-size:18px;cursor:pointer;padding:0 4px;line-height:1;transition:.18s}
.tpr__arr:hover{color:#f7931a}
@media(max-width:600px){.tpr-cpq-btns{flex-direction:column}.tpr-cpq-btn{justify-content:center}}
</style>
<div class="tpr">
  <div class="tpr__wrap" id="tprWrap">

    <!-- SLIDE 0 — Novo por aqui -->
    <div class="tpr__slide tpr-on" id="tprS0">
      <div style="background:linear-gradient(135deg,#06080f,#0d1525 50%,#06080f);border:1px solid rgba(0,212,255,.22);border-radius:14px;padding:18px 20px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
        <div style="font-size:28px;flex-shrink:0">👋</div>
        <div style="flex:1;min-width:180px">
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:11px;font-weight:800;letter-spacing:3px;color:#00d4ff;text-transform:uppercase;margin-bottom:4px">Novo por aqui?</div>
          <div style="font-size:13px;color:#8a9ab0">Escolha como quer começar:</div>
        </div>
        <div class="tpr-cpq-btns" style="display:flex;gap:9px;flex-wrap:wrap;flex-shrink:0">
          <a class="tpr-cpq-btn" style="display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:9px;font-size:13px;font-weight:700;text-decoration:none;background:linear-gradient(90deg,#f7931a,#ffce4d);color:#1a0e00;box-shadow:0 4px 16px -4px rgba(247,147,26,.6)" href="#topo">📻 Ouvir ao vivo</a>
          <a class="tpr-cpq-btn" style="display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:9px;font-size:13px;font-weight:700;text-decoration:none;background:transparent;color:#00d4ff;border:1px solid rgba(0,212,255,.4)" href="https://t.me/Bitadictbot" target="_blank" rel="noopener">📬 Receber boletim</a>
          <a class="tpr-cpq-btn" style="display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:9px;font-size:13px;font-weight:700;text-decoration:none;background:transparent;color:#f2a900;border:1px solid rgba(242,169,0,.35)" href="agenda.html">📅 Ver agenda</a>
        </div>
      </div>
    </div>

    <!-- SLIDE 1 — Votação: Quem é Satoshi? -->
    <div class="tpr__slide" id="tprS1">
      <div style="border:1px solid rgba(242,169,0,0.6);border-radius:14px;padding:0;overflow:hidden;box-shadow:0 0 20px rgba(242,169,0,0.2);background:#06080f">
        <img loading="lazy" decoding="async" src="banner_satoshi_vote.jpg" alt="Quem é Satoshi Nakamoto?" style="width:100%;display:block;border-radius:6px 6px 0 0;max-height:110px;object-fit:cover;object-position:center 30%">
        <div style="background:linear-gradient(90deg,#f2a900,#ffcc00,#f2a900);padding:7px 14px;text-align:center;animation:satoshi-pulse 1.8s ease-in-out infinite">
          <div style="font-size:17px;font-weight:900;color:#000;letter-spacing:3px;text-transform:uppercase;line-height:1.1">🗳️ VOTE AQUI!</div>
          <div style="font-size:9px;color:#3b2800;font-weight:700;letter-spacing:1px;margin-top:1px">QUEM CRIOU O BITCOIN?</div>
        </div>
        <div style="padding:12px">
          <div style="font-size:9px;font-weight:800;letter-spacing:2px;color:#f2a900;text-transform:uppercase;margin-bottom:4px">🗳️ Quem é Satoshi Nakamoto?</div>
          <div style="font-size:8px;color:#6b7280;margin-bottom:8px">Vote em quem você acredita ser o criador do Bitcoin</div>
          <div id="svPlacar" style="margin-bottom:10px"></div>
          <div class="satoshi-vote-grid" id="satoshiGrid"></div>
          <div id="svMyVote" class="sv-my-vote" style="display:none"></div>
          <div style="display:flex;justify-content:space-between;align-items:center;margin-top:6px">
            <div class="sv-total" id="svTotal">0 votos</div>
            <button class="sv-reset" onclick="satoshiReset()">↺ resetar meu voto</button>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /tpr__wrap -->
  <div class="tpr__nav">
    <button class="tpr__arr" id="tprPrev">‹</button>
    <button class="tpr__dot tpr-on" data-i="0"></button>
    <button class="tpr__dot" data-i="1"></button>
    <button class="tpr__arr" id="tprNext">›</button>
  </div>
</div>
<script>
(function(){
  var slides=Array.from(document.querySelectorAll('.tpr__slide'));
  var dots=Array.from(document.querySelectorAll('.tpr__dot'));
  var cur=0,n=slides.length,timer;
  function show(i){
    slides[cur].classList.remove('tpr-on');
    dots[cur].classList.remove('tpr-on');
    cur=(i+n)%n;
    slides[cur].classList.add('tpr-on');
    dots[cur].classList.add('tpr-on');
  }
  function go(){timer=setInterval(function(){show(cur+1);},8000);}
  function reset(){clearInterval(timer);go();}
  dots.forEach(function(d){d.addEventListener('click',function(){show(+d.dataset.i);reset();});});
  document.getElementById('tprPrev').addEventListener('click',function(){show(cur-1);reset();});
  document.getElementById('tprNext').addEventListener('click',function(){show(cur+1);reset();});
  go();
})();
</script>
<!-- ===== FIM TOP ROTATOR ===== -->

  <section class="hr-wrap" id="topo">
