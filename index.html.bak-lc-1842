    <script>
    (function(){
      var b=document.getElementById('hrShare'); if(!b)return;
      var URL='https://radiobitcoin.org', TXT='📻 Rádio Bitcoin — 24h de notícias, mercado e música Bitcoin, sem KYC. Ouça ao vivo:';
      var menu=document.getElementById('hrShareMenu'), enc=encodeURIComponent;
      menu.querySelector('[data-net=wa]').href='https://wa.me/?text='+enc(TXT+' '+URL);
      menu.querySelector('[data-net=tg]').href='https://t.me/share/url?url='+enc(URL)+'&text='+enc(TXT);
      menu.querySelector('[data-net=x]').href='https://twitter.com/intent/tweet?text='+enc(TXT)+'&url='+enc(URL);
      b.addEventListener('click',function(e){
        e.stopPropagation();
        if(navigator.share){ navigator.share({title:'Rádio Bitcoin',text:TXT,url:URL}).catch(function(){}); }
        else { menu.classList.toggle('on'); }
      });
      document.getElementById('hrShCopy').addEventListener('click',function(e){
        e.stopPropagation(); var self=this;
        if(navigator.clipboard){ navigator.clipboard.writeText(URL).then(function(){ self.textContent='✓ Link copiado!'; setTimeout(function(){self.textContent='🔗 Copiar link';menu.classList.remove('on');},1400); }); }
        else { menu.classList.remove('on'); }
      });
      document.addEventListener('click',function(){ menu.classList.remove('on'); });
    })();
    </script>
    <audio id="liveAudio" preload="none" src="https://stream.radiobitcoin.org/radio"></audio>
    <audio id="econAudio" preload="none"></audio>
    <audio id="indiceAudio" preload="none" src="de_volta_pro_futuro.mp3"></audio>

    <div class="hr-aggs">
      <div class="hr-aggs__lbl">Ouça também nos apps de rádio</div>
      <div class="hr-aggs__row">
        <a class="hr-agg" href="https://www.radio-browser.info/search?name=Radio%20Bitcoin" target="_blank" rel="noopener">📻 Radio-Browser</a>
        <a class="hr-agg" id="aggTunein" href="https://tunein.com/radio/Radio-Bitcoin-s358551/" target="_blank" rel="noopener">🎧 TuneIn</a>
        <a class="hr-agg" id="aggSimple" href="https://streema.com/radios/Radio_Bitcoin" target="_blank" rel="noopener">🔊 Simple Radio</a>
        <a class="hr-agg" id="aggMytuner" href="https://mytuner-radio.com/radio/radio-bitcoin-520524/" target="_blank" rel="noopener">📱 myTuner</a>
        <a class="hr-agg" id="aggRadiosnet" href="https://www.radios.com.br/lista/busca?q=Radio%20Bitcoin" target="_blank" rel="noopener">🎙️ RadiosNet</a>
        <span class="hr-agg" id="alexaSay" style="cursor:pointer;border-color:#31c4f3;color:#31c4f3" title="Clica que EU falo com a sua Alexa 😉">🗣️ Diga: “Alexa, toca Rádio Bitcoin”</span>
        <script>
        // clicou -> toca um audio de voz NEURAL (diccao perfeita) e a Alexa da sala obedece.
        // (a voz sintetica do navegador enrolava e a Alexa entendia "radio byte")
        (function(){
          var el = document.getElementById('alexaSay');
          if (!el) return;
          var audio = null;
          el.addEventListener('click', function(){
            var orig = el.textContent;
            el.textContent = '🔊 Falando com a sua Alexa…';
            var volta = function(){ el.textContent = orig; };
            try {
              if (!audio) audio = new Audio('/alexa_comando.mp3?v=2');
              audio.volume = 1.0;
              audio.currentTime = 0;
              audio.onended = volta;
              audio.play().catch(function(){
                // fallback: voz do navegador
                try {
                  var u = new SpeechSynthesisUtterance('Alexa! Tocar, Rádio Bitcoin.');
                  u.lang = 'pt-BR'; u.volume = 1; u.rate = 0.8;
                  u.onend = volta;
                  speechSynthesis.speak(u);
                } catch(e) { volta(); }
              });
              setTimeout(volta, 8000);
            } catch(e) { volta(); }
          });
        })();
        </script>
      </div>
    </div>
  </section>

