function updateClock() {
  const now = new Date();
  const h = now.getHours().toString().padStart(2,'0');
  const m = now.getMinutes().toString().padStart(2,'0');
  const s = now.getSeconds().toString().padStart(2,'0');
  document.getElementById('clock').textContent = `${h}:${m}:${s}`;
  const d = now.toLocaleDateString('pt-BR');
  document.getElementById('dateDisp').textContent = d;
}
setInterval(updateClock, 1000); updateClock();

// ══════════════════════════════════════════════
// BTC PRICE — Binance API (sem rate limit)
// ══════════════════════════════════════════════
let sparkData = [];

const fmt   = n => '$' + Number(n).toLocaleString('en-US', {maximumFractionDigits:0});
const fmtChg = c => (c >= 0 ? '+' : '') + Number(c).toFixed(2) + '%';
const cls    = c => c >= 0 ? 'btc-up' : 'btc-down';

async function fetchBTC() {
  try {
    const BASE = 'https://api.binance.com/api/v3/ticker/24hr?symbol=';
    const [rBTC, rETH, rSOL, rBNB] = await Promise.all([
      fetch(BASE + 'BTCUSDT'),
      fetch(BASE + 'ETHUSDT'),
      fetch(BASE + 'SOLUSDT'),
      fetch(BASE + 'BNBUSDT'),
    ]);
    if (!rBTC.ok) throw new Error('Binance BTC ' + rBTC.status);
    const btc = await rBTC.json();

    const price = parseFloat(btc.lastPrice);
    const chg   = parseFloat(btc.priceChangePercent);
    const high  = parseFloat(btc.highPrice);
    const low   = parseFloat(btc.lowPrice);
    const vol   = parseFloat(btc.quoteVolume);

    // Header
    document.getElementById('hdrPrice').textContent = fmt(price);
    // HUD lateral (Quantum Pulse) — estavam eternamente "Carregando…"
    var _qb=document.getElementById('qpBtc'); if(_qb)_qb.textContent=fmt(price);
    var _qc=document.getElementById('qpChipBtc'); if(_qc)_qc.textContent=fmt(price);
    try{localStorage.setItem('rb_btc_cache',fmt(price));}catch(e){}

    const chgEl = document.getElementById('hdrChange');
    chgEl.textContent = fmtChg(chg);
    chgEl.className = 'btc-change ' + cls(chg);

    // Hero
    document.getElementById('heroPrice').textContent = fmt(price);
    const h24 = document.getElementById('hero24h');
    h24.textContent = fmtChg(chg);
    h24.className = 'v ' + cls(chg);
    document.getElementById('heroHigh').textContent = fmt(high);
    document.getElementById('heroLow').textContent  = fmt(low);
    document.getElementById('heroVol').textContent  = vol > 1e9 ? (vol/1e9).toFixed(1)+'B' : (vol/1e6).toFixed(0)+'M';

    // Ticker BTC
    document.getElementById('t-btc').textContent   = fmt(price);
    document.getElementById('tc-btc').textContent  = fmtChg(chg);
    document.getElementById('tc-btc').className    = 'tick-chg ' + cls(chg);
    document.getElementById('t-btc2').textContent  = fmt(price);
    document.getElementById('tc-btc2').textContent = fmtChg(chg);
    document.getElementById('tc-btc2').className   = 'tick-chg ' + cls(chg);

    // SATS
    const sats = Math.round(1e8 / price);
    document.getElementById('t-sats').textContent  = sats.toLocaleString();
    document.getElementById('t-sats2').textContent = sats.toLocaleString();

    // ETH
    if (rETH.ok) {
      const e = await rETH.json();
      const ep = parseFloat(e.lastPrice), ec = parseFloat(e.priceChangePercent);
      document.getElementById('t-eth').textContent   = fmt(ep);
      document.getElementById('tc-eth').textContent  = fmtChg(ec);
      document.getElementById('tc-eth').className    = 'tick-chg ' + cls(ec);
      document.getElementById('t-eth2').textContent  = fmt(ep);
      document.getElementById('tc-eth2').textContent = fmtChg(ec);
      document.getElementById('tc-eth2').className   = 'tick-chg ' + cls(ec);
    }
    // SOL
    if (rSOL.ok) {
      const s = await rSOL.json();
      const sp = parseFloat(s.lastPrice), sc = parseFloat(s.priceChangePercent);
      document.getElementById('t-sol').textContent   = fmt(sp);
      document.getElementById('tc-sol').textContent  = fmtChg(sc);
      document.getElementById('tc-sol').className    = 'tick-chg ' + cls(sc);
      document.getElementById('t-sol2').textContent  = fmt(sp);
      document.getElementById('tc-sol2').textContent = fmtChg(sc);
      document.getElementById('tc-sol2').className   = 'tick-chg ' + cls(sc);
    }
    // BNB
    if (rBNB.ok) {
      const b = await rBNB.json();
      const bp = parseFloat(b.lastPrice), bc = parseFloat(b.priceChangePercent);
      document.getElementById('t-bnb').textContent   = fmt(bp);
      document.getElementById('tc-bnb').textContent  = fmtChg(bc);
      document.getElementById('t-bnb2').textContent  = fmt(bp);
      document.getElementById('tc-bnb2').textContent = fmtChg(bc);
    }

    // Sparkline
    sparkData.push(price);
    if (sparkData.length > 60) sparkData.shift();
    drawSpark();

  } catch(e) { console.warn('BTC fetch:', e); }
}

async function fetchGlobal() {
  try {
    // CoinGecko apenas para dominância/mcap — intervalo longo para evitar rate limit
    const r = await fetch('https://api.coingecko.com/api/v3/global');
    if (!r.ok) throw new Error('CoinGecko global ' + r.status);
    const d = await r.json();
    if (d && d.data) {
      const dom = d.data.market_cap_percentage?.btc;
      if (dom) document.getElementById('sDom').textContent = dom.toFixed(1) + '%';
      const mc = d.data.total_market_cap?.usd;
      if (mc) document.getElementById('sMcap').textContent = (mc/1e12).toFixed(2) + 'T';
    }
  } catch(e) { console.warn('Global fetch:', e); }
}

async function fetchFear() {
  try {
    const r = await fetch('https://api.alternative.me/fng/');
    const d = r.ok ? await r.json() : null;
    if (d && d.data && d.data[0]) {
      const val = d.data[0].value;
      const lbl = d.data[0].value_classification;
      // cor dinâmica por sentimento (0=medo extremo → 100=ganância extrema)
      const nv = parseInt(val,10) || 0;
      const cor = nv<25 ? '#ef4444' : nv<45 ? '#f59e0b' : nv<55 ? '#eab308' : nv<75 ? '#84cc16' : '#22c55e';
      const sFearEl = document.getElementById('sFear');
      const sFearLblEl = document.getElementById('sFearLbl');
      const fearCard = document.getElementById('fearCard');
      sFearEl.textContent = val;
      sFearEl.style.color = cor;
      sFearEl.style.textShadow = '0 0 12px ' + cor + '66';
      sFearLblEl.textContent = lbl;
      sFearLblEl.style.color = cor;
      sFearLblEl.style.fontWeight = '700';
      if (fearCard) { fearCard.style.borderColor = cor + '99'; fearCard.style.boxShadow = '0 0 18px -6px ' + cor + '88'; }
      document.getElementById('t-fear').textContent = val;
      document.getElementById('tc-fear').textContent = lbl;
      document.getElementById('t-fear2').textContent = val;
      document.getElementById('tc-fear2').textContent = lbl;
    }
  } catch(e) {}
}

async function fetchBlock() {
  try {
    const r = await fetch('https://mempool.space/api/blocks/tip/height');
    const h = r.ok ? await r.json() : null;
    if (h) {
      document.getElementById('t-block').textContent = h.toLocaleString();
      var _qbl=document.getElementById('qpBlock'); if(_qbl)_qbl.textContent=h.toLocaleString();
      try{localStorage.setItem('rb_block_cache',h.toLocaleString());}catch(e){}

      document.getElementById('t-block2').textContent = h.toLocaleString();
      document.getElementById('footerBlock').textContent = 'BLOCO: ' + h.toLocaleString();
      // Halving a cada 210000 blocos — próximo
      const nextHalving = Math.ceil(h / 210000) * 210000;
      const rem = nextHalving - h;
      const days = Math.round(rem * 10 / 1440);
      document.getElementById('sHalving').textContent = days + 'd';
    }
  } catch(e) {}
}

function drawSpark() {
  const canvas = document.getElementById('btc-spark');
  const ctx = canvas.getContext('2d');
  canvas.width = canvas.offsetWidth * window.devicePixelRatio;
  canvas.height = 60 * window.devicePixelRatio;
  ctx.scale(window.devicePixelRatio, window.devicePixelRatio);
  const W = canvas.offsetWidth, H = 60;
  ctx.clearRect(0,0,W,H);
  if (sparkData.length < 2) return;
  const min = Math.min(...sparkData), max = Math.max(...sparkData);
  const range = max - min || 1;
  const pts = sparkData.map((v,i) => [
    (i / (sparkData.length-1)) * W,
    H - ((v - min) / range) * (H - 6) - 3
  ]);
  // Fill
  ctx.beginPath();
  ctx.moveTo(pts[0][0], H);
  pts.forEach(p => ctx.lineTo(p[0], p[1]));
  ctx.lineTo(pts[pts.length-1][0], H);
  ctx.closePath();
  ctx.fillStyle = 'rgba(242,169,0,0.1)';
  ctx.fill();
  // Line
  ctx.beginPath();
  pts.forEach((p,i) => i===0 ? ctx.moveTo(p[0],p[1]) : ctx.lineTo(p[0],p[1]));
  ctx.strokeStyle = '#f2a900';
  ctx.lineWidth = 1.5;
  ctx.stroke();
  // Dot
  const last = pts[pts.length-1];
  ctx.beginPath();
  ctx.arc(last[0], last[1], 3, 0, Math.PI*2);
  ctx.fillStyle = '#f2a900';
  ctx.fill();
}

fetchBTC(); fetchGlobal(); fetchFear(); fetchBlock();
setInterval(fetchBTC, 15000);    // Binance — sem rate limit, pode ser mais frequente
setInterval(fetchGlobal, 300000); // CoinGecko — só de 5 em 5 min para evitar rate limit
setInterval(fetchFear, 300000);
setInterval(fetchBlock, 60000);

// Polymarket 5min
async function fetchPolymarket() {
  try {
    const now = Math.floor(Date.now()/1000);
    const slot = now - (now % 300);
    const slug = `btc-updown-5m-${slot}`;
    const r = await fetch(`https://gamma-api.polymarket.com/markets?slug=${slug}`);
    const d = r.ok ? await r.json() : null;
    if (d && d[0] && d[0].tokens) {
      const tokens = d[0].tokens;
      const up = tokens.find(t => t.outcome?.toUpperCase() === 'UP');
      const dn = tokens.find(t => t.outcome?.toUpperCase() === 'DOWN');
      if (up && dn) {
        const upP = Math.round(parseFloat(up.price) * 100);
        const dnP = Math.round(parseFloat(dn.price) * 100);
        document.getElementById('polyUpBar').style.width = upP + '%';
        document.getElementById('polyDnBar').style.width = dnP + '%';
        document.getElementById('polyUpPct').textContent = upP + '%';
        document.getElementById('polyDnPct').textContent = dnP + '%';
      }
    }
  } catch(e) {}
}
fetchPolymarket();
setInterval(fetchPolymarket, 20000);

