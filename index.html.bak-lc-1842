  .sr-hero__title{font-weight:900;line-height:.95;margin:6px 0 4px;}
  .sr-hero__line1{display:block;font-size:clamp(14px,4vw,22px);color:#c8ffd4;letter-spacing:3px;text-transform:uppercase;}
  .sr-hero__line2{display:block;font-size:clamp(30px,8vw,58px);letter-spacing:2px;
    background:linear-gradient(180deg,#ffd76a,#f7a600 55%,#b97400);-webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 2px 12px rgba(247,166,0,.5));}
  .sr-hero__bonus{font-size:clamp(13px,3.5vw,19px);color:#fff;font-weight:700;margin:6px 0 4px;}
  .sr-hero__bonus b{color:#22c55e;font-size:1.15em;}
  .sr-hero__tasks{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin:10px 0 14px;}
  .sr-hero__task{font-size:11px;color:#e5e7eb;border:1px solid rgba(34,197,94,.3);border-radius:8px;padding:6px 12px;background:rgba(0,30,10,.6);}
  .sr-hero__task b{color:#4ade80;}
  .sr-hero__cta{display:inline-flex;align-items:center;gap:8px;background:linear-gradient(90deg,#f7a600,#ffce4d);color:#000;font-weight:900;font-size:16px;letter-spacing:1px;padding:13px 34px;border-radius:10px;text-decoration:none;box-shadow:0 6px 28px -6px rgba(247,166,0,.9);transition:transform .15s;}
  .sr-hero__cta:hover{transform:translateY(-2px);}
  .sr-hero__fine{font-size:9px;color:#4b5563;margin-top:10px;line-height:1.4;}
  .sr-hero__cd{display:flex;justify-content:center;gap:6px;margin:12px 0 4px;}
  .sr-hero__cd .u{background:rgba(0,0,0,.55);border:1px solid rgba(247,166,0,.35);border-radius:8px;padding:6px 10px;min-width:52px;}
  .sr-hero__cd .n{display:block;font-size:22px;font-weight:900;color:#f7a600;line-height:1;font-variant-numeric:tabular-nums;}
  .sr-hero__cd .l{display:block;font-size:9px;letter-spacing:1px;color:#9ca3af;text-transform:uppercase;margin-top:3px;}
  .sr-hero__deadline{font-size:11px;color:#c8ffd4;letter-spacing:1px;margin-top:6px;}
  @media(max-width:560px){.sr-hero__inner{padding:14px 12px 16px;}.sr-hero__line2{font-size:clamp(26px,10vw,42px);}.sr-hero__tasks{gap:6px;}.sr-hero__task{font-size:10px;padding:5px 9px;}.sr-hero__cd .u{min-width:44px;padding:5px 7px;}.sr-hero__cd .n{font-size:18px;}}
  </style>

