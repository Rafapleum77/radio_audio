}

// ══════════════════════════════════════════════
// NOSTR REAL — Relay wss://relay.damus.io
// ══════════════════════════════════════════════
const NOSTR_NPUB = 'npub1paqf0rwntldy09svmk3rgk7ppguuemxxcqpyph03pfsxwespg6jsz83k9n'; // BIT ADICT - chave rotacionada 2026-05-20
const NOSTR_RELAYS = [
  'wss://relay.damus.io',
  'wss://nos.lol',
  'wss://relay.nostr.band'
];

// Converter npub para hex pubkey
function npubToHex(npub) {
  const ALPHABET = 'qpzry9x8gf2tvdw0s3jn54khce6mua7l';
  const str = npub.slice(5); // remove 'npub1'
  let bits = 0, value = 0;
  const bytes = [];
  for (const char of str) {
    const idx = ALPHABET.indexOf(char);
    if (idx === -1) continue;
    value = (value << 5) | idx;
    bits += 5;
    if (bits >= 8) { bits -= 8; bytes.push((value >> bits) & 0xff); }
  }
  // Remove checksum (últimos 4 bytes) e data type byte (primeiro byte)
  const data = bytes.slice(1, bytes.length - 4);
  return data.map(b => b.toString(16).padStart(2, '0')).join('');
}

let nostrWs = null;
let nostrPubkey = '';
let nostrConnected = false;

function nostrSetStatus(txt, color) {
  const el = document.getElementById('nostrStatus');
  if (el) { el.textContent = txt; el.style.color = color; }
}

function nostrAddMsg(pubkey, content, created_at) {
  const feed = document.getElementById('nostrFeed');
  if (!feed) return;
  // Remover se for muito antigo (>24h)
  const age = Date.now()/1000 - created_at;
  if (age > 86400) return;
  // Limitar tamanho do conteúdo
  const txt = content.length > 120 ? content.slice(0, 120) + '...' : content;
  const shortKey = pubkey.slice(0,8) + '...';
  const isOwn = pubkey === nostrPubkey;
  const timeAgo = age < 3600 ? Math.floor(age/60) + 'm' : Math.floor(age/3600) + 'h';
  const div = document.createElement('div');
  div.className = 'nostr-item';
  div.style.borderColor = isOwn ? 'rgba(242,169,0,0.4)' : 'rgba(0,255,65,0.18)';
  div.innerHTML = `<div class="ni-head" style="color:${isOwn?'var(--gold)':'var(--g)'};">${isOwn?'⚡ @bitadict':'👤 '+shortKey} <span style="color:#333;float:right">${timeAgo} atrás</span></div>${txt}`;
  // Inserir no topo
  feed.insertBefore(div, feed.firstChild);
  if (feed.children.length > 10) feed.removeChild(feed.lastChild);
  if (isOwn) zapFlash();
}

function connectNostr(relayUrl) {
  if (nostrWs) { try { nostrWs.close(); } catch(e){} }
  nostrSetStatus('⬤ CONECTANDO', '#888');

  try {
    nostrPubkey = npubToHex(NOSTR_NPUB);
  } catch(e) {
    nostrSetStatus('⬤ ERRO NPUB', 'var(--red)');
    return;
  }

  nostrWs = new WebSocket(relayUrl);

  nostrWs.onopen = () => {
    nostrConnected = true;
    nostrSetStatus('⬤ ' + relayUrl.replace('wss://','').split('/')[0].toUpperCase(), 'var(--g)');

    // Subscrever posts do @bitadict (últimos 20)
    const subOwn = JSON.stringify(['REQ','bitadict-own',{authors:[nostrPubkey],kinds:[1],limit:20}]);
    nostrWs.send(subOwn);

    // Subscrever hashtag #bitcoin (últimos 10)
    const subBtc = JSON.stringify(['REQ','bitcoin-tag',{'#t':['bitcoin','radiobitadict'],kinds:[1],limit:10}]);
    nostrWs.send(subBtc);
  };

  nostrWs.onmessage = (e) => {
    try {
      const msg = JSON.parse(e.data);
      if (msg[0] === 'EVENT') {
        const ev = msg[2];
        if (ev && ev.kind === 1 && ev.content) {
          nostrAddMsg(ev.pubkey, ev.content, ev.created_at);
        }
      }
    } catch(err) {}
  };

  nostrWs.onclose = () => {
    nostrConnected = false;
    nostrSetStatus('⬤ DESCONECTADO', '#555');
    // Tentar próximo relay em 8s
    setTimeout(() => {
      const idx = NOSTR_RELAYS.indexOf(relayUrl);
      const next = NOSTR_RELAYS[(idx + 1) % NOSTR_RELAYS.length];
      connectNostr(next);
    }, 8000);
  };

  nostrWs.onerror = () => { nostrWs.close(); };
}

// Iniciar Nostr após 2s
setTimeout(() => connectNostr(NOSTR_RELAYS[0]), 2000);

