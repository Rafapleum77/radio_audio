    <!-- ============ COPA DO MUNDO 2026 ============ -->
    <div class="panel" id="copa-panel" style="border-color:rgba(0,200,83,0.4);padding:0;overflow:hidden;margin-bottom:10px;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:10px 12px;background:linear-gradient(135deg,#0a1a0f,#0d2818);border-bottom:1px solid rgba(0,200,83,0.25);">
        <div style="font-family:'Orbitron',ui-monospace,monospace;font-size:12px;font-weight:700;color:#00c853;letter-spacing:1px;">⚽ COPA DO MUNDO 2026</div>
        <div style="font-size:8px;color:#6b7280;font-family:ui-monospace,Menlo,monospace;" id="copa-upd">—</div>
      </div>
      <!-- tabs -->
      <div style="display:flex;flex-wrap:wrap;gap:0;border-bottom:1px solid rgba(0,200,83,0.15);">
        <button class="copa-tab" data-tab="brasil" onclick="copaTab('brasil',this)" style="flex:1;min-width:33%;background:transparent;border:none;color:#6b7280;font-family:ui-monospace,Menlo,monospace;font-size:9px;font-weight:700;letter-spacing:.5px;padding:8px 4px;cursor:pointer;">🇧🇷 BRASIL</button>
        <button class="copa-tab" data-tab="hoje" onclick="copaTab('hoje',this)" style="flex:1;min-width:33%;background:transparent;border:none;color:#6b7280;font-family:ui-monospace,Menlo,monospace;font-size:9px;font-weight:700;letter-spacing:.5px;padding:8px 4px;cursor:pointer;">📅 HOJE</button>
        <button class="copa-tab" data-tab="grupos" onclick="copaTab('grupos',this)" style="flex:1;min-width:33%;background:transparent;border:none;color:#6b7280;font-family:ui-monospace,Menlo,monospace;font-size:9px;font-weight:700;letter-spacing:.5px;padding:8px 4px;cursor:pointer;">🏆 GRUPOS</button>
        <button class="copa-tab" data-tab="resultados" onclick="copaTab('resultados',this)" style="flex:1;min-width:50%;background:transparent;border:none;color:#6b7280;font-family:ui-monospace,Menlo,monospace;font-size:9px;font-weight:700;letter-spacing:.5px;padding:8px 4px;cursor:pointer;border-top:1px solid rgba(0,200,83,0.1);">✅ RESULTADOS</button>
        <button class="copa-tab" data-tab="proximos" onclick="copaTab('proximos',this)" style="flex:1;min-width:50%;background:rgba(0,200,83,0.1);border:none;color:#00c853;font-family:ui-monospace,Menlo,monospace;font-size:9px;font-weight:700;letter-spacing:.5px;padding:8px 4px;cursor:pointer;border-top:1px solid rgba(0,200,83,0.1);">⏭ PRÓXIMOS</button>
      </div>
      <div id="copa-lista" style="max-height:340px;overflow-y:auto;padding:8px;">
        <div style="text-align:center;color:#6b7280;font-size:10px;padding:14px;">carregando jogos…</div>
      </div>
      <div style="font-size:7px;color:#4b5563;text-align:center;padding:6px;border-top:1px solid rgba(0,200,83,0.1);">Horários de Brasília · atualizado diariamente · TheSportsDB</div>
    </div>
    <script>
    (function(){
      var COPA=[]; var GRUPOS={}; var aba='proximos';
      function brtHoje(){ var d=new Date(); return d.toLocaleDateString('en-CA',{timeZone:'America/Sao_Paulo'}); }
      function flag(n){ return '<span style="color:#9ca3af;">'+n+'</span>'; }
      function jogoHTML(j){
        var temPlacar=j.jogado;
        var hora=(j.datahora_brt||'').slice(11) || '--:--';
        var placar = temPlacar
          ? '<span style="font-family:ui-monospace,Menlo,monospace;font-weight:800;color:#fff;font-size:13px;">'+j.placar_casa+' - '+j.placar_fora+'</span>'
          : '<span style="font-family:ui-monospace,Menlo,monospace;color:#00c853;font-size:11px;">'+hora+'</span>';
        return '<div style="display:flex;align-items:center;justify-content:space-between;padding:7px 9px;margin-bottom:4px;background:rgba(0,200,83,0.05);border-radius:6px;border-left:2px solid '+(temPlacar?'#00c853':'rgba(0,200,83,0.4)')+';">'
          +'<div style="flex:1;text-align:right;font-size:11px;color:#fff;">'+j.casa+'</div>'
          +'<div style="padding:0 10px;min-width:54px;text-align:center;">'+placar+'</div>'
          +'<div style="flex:1;font-size:11px;color:#fff;">'+j.fora+'</div>'
          +'</div>'
          +'<div style="font-size:7px;color:#4b5563;text-align:center;margin:-2px 0 6px;">'+j.rodada+'</div>';
      }
      function gruposHTML(){
        var gs=Object.keys(GRUPOS).sort();
        if(!gs.length) return '<div style="text-align:center;color:#6b7280;font-size:10px;padding:14px;">Classificação ainda não disponível.</div>';
        return gs.map(function(g){
          var rows=GRUPOS[g].map(function(t,i){
            var classifica=i<2; // 2 primeiros avançam (placeholder)
            return '<tr style="'+(classifica?'background:rgba(0,200,83,0.06);':'')+'">'
              +'<td style="padding:3px 4px;color:'+(classifica?'#00c853':'#9ca3af')+';">'+(i+1)+'</td>'
              +'<td style="padding:3px 4px;color:#fff;text-align:left;">'+(t.time==='Brazil'?'🇧🇷 ':'')+t.time+'</td>'
              +'<td style="padding:3px 4px;font-weight:800;color:#fff;">'+t.P+'</td>'
              +'<td style="padding:3px 4px;color:#9ca3af;">'+t.J+'</td>'
              +'<td style="padding:3px 4px;color:'+(t.SG>=0?'#4ade80':'#ef4444')+';">'+(t.SG>=0?'+':'')+t.SG+'</td></tr>';
          }).join('');
          return '<div style="margin-bottom:10px;">'
            +'<div style="font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#00c853;letter-spacing:1px;margin-bottom:3px;">GRUPO '+g+'</div>'
            +'<table style="width:100%;border-collapse:collapse;font-size:10px;font-family:ui-monospace,Menlo,monospace;text-align:center;">'
            +'<tr style="color:#4b5563;font-size:8px;"><td></td><td style="text-align:left;">TIME</td><td>P</td><td>J</td><td>SG</td></tr>'
            +rows+'</table></div>';
        }).join('');
      }
      function render(){
        var el=document.getElementById('copa-lista'); if(!el) return;
        if(aba==='grupos'){ el.innerHTML=gruposHTML(); return; }
        var hoje=brtHoje(); var lista=[];
        if(aba==='brasil') lista=COPA.filter(function(j){return j.casa==='Brazil'||j.fora==='Brazil';});
        else if(aba==='hoje') lista=COPA.filter(function(j){return (j.datahora_brt||'').slice(0,10)===hoje;});
        else if(aba==='resultados') lista=COPA.filter(function(j){return j.jogado;}).slice(-30).reverse();
        else lista=COPA.filter(function(j){return !j.jogado;}).slice(0,30);
        if(!lista.length){ el.innerHTML='<div style="text-align:center;color:#6b7280;font-size:10px;padding:14px;">'+(aba==='hoje'?'Sem jogos hoje. Veja Resultados ou Próximos.':(aba==='brasil'?'Jogos do Brasil em breve.':'Nada por aqui.'))+'</div>'; return; }
        el.innerHTML=lista.map(jogoHTML).join('');
      }
      window.copaTab=function(t,btn){
        aba=t;
        document.querySelectorAll('.copa-tab').forEach(function(b){ b.style.background='transparent'; b.style.color='#6b7280'; });
        if(btn){ btn.style.background='rgba(0,200,83,0.1)'; btn.style.color='#00c853'; }
        render();
      };
      fetch('copa2026.json?t='+Date.now()).then(function(r){return r.ok?r.json():null;}).then(function(d){
        if(!d){ document.getElementById('copa-lista').innerHTML='<div style="text-align:center;color:#6b7280;font-size:10px;padding:14px;">Jogos indisponíveis agora.</div>'; return; }
        COPA=d.jogos||[]; GRUPOS=d.grupos||{};
        var u=document.getElementById('copa-upd');
        if(u&&d.atualizado_em){ try{ u.textContent='⟳ '+new Date(d.atualizado_em).toLocaleDateString('pt-BR'); }catch(e){} }
        render();
      }).catch(function(){});
    })();
    </script>
    <!-- ============ FIM COPA DO MUNDO 2026 ============ -->

    <!-- ============ BOLÃO DA COPA EM SATS ============ -->
    <div class="panel" id="bolao-panel" style="border-color:rgba(242,169,0,0.4);padding:0;overflow:hidden;margin-bottom:10px;">
      <div style="padding:10px 12px;background:linear-gradient(135deg,#1a1206,#2a1e08);border-bottom:1px solid rgba(242,169,0,0.25);">
        <div style="font-family:'Orbitron',ui-monospace,monospace;font-size:12px;font-weight:700;color:#f2a900;letter-spacing:1px;">🏆 BOLÃO DA COPA · EM SATS ⚡</div>
        <div style="font-size:9px;color:#e5e7eb;margin-top:3px;line-height:1.4;">🔥 <b style="color:#f2a900;">Palpite grátis!</b> Acerte o campeão e leve o pool em <b style="color:#f2a900;">Bitcoin real (sats)</b>. Participe agora 👇</div>
        <div id="bolao-lider" style="display:none;font-size:9px;color:#f2a900;margin-top:5px;font-family:ui-monospace,Menlo,monospace;"></div>
      </div>
      <div id="bolao-votar" style="padding:10px;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:5px;" id="bolao-botoes"></div>
      </div>
      <div id="bolao-resultado" style="display:none;padding:10px;"></div>
      <!-- pool em sats -->
      <div style="padding:10px 12px;background:rgba(242,169,0,0.05);border-top:1px solid rgba(242,169,0,0.15);">
        <div style="font-size:10px;color:#c8d0dc;line-height:1.5;margin-bottom:8px;">
          💰 <b style="color:#f2a900;">Pool em sats:</b> <span id="bolao-pool">—</span><br>
          <span style="font-size:9px;color:#9ca3af;">Quem acertar o campeão divide o pool. Pra entrar, manda sats abaixo e teu palpite no Telegram <b style="color:#f2a900;">/bolao</b> com teu Lightning.</span>
        </div>
        <div style="display:flex;gap:6px;">
          <a href="lightning:texugorecords@walletofsatoshi.com" class="zap-btn" style="flex:1;text-align:center;background:linear-gradient(135deg,rgba(242,169,0,0.4),rgba(242,169,0,0.15));border:1px solid rgba(242,169,0,0.7);color:#f2a900;font-size:11px;font-weight:800;padding:11px;border-radius:7px;text-decoration:none;animation:cupomGlow 2.4s ease-in-out infinite;">⚡ ENTRAR NO POOL</a>
          <a href="https://t.me/Bitadictbot" target="_blank" rel="noopener" style="text-align:center;background:transparent;border:1px solid rgba(242,169,0,0.4);color:#9ca3af;font-size:10px;font-weight:700;padding:9px 12px;border-radius:7px;text-decoration:none;">📲 /bolao</a>
        </div>
      </div>
      <div style="font-size:7px;color:#4b5563;text-align:center;padding:6px;">Bolão recreativo · prêmio distribuído manualmente pelos organizadores</div>
    </div>
    <script>
    (function(){
      var API='https://l402.radiobitcoin.org';
      var TIMES=['Brasil','Argentina','França','Inglaterra','Espanha','Alemanha','Portugal','Holanda','Outra'];
      var jaVotou=false;
      try{ jaVotou=localStorage.getItem('bolao_voto_2026')!==null; }catch(e){}

      function renderBotoes(){
        var el=document.getElementById('bolao-botoes'); if(!el) return;
        el.innerHTML=TIMES.map(function(t){
          var br=t==='Brasil';
          return '<button onclick="bolaoVotar(\''+t+'\')" style="background:'+(br?'rgba(0,200,83,0.12)':'#0d1117')+';border:1px solid '+(br?'rgba(0,200,83,0.4)':'rgba(242,169,0,0.25)')+';color:'+(br?'#00c853':'#c8d0dc')+';font-size:10px;font-weight:700;padding:8px 4px;border-radius:6px;cursor:pointer;">'+(br?'🇧🇷 ':'')+t+'</button>';
        }).join('');
      }
      function renderResultado(votos,total){
        var el=document.getElementById('bolao-resultado'); if(!el) return;
        document.getElementById('bolao-votar').style.display='none';
        el.style.display='block';
        var arr=Object.keys(votos).map(function(k){return {t:k,n:votos[k]};}).sort(function(a,b){return b.n-a.n;});
        el.innerHTML='<div style="font-size:9px;color:#9ca3af;margin-bottom:8px;">✅ Voto registrado! '+total+' palpites:</div>'
          + arr.map(function(x){
            var pct=total?Math.round(100*x.n/total):0;
            var br=x.t==='Brasil';
            return '<div style="margin-bottom:6px;">'
              +'<div style="display:flex;justify-content:space-between;font-size:10px;color:'+(br?'#00c853':'#c8d0dc')+';margin-bottom:2px;"><span>'+(br?'🇧🇷 ':'')+x.t+'</span><span>'+pct+'% ('+x.n+')</span></div>'
              +'<div style="height:6px;background:rgba(255,255,255,0.05);border-radius:3px;overflow:hidden;"><div style="height:100%;width:'+pct+'%;background:'+(br?'#00c853':'#f2a900')+';border-radius:3px;"></div></div></div>';
          }).join('');
      }
      function carregaStats(){
        fetch(API+'/bolao/stats',{cache:'no-store'}).then(function(r){return r.json();}).then(function(d){
          var p=document.getElementById('bolao-pool');
          if(p) p.textContent=(d.pool_sats||0).toLocaleString('pt-BR')+' sats';
          // mini-ranking do líder
          var votos=d.votos||{}, total=d.total_votos||0;
          var lider=document.getElementById('bolao-lider');
          if(lider && total>0){
            var arr=Object.keys(votos).map(function(k){return {t:k,n:votos[k]};}).sort(function(a,b){return b.n-a.n;});
            var top=arr[0]; var pct=Math.round(100*top.n/total);
            lider.style.display='block';
            lider.innerHTML='📊 '+(top.t==='Brasil'?'🇧🇷 ':'')+'<b>'+top.t+'</b> lidera com '+pct+'% · '+total+' palpites';
          }
          if(jaVotou) renderResultado(votos, total);
        }).catch(function(){});
      }
      window.bolaoVotar=function(time){
        fetch(API+'/bolao/voto',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({time:time})})
          .then(function(r){return r.json();})
          .then(function(d){
            try{ localStorage.setItem('bolao_voto_2026',time); }catch(e){}
            jaVotou=true;
            renderResultado(d.votos||{}, d.total_votos||0);
          }).catch(function(){
            var v=document.getElementById('bolao-votar');
            if(v){ var m=document.createElement('div'); m.style.cssText='font-size:9px;color:#ef4444;text-align:center;margin-top:6px;'; m.textContent='Não consegui registrar agora — tenta de novo em instantes.'; v.appendChild(m); setTimeout(function(){m.remove();},3000); }
          });
      };
      renderBotoes(); carregaStats();
    })();
    </script>
