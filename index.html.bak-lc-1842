            <button class="stk-btn stk-btn-outline" onclick="stkClearGab()">🗑️ LIMPAR</button>
            <button class="stk-btn stk-btn-outline" onclick="window.print()">🖨️ IMPRIMIR</button>
          </div>
          <div class="stk-gab-outer">
            <table class="stk-gab-table" id="stk-gab-table"></table>
          </div>
        </div>

        <!-- Aba 3: Lista -->
        <div id="stk-tab-lista" class="stk-tab-pane">
          <div class="stk-table-filter">
            <input type="text" class="stk-input" placeholder="Filtrar palavras..." oninput="stkFilterTable(this.value)" style="max-width:300px;">
          </div>
          <div class="stk-table-wrap">
