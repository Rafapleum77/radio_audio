function addMsg(text, type) {
  const msgs = document.getElementById('chatMsgs');
  const div = document.createElement('div');
  div.className = 'msg ' + type;
  div.textContent = text;
  msgs.appendChild(div);
  msgs.scrollTop = msgs.scrollHeight;
}

function sendChat() {
  const inp = document.getElementById('chatIn');
  const q = inp.value.trim();
  if (!q) return;
  addMsg(q, 'user');
  inp.value = '';
  document.getElementById('chatBtn').disabled = true;
  setTimeout(() => {
    const resp = BITAI_RESPONSES[Math.floor(Math.random() * BITAI_RESPONSES.length)];
    addMsg(resp, 'ai');
    document.getElementById('chatBtn').disabled = false;
  }, 800 + Math.random() * 1000);
}

document.getElementById('chatIn').addEventListener('keydown', e => {
  if (e.key === 'Enter') sendChat();
});

// ══════════════════════════════════════════════
// TETRIS
// ══════════════════════════════════════════════
const canvas = document.getElementById('tetris');
const ctx = canvas.getContext('2d');
const COLS = 10, ROWS = 20;
ctx.scale(canvas.width / COLS, canvas.height / ROWS);
const scoreEl = document.getElementById('scoreEl');

const COLORS = ['','#ff0d72','#0dc2ff','#0dff72','#f538ff','#ff8e0d','#ffe138','#3877ff'];

function createPiece(type) {
  switch(type) {
    case 'I': return [[0,1,0,0],[0,1,0,0],[0,1,0,0],[0,1,0,0]];
    case 'L': return [[0,2,0],[0,2,0],[0,2,2]];
    case 'J': return [[0,3,0],[0,3,0],[3,3,0]];
    case 'O': return [[4,4],[4,4]];
    case 'S': return [[0,5,5],[5,5,0],[0,0,0]];
    case 'V': return [[6,6,0],[0,6,6],[0,0,0]];
    case 'T': return [[0,7,0],[7,7,7],[0,0,0]];
  }
}

function drawMatrix(m, off) {
  m.forEach((row, y) => row.forEach((v, x) => {
    if (v) {
      ctx.fillStyle = COLORS[v];
      ctx.fillRect(x+off.x, y+off.y, 1, 1);
      ctx.fillStyle = 'rgba(255,255,255,0.1)';
      ctx.fillRect(x+off.x+0.05, y+off.y+0.05, 0.9, 0.9);
    }
  }));
}

function rotate(m, dir) {
  for (let y = 0; y < m.length; y++)
    for (let x = 0; x < y; x++) [m[x][y], m[y][x]] = [m[y][x], m[x][y]];
  if (dir > 0) m.forEach(r => r.reverse()); else m.reverse();
}

function collide(ar, pl) {
  const [m,o] = [pl.matrix, pl.pos];
  for (let y = 0; y < m.length; y++)
    for (let x = 0; x < m[y].length; x++)
      if (m[y][x] && (ar[y+o.y] && ar[y+o.y][x+o.x]) !== 0) return true;
  return false;
}

function merge(ar, pl) {
  pl.matrix.forEach((row,y) => row.forEach((v,x) => { if(v) ar[y+pl.pos.y][x+pl.pos.x] = v; }));
}

function arenaSweep() {
  outer: for (let y = arena.length-1; y > 0; y--) {
    for (let x = 0; x < arena[y].length; x++) if (!arena[y][x]) continue outer;
    arena.splice(y,1)[0].fill(0); arena.unshift(new Array(COLS).fill(0));
    player.score += 10; y++;
  }
  scoreEl.textContent = player.score;
}

function playerDrop() {
  player.pos.y++;
  if (collide(arena, player)) { player.pos.y--; merge(arena, player); playerReset(); arenaSweep(); }
  dropCounter = 0;
}

function playerRotate(dir) {
  const pos = player.pos.x; let off = 1;
  rotate(player.matrix, dir);
  while (collide(arena, player)) {
    player.pos.x += off; off = -(off + (off > 0 ? 1 : -1));
    if (off > player.matrix[0].length) { rotate(player.matrix, -dir); player.pos.x = pos; return; }
  }
}

function playerReset() {
  const pieces = 'ILJOSVT';
  player.matrix = createPiece(pieces[Math.floor(Math.random()*pieces.length)]);
  player.pos.y = 0;
  player.pos.x = (COLS/2|0) - (player.matrix[0].length/2|0);
  if (collide(arena, player)) arena.forEach(r => r.fill(0));
}

const arena = Array.from({length:ROWS}, () => new Array(COLS).fill(0));
const player = {pos:{x:0,y:0}, matrix:null, score:0};
let dropCounter = 0, lastTime = 0;

function update(time=0) {
  const dt = time - lastTime; lastTime = time; dropCounter += dt;
  if (dropCounter > 900) playerDrop();
  ctx.fillStyle = '#000'; ctx.fillRect(0,0,COLS,ROWS);
  ctx.strokeStyle = 'rgba(0,255,65,0.04)'; ctx.lineWidth=0.05;
  drawMatrix(arena,{x:0,y:0}); if(player.matrix) drawMatrix(player.matrix, player.pos);
  requestAnimationFrame(update);
}

document.addEventListener('keydown', e => {
  if (e.keyCode===37){player.pos.x--;if(collide(arena,player))player.pos.x++;e.preventDefault();}
  if (e.keyCode===39){player.pos.x++;if(collide(arena,player))player.pos.x--;e.preventDefault();}
  if (e.keyCode===40){playerDrop();e.preventDefault();}
  if (e.keyCode===38){playerRotate(1);e.preventDefault();}
});

let tx0=0,ty0=0;
canvas.addEventListener('touchstart',e=>{tx0=e.touches[0].clientX;ty0=e.touches[0].clientY;},{passive:true});
canvas.addEventListener('touchend',e=>{
  const dx=e.changedTouches[0].clientX-tx0,dy=e.changedTouches[0].clientY-ty0;
  if(Math.abs(dx)>Math.abs(dy)){
    if(dx>15){player.pos.x++;if(collide(arena,player))player.pos.x--;}
    else if(dx<-15){player.pos.x--;if(collide(arena,player))player.pos.x++;}
  }else{if(dy>15)playerDrop();else if(dy<-15)playerRotate(1);}
},{passive:true});

playerReset(); update();

// ══════════════════════════════════════════════
// CAMPEONATO BITCOIN MUSIC
// ══════════════════════════════════════════════
const contestTracks = [
  {id:'TRACK-001', label:'BLIND ENTRY #001', sats:210},
  {id:'TRACK-002', label:'BLIND ENTRY #002', sats:500},
  {id:'TRACK-003', label:'BLIND ENTRY #003', sats:100},
];
let contestVotes = JSON.parse(localStorage.getItem('btcMusicVotes')||'{}');
let contestVotedFor = localStorage.getItem('btcMusicVotedFor')||null;
let contestOnAirIndex = 0;

function renderContest() {
  const el = document.getElementById('contest-tracks');
  if (!el) return;
  el.innerHTML = '';
  const total = Object.values(contestVotes).reduce((a,b)=>a+b,0)||1;
  contestTracks.forEach((track,i) => {
    const votes = contestVotes[track.id]||0;
    const pct = Math.round((votes/total)*100);
    const isVoted = contestVotedFor === track.id;
    const isOnAir = i === contestOnAirIndex;
    const div = document.createElement('div');
    div.className = 'contest-track'+(isOnAir?' on-air':'');
    div.innerHTML =
      '<div class="ct-header">'+
        '<span class="ct-id">'+track.label+(isOnAir?' ▶':'')+' </span>'+
        '<button class="ct-vote-btn'+(isVoted?' voted':'')+'" onclick="voteTrack(\''+track.id+'\')">'+
          (isVoted?'VOTADO ✓':'VOTAR')+
        '</button>'+
      '</div>'+
      '<div class="ct-sats">'+track.sats+' SATS • INSCRIÇÃO</div>'+
      '<div class="ct-bar-bg"><div class="ct-bar" style="width:'+(contestVotedFor?pct:0)+'%"></div></div>'+
      '<div class="ct-votes">'+(contestVotedFor?votes+' votos ('+pct+'%)':'Vote para ver resultados')+'</div>';
    el.appendChild(div);
  });
  const nameEl = document.getElementById('contest-track-name');
  if (nameEl) nameEl.textContent = contestTracks[contestOnAirIndex].label;
}

function voteTrack(trackId) {
  if (contestVotedFor) { addMsg('Já votaste nesta rodada!','sys'); return; }
  contestVotes[trackId] = (contestVotes[trackId]||0)+1;
  contestVotedFor = trackId;
  localStorage.setItem('btcMusicVotes', JSON.stringify(contestVotes));
  localStorage.setItem('btcMusicVotedFor', trackId);
  renderContest();
  addMsg('Voto registado! Autoria revelada no encerramento.','sys');
  zapFlash();
}

function zapFlash() {
  const el = document.getElementById('zapFlash');
  el.classList.add('active');
  setTimeout(()=>el.classList.remove('active'),300);
}

setInterval(()=>{
  contestOnAirIndex = (contestOnAirIndex+1)%contestTracks.length;
  renderContest();
}, 30000);
renderContest();

// Nostr real já inicializado acima via connectNostr()

// ── COMMODITIES ─────────────────────────────────────────────────
function _renderCommodities(d) {
  const map = [
    ['oil',    'cOilPrice',    'cOilChg',    2],
    ['gold',   'cGoldPrice',   'cGoldChg',   0],
    ['silver', 'cSilverPrice', 'cSilverChg', 2],
  ];
  map.forEach(([key, pId, cId, dec]) => {
    const item = d[key];
    if (!item) return;
    const pEl = document.getElementById(pId);
    const cEl = document.getElementById(cId);
    if (pEl) pEl.textContent = '$' + Number(item.price).toFixed(dec);
    if (cEl) {
      const chg = item.chg;
      cEl.textContent = (chg >= 0 ? '▲ +' : '▼ ') + Math.abs(chg).toFixed(2) + '%';
      cEl.style.color = chg >= 0 ? '#00ff41' : '#ff4444';
    }
  });
  const upd = document.getElementById('cUpdated');
  if (upd) upd.textContent = 'Yahoo Finance · ' + (d.ts || '--');
}

async function _commFromMacMini() {
  const r = await _localFetch('http://192.168.1.64:8080/RESULTADOS/commodities.json?t=' + Date.now());
  if (r && r.ok) return await r.json();
  return null;
}

async function _commFromProxy() {
  const syms = ['CL=F','GC=F','SI=F'];
  const keys = ['oil','gold','silver'];
  const decs = [2, 0, 2];
  const result = {};
  for (let i = 0; i < syms.length; i++) {
    try {
      const yurl = 'https://query2.finance.yahoo.com/v8/finance/chart/' + encodeURIComponent(syms[i]) + '?interval=1d&range=1d';
      const r = await fetch('https://api.allorigins.win/raw?url=' + encodeURIComponent(yurl));
      const d = await r.json();
      const meta = d.chart.result[0].meta;
      const price = meta.regularMarketPrice;
      const prev  = meta.chartPreviousClose || price;
      result[keys[i]] = { price: +price.toFixed(decs[i]), chg: +((price - prev) / prev * 100).toFixed(2) };
    } catch(e) {}
  }
  result.ts = new Date().toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
  return result.oil || result.gold || result.silver ? result : null;
}

async function _commFromStatic() {
  try {
    const r = await fetch('./commodities.json?t=' + Date.now());
    if (r && r.ok) return await r.json();
  } catch(e) {}
  return null;
}

async function fetchCommodities() {
  // Static primeiro: arquivo commodities.json (atualizado pelo updater + push) é o
  // que SEMPRE funciona pro visitante público. Proxy/LAN só como reforço ao vivo.
  const d = await _commFromStatic() || await _commFromProxy() || await _commFromMacMini();
  if (d) _renderCommodities(d);
}
fetchCommodities();
setInterval(fetchCommodities, 60000);

// ── UTILITÁRIO: fetch local com timeout ─────────────────────────
function _localFetch(url, opts, ms) {
  ms = ms || 3000;
  const ctrl = new AbortController();
  const tid  = setTimeout(() => ctrl.abort(), ms);
  return fetch(url, Object.assign({}, opts || {}, {signal: ctrl.signal}))
    .then(function(r){ clearTimeout(tid); return r; })
    .catch(function(){ clearTimeout(tid); return null; });
}

// ── BOT BITADICT STATS ──────────────────────────────────────────
let _botPrevPnl = null, _botPrevTrades = null, _botPrevStatus = null;

function _beepWin() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    [523, 659, 784].forEach((freq, i) => {
      const o = ctx.createOscillator(), g = ctx.createGain();
      o.connect(g); g.connect(ctx.destination);
      o.frequency.value = freq; o.type = 'sine';
      g.gain.setValueAtTime(0.18, ctx.currentTime + i * 0.12);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + i * 0.12 + 0.25);
      o.start(ctx.currentTime + i * 0.12);
      o.stop(ctx.currentTime + i * 0.12 + 0.3);
    });
  } catch(e) {}
}

function _beepLoss() {
  try {
    const ctx = new (window.AudioContext || window.webkitAudioContext)();
    const o = ctx.createOscillator(), g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.frequency.value = 220; o.type = 'sawtooth';
    g.gain.setValueAtTime(0.12, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.5);
    o.start(ctx.currentTime); o.stop(ctx.currentTime + 0.5);
  } catch(e) {}
}

function _flashPanel(color) {
  const p = document.getElementById('bot-panel');
  if (!p) return;
  p.style.transition = 'box-shadow 0.2s';
  p.style.boxShadow = `0 0 24px ${color}`;
  setTimeout(() => { p.style.boxShadow = ''; }, 1200);
}

function _botRender(d, fromCache) {
    const bot = (d.bots && d.bots.XRP) ? d.bots.XRP : null;
    const statusEl = document.getElementById('bStatus');
    if (!bot) {
      if (statusEl) { statusEl.textContent = '⏸ PAUSADO'; statusEl.style.color = '#f2a900'; }
      return;
    }
    const ageSec = Date.now()/1000 - (d.atualizado || 0);
    const ativo = bot.ativo && ageSec < 600;
    if (statusEl) {
      statusEl.textContent = ativo ? '▶ ATIVO' : '⏸ PAUSADO';
      statusEl.style.color  = ativo ? '#00ff41' : '#f2a900';
    }
    const banca = bot.banca || 0;
    const bancaEl = document.getElementById('bBanca');
    if (bancaEl) { bancaEl.textContent = '$' + banca.toFixed(2); bancaEl.style.color = '#00d4ff'; }
    const pnl = bot.pnl || 0;
    const pnlEl = document.getElementById('bPnl');
    if (pnlEl) { pnlEl.textContent = (pnl >= 0 ? '+' : '') + '$' + pnl.toFixed(2); pnlEl.style.color = pnl >= 0 ? '#00ff41' : '#ff4444'; }
    const trades = bot.trades || 0;
    const tradesEl = document.getElementById('bTrades');
    if (tradesEl) { tradesEl.textContent = trades; tradesEl.style.color = '#00d4ff'; }
    const ganhos = bot.ganhos || 0;
    const winRate = trades > 0 ? Math.round(ganhos / trades * 100) : 0;
    const winEl = document.getElementById('bWin');
    if (winEl) { winEl.textContent = winRate + '%'; winEl.style.color = winRate >= 55 ? '#00ff41' : winRate >= 45 ? '#f2a900' : '#ff4444'; }
    const rsi = bot.rsi || 50;
    const fngEl = document.getElementById('bFng');
    if (fngEl) {
      let fLabel, fColor;
      if (rsi >= 70)      { fLabel = 'GANÂNCIA'; fColor = '#00ff41'; }
      else if (rsi >= 55) { fLabel = 'NEUTRO+';  fColor = '#f2a900'; }
      else if (rsi >= 45) { fLabel = 'NEUTRO';   fColor = '#00d4ff'; }
      else if (rsi >= 30) { fLabel = 'MEDO';     fColor = '#f2a900'; }
      else                { fLabel = 'PÂNICO';   fColor = '#ff4444'; }
      fngEl.textContent = Math.round(rsi) + ' — ' + fLabel;
      fngEl.style.color = fColor;
    }
    const ts = new Date(d.atualizado * 1000).toLocaleTimeString('pt-BR');
    const updEl = document.getElementById('bUpdated');
    if (updEl) updEl.textContent = (fromCache ? '📦 cache · ' : 'ao vivo · ') + ts;
}

function _botRenderStats(s) {
  // renderiza a partir do stats_radio.json (fallback HTTPS GitHub Pages)
  const statusEl = document.getElementById('bStatus');
  const ativo = s.status === 'ATIVO';
  if (statusEl) { statusEl.textContent = ativo ? '▶ ATIVO' : '⏸ PAUSADO'; statusEl.style.color = ativo ? '#00ff41' : '#f2a900'; }
  const bancaEl = document.getElementById('bBanca');
  if (bancaEl) { bancaEl.textContent = '$' + (s.banca_atual||0).toFixed(2); bancaEl.style.color = '#00d4ff'; }
  const pnl = s.lucro_dia || 0;
  const pnlEl = document.getElementById('bPnl');
  if (pnlEl) { pnlEl.textContent = (pnl >= 0 ? '+' : '') + '$' + pnl.toFixed(2); pnlEl.style.color = pnl >= 0 ? '#00ff41' : '#ff4444'; }
  const tradesEl = document.getElementById('bTrades');
  if (tradesEl) { tradesEl.textContent = s.total_trades || 0; tradesEl.style.color = '#00d4ff'; }
  const win = s.taxa_acerto || 0;
  const winEl = document.getElementById('bWin');
  if (winEl) { winEl.textContent = win.toFixed(1) + '%'; winEl.style.color = win >= 55 ? '#00ff41' : win >= 45 ? '#f2a900' : '#ff4444'; }
  const fngEl = document.getElementById('bFng');
  if (fngEl) { fngEl.textContent = (s.sentimento_valor||'--') + ' — ' + (s.sentimento_label||'--'); fngEl.style.color = '#f2a900'; }
  const updEl = document.getElementById('bUpdated');
  if (updEl) updEl.textContent = '🌐 github · ' + (s.ultima_atualizacao || '--');
}

async function fetchBotStats() {
  // 1) tenta servidor local (LAN)
  try {
    const r = await _localFetch('http://192.168.1.64:8080/RESULTADOS/estado_global.json?t=' + Date.now());
    if (!r || !r.ok) throw new Error('lan_fail');
    const d = await r.json();
    try { localStorage.setItem('bot_estado', JSON.stringify({d, ts: Date.now()})); } catch(e) {}
    _botRender(d, false);
    const bot = (d.bots && d.bots.XRP) ? d.bots.XRP : null;
    if (bot) {
      const trades = bot.trades || 0, pnl = bot.pnl || 0;
      if (_botPrevTrades !== null && trades > _botPrevTrades) {
        const ganhou = pnl > (_botPrevPnl ?? pnl);
        if (ganhou) { _beepWin(); _flashPanel('#00ff41'); } else { _beepLoss(); _flashPanel('#ff4444'); }
      }
      _botPrevPnl = pnl; _botPrevTrades = trades; _botPrevStatus = bot.ativo ? 'ATIVO' : 'PAUSADO';
    }
    return;
  } catch(e) {}

  // 2) tenta stats_radio.json no GitHub Pages (HTTPS, atualizado pelo bot)
  try {
    const r = await fetch('./stats_radio.json?t=' + Date.now());
    if (r && r.ok) {
      const s = await r.json();
      _botRenderStats(s);
      return;
    }
  } catch(e) {}

  // 3) localStorage cache
  try {
    const cached = localStorage.getItem('bot_estado');
    if (cached) {
      const obj = JSON.parse(cached);
      _botRender(obj.d, true);
      const updEl = document.getElementById('bUpdated');
      if (updEl) updEl.textContent = '📦 cache · ' + Math.round((Date.now()-obj.ts)/60000) + 'min atrás';
      return;
    }
  } catch(e) {}

  // 4) sem dados
  const statusEl = document.getElementById('bStatus');
  if (statusEl) { statusEl.textContent = '⚠ OFFLINE'; statusEl.style.color = '#ff4444'; }
}
fetchBotStats();
setInterval(fetchBotStats, 15000); // atualiza a cada 15 segundos

