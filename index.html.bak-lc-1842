  .rb-bipa{max-width:1100px;margin:24px auto;padding:24px 18px;background:linear-gradient(160deg,#0a0713 0%,#0f0a1c 55%,#0a0713 100%);border:1px solid rgba(139,92,246,0.35);border-radius:12px;box-shadow:0 0 30px -10px rgba(139,92,246,0.28);text-align:center}
  .rb-bipa__badge{display:inline-block;background:rgba(139,92,246,0.12);border:1px solid rgba(139,92,246,0.4);color:#a78bfa;font-weight:900;font-size:9px;letter-spacing:2px;padding:4px 14px;border-radius:20px;text-transform:uppercase;margin-bottom:14px;font-family:ui-monospace,Menlo,monospace}
