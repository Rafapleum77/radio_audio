        </div>
        <div style="font-size:8.5px;color:#4b5563;text-align:center;margin-top:12px;line-height:1.6;border-top:1px solid rgba(255,255,255,0.05);padding-top:8px;">
          📌 Estimativas 2026 · <b style="color:#6b7280;">planejamento LEGAL (elisão), não evasão fiscal</b> · conteúdo educativo, <b style="color:#6b7280;">não é consultoria jurídica/tributária</b> — procure um profissional.
        </div>
        <script>
        (function(){
          var PAISES=[
            {f:'🇸🇻',n:'El Salvador',btc:'0%',btcC:'rf-0',acoes:'—',ac:'',nota:'Bitcoin é moeda de curso legal — zero imposto sobre ganho em BTC.',tag:'',tagc:'',star:false},
            {f:'🇦🇪',n:'Emirados (Dubai)',btc:'0%',btcC:'rf-0',acoes:'0%',ac:'rf-0',nota:'Sem imposto de renda nem ganho de capital para pessoa física.',tag:'',tagc:'',star:false},
            {f:'🇵🇾',n:'Paraguai',btc:'Territorial',btcC:'rf-0',acoes:'Territorial',ac:'rf-0',nota:'Renda de fora não é taxada. Residência fácil e cidadania acessível — a porta de entrada latina.',tag:'DESTAQUE',tagc:'background:#f2a900;color:#000;',star:true},
            {f:'🇨🇭',n:'Suíça',btc:'Isento*',btcC:'rf-0',acoes:'Isento*',ac:'rf-0',nota:'Ganho de capital privado isento (*se não for trader profissional).',tag:'',tagc:'',star:false},
            {f:'🇩🇪',n:'Alemanha',btc:'Isento >1 ano',btcC:'rf-0',acoes:'~26%',ac:'rf-mid',nota:'Segurou o BTC por mais de 1 ano? Ganho isento.',tag:'',tagc:'',star:false},
            {f:'🇵🇹',n:'Portugal',btc:'Isento >1 ano / 28%',btcC:'rf-mid',acoes:'28%',ac:'rf-mid',nota:'Cripto de longo prazo (>365 dias) isenta; curto prazo 28%.',tag:'',tagc:'',star:false},
            {f:'🇺🇸',n:'EUA',btc:'0–20%',btcC:'rf-mid',acoes:'0–20%',ac:'rf-mid',nota:'Longo prazo 0–20%; curto prazo tributado como renda comum.',tag:'',tagc:'',star:false},
            {f:'🇧🇷',n:'Brasil',btc:'15–22,5%',btcC:'rf-high',acoes:'15% (20% day)',ac:'rf-high',nota:'Isento se vender até R$35 mil/mês em cripto; acima disso, alíquota progressiva.',tag:'',tagc:'',star:false}
          ];
          var b=document.getElementById('rf-body'); if(!b) return;
          b.innerHTML=PAISES.map(function(p){
            return '<tr class="rf-row"'+(p.star?' style="background:rgba(242,169,0,0.06);"':'')+'>'
              +'<td><span class="rf-flag">'+p.f+'</span><span class="rf-country">'+p.n+'</span>'+(p.tag?'<span class="rf-tag" style="'+p.tagc+'">'+p.tag+'</span>':'')+'</td>'
              +'<td class="'+p.btcC+'">'+p.btc+'</td>'
              +'<td class="rf-hidecol '+p.ac+'">'+p.acoes+'</td>'
              +'<td><div class="rf-note">'+p.nota+'</div></td>'
              +'</tr>';
          }).join('');
        })();
        </script>
