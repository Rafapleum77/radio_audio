<!-- ===== FIM BANNER BIPA ===== -->

  <!-- TICKER -->
  <div id="ticker">
    <div class="ticker-inner" id="tickerInner">
      <div class="tick-item" style="background:rgba(242,169,0,0.12);border:1px solid rgba(242,169,0,0.5);border-radius:6px;padding:1px 9px;"><span class="tick-sym" style="color:#f2a900;font-weight:900;">₿ BTC</span><span class="tick-val" id="t-btc" style="color:#fff;font-weight:800;">$--</span><span class="tick-chg" id="tc-btc">--%</span></div>
      <div class="tick-item"><span class="tick-sym">ETH</span><span class="tick-val" id="t-eth">$--</span><span class="tick-chg" id="tc-eth">--%</span></div>
      <div class="tick-item"><span class="tick-sym">SOL</span><span class="tick-val" id="t-sol">$--</span><span class="tick-chg" id="tc-sol">--%</span></div>
      <div class="tick-item"><span class="tick-sym">BNB</span><span class="tick-val" id="t-bnb">$--</span><span class="tick-chg" id="tc-bnb">--%</span></div>
      <div class="tick-item"><span class="tick-sym">SATS</span><span class="tick-val" id="t-sats">--</span><span class="tick-chg">sats/$</span></div>
      <div class="tick-item"><span class="tick-sym">BLOCO</span><span class="tick-val" id="t-block">--</span><span class="tick-chg">altura</span></div>
      <div class="tick-item"><span class="tick-sym">HASH</span><span class="tick-val" id="t-hash">-- EH/s</span><span class="tick-chg">hashrate</span></div>
      <div class="tick-item"><span class="tick-sym">MEDO</span><span class="tick-val" id="t-fear">--</span><span class="tick-chg" id="tc-fear">--</span></div>
      <!-- duplicado para loop -->
      <div class="tick-item"><span class="tick-sym">BTC</span><span class="tick-val" id="t-btc2">$--</span><span class="tick-chg" id="tc-btc2">--%</span></div>
      <div class="tick-item"><span class="tick-sym">ETH</span><span class="tick-val" id="t-eth2">$--</span><span class="tick-chg" id="tc-eth2">--%</span></div>
      <div class="tick-item"><span class="tick-sym">SOL</span><span class="tick-val" id="t-sol2">$--</span><span class="tick-chg" id="tc-sol2">--%</span></div>
      <div class="tick-item"><span class="tick-sym">BNB</span><span class="tick-val" id="t-bnb2">$--</span><span class="tick-chg" id="tc-bnb2">--%</span></div>
      <div class="tick-item"><span class="tick-sym">SATS</span><span class="tick-val" id="t-sats2">--</span><span class="tick-chg">sats/$</span></div>
      <div class="tick-item"><span class="tick-sym">BLOCO</span><span class="tick-val" id="t-block2">--</span><span class="tick-chg">altura</span></div>
      <div class="tick-item"><span class="tick-sym">HASH</span><span class="tick-val" id="t-hash2">-- EH/s</span><span class="tick-chg">hashrate</span></div>
      <div class="tick-item"><span class="tick-sym">MEDO</span><span class="tick-val" id="t-fear2">--</span><span class="tick-chg" id="tc-fear2">--</span></div>
    </div>
  </div>

  <!-- MAIN -->
  <div id="main">

    <!-- LEFT -->
    <div id="left" style="display:flex;flex-direction:column;gap:8px;">

      <!-- BTC HERO -->
      <div id="btc-hero">
        <div class="btc-hero-symbol">₿ BITCOIN // BTC/USD</div>
        <div class="btc-hero-price" id="heroPrice">$--,---</div>
        <div class="btc-hero-row">
          <div class="btc-stat"><span class="k">24H</span><span class="v" id="hero24h">--%</span></div>
          <div class="btc-stat"><span class="k">HIGH</span><span class="v" id="heroHigh">$--</span></div>
          <div class="btc-stat"><span class="k">LOW</span><span class="v" id="heroLow">$--</span></div>
          <div class="btc-stat"><span class="k">VOL</span><span class="v" id="heroVol">--B</span></div>
        </div>
        <canvas id="btc-spark"></canvas>
      </div>

      <!-- PLAYER -->
      <div class="panel" id="player-panel">
        <div class="pt">📻 RADIO BITCOIN</div>
        <div id="player-btc-row">
          <span style="font-size:9px;color:#6b7280;font-family:ui-monospace,Menlo,monospace;letter-spacing:1px;">BTC/USD</span>
          <span id="player-btc-price">—</span>
          <span id="player-btc-change" class="pos">—</span>
        </div>

        <div class="now-playing">
          <div class="album-art" id="albumArt"><img loading="lazy" decoding="async" src="delorean_radio.jpg" alt="Rádio Bitcoin — DeLorean ao vivo" style="width:100%;height:100%;object-fit:cover;border-radius:6px;">₿</div>
          <div class="track-info">
            <div class="track-title" id="trackTitle">Selecione uma faixa</div>
            <div class="track-artist">@bitadict</div>
            <div class="track-dur"><span id="trackCur">0:00</span> / <span id="trackDur">0:00</span></div>
          </div>
        </div>

        <canvas id="visualizer"></canvas>

        <div class="progress-bar" id="progressBar">
          <div class="progress-fill" id="progressFill" style="width:0%"></div>
        </div>

        <div class="controls">
          <button class="ctrl-btn" id="btnShuffle" title="Shuffle">⇄</button>
          <button class="ctrl-btn" id="btnPrev" title="Anterior">⏮</button>
          <button class="ctrl-btn play-main" id="btnPlay" title="Play/Pause">▶</button>
          <button class="ctrl-btn" id="btnNext" title="Próxima">⏭</button>
          <button class="ctrl-btn" id="btnRepeat" title="Repetir">↺</button>
        </div>

        <div class="vol-row">
          <span style="font-size:10px">🔈</span>
          <input type="range" id="volSlider" min="0" max="1" step="0.02" value="0.8">
          <span style="font-size:10px">🔊</span>
          <span id="volVal" style="font-size:9px;color:var(--text-dim);min-width:28px">80%</span>
        </div>

        <audio id="audioEl" preload="auto"></audio>
        <button class="share-btn" onclick="shareOnX()">𝕏 COMPARTILHAR FAIXA ATUAL</button>

        <div class="pt" style="margin-top:10px;">📀 PLAYLIST</div>
        <div class="playlist" id="playlist"></div>

        <div class="pt" style="margin-top:10px;">📬 PEDIDOS</div>
        <div id="pedidos-list" style="padding:2px 0"></div>
        <div style="font-size:8px;color:var(--text-dim);margin-top:4px">
          Telegram: <span style="color:var(--g)">/pedir Nome da Música</span>
        </div>

        <!-- SUGESTÕES DE MÚSICAS BITCOINHEIRAS -->
        <div class="pt" style="margin-top:14px;">💡 SUGIRA UMA MÚSICA BITCOINHEIRA</div>
        <div style="margin-top:6px;">
          <input id="sugInput" type="text" placeholder="Nome da música + artista..."
            style="width:100%;background:#111827;border:1px solid #374151;color:#e5e7eb;font-family:-apple-system,Segoe UI,sans-serif;font-size:11px;padding:8px 10px;border-radius:6px;outline:none;box-sizing:border-box;"
            onkeydown="if(event.key==='Enter')enviarSugestao()">
          <button onclick="enviarSugestao()"
            style="margin-top:5px;width:100%;background:#1f2937;border:1px solid #374151;color:#e5e7eb;font-family:-apple-system,Segoe UI,sans-serif;font-size:11px;padding:8px;border-radius:6px;cursor:pointer;letter-spacing:0.5px;transition:background .2s;font-weight:600;"
            onmouseover="this.style.background='rgba(0,255,65,0.22)'" onmouseout="this.style.background='rgba(0,255,65,0.12)'">
            ⚡ ENVIAR SUGESTÃO
          </button>
        </div>
        <div id="sugestoes-list" style="margin-top:6px;max-height:120px;overflow-y:auto;"></div>
      </div>

    </div><!-- /left -->

    <!-- CENTER -->
    <div id="center">

      <!-- NOTÍCIA AO VIVO -->
      <div class="news-bar" id="newsBar" onclick="toggleNews()">
        <span class="nb-icon">📻</span>
        <span class="nb-label">◉ NOTÍCIA</span>
        <span class="nb-text" id="newsBarText">Clique para ouvir a última notícia Bitcoin</span>
        <span style="font-size:9px;color:var(--gold);">▶ OUVIR</span>
        <audio id="newsAudio" src="noticias.mp3" preload="none"></audio>
      </div>

      <!-- LIVE TICKER · trades reais dos bots -->
      <div id="rb-ticker" style="background:linear-gradient(90deg,#07090d 0%,#0b0e11 50%,#07090d 100%);border:1px solid rgba(34,197,94,0.25);border-radius:10px;padding:10px 0;margin:0 0 14px;overflow:hidden;position:relative;">
        <div style="display:flex;align-items:center;gap:10px;padding:0 14px 8px;border-bottom:1px solid rgba(255,255,255,0.05);">
          <span style="display:inline-block;width:8px;height:8px;background:#22c55e;border-radius:50%;animation:rb-pulse 1.4s infinite;"></span>
          <span style="font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#22c55e;letter-spacing:2px;text-transform:uppercase;">AO VIVO · TRADES REAIS DOS BOTS POLYMARKET</span>
          <span style="font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#9ca3af;margin-left:auto;" id="rb-ticker-ts">—</span>
        </div>
        <div id="rb-ticker-track" style="display:flex;gap:24px;padding:10px 14px;white-space:nowrap;animation:rb-marquee 60s linear infinite;font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#c8d0d8;">
          <span style="color:#9ca3af;">carregando trades reais...</span>
        </div>
        <div style="position:absolute;bottom:4px;left:14px;font-size:9px;color:#6b7280;font-family:ui-monospace,Menlo,monospace;">Bot real perde também. Sem promessa de retorno.</div>
      </div>
      <style>
        @keyframes rb-pulse { 0%,100% { opacity:1 } 50% { opacity:.3 } }
        @keyframes rb-marquee { from { transform:translateX(0); } to { transform:translateX(-50%); } }
        #rb-ticker:hover #rb-ticker-track { animation-play-state:paused; }
      </style>
      <script>
        (function(){
          fetch('/ticker_data.json?ts=' + Date.now(), {cache:'no-store'})
            .then(r => r.json())
            .then(d => {
              const items = d.items || [];
              if (!items.length) return;
              const html = items.concat(items).map(i => {
                const cor = i.pnl >= 0 ? '#22c55e' : '#ef4444';
                const sinal = i.pnl >= 0 ? '+' : '';
                return `<span style="display:inline-flex;align-items:center;gap:6px;">
                  <span style="color:#f2a900;font-weight:bold;">${i.bot}</span>
                  <span style="color:#9ca3af;">${i.moeda} ${i.direcao}</span>
                  <span style="color:${cor};font-weight:bold;">${sinal}$${i.pnl.toFixed(2)}</span>
                  <span style="color:#6b7280;font-size:10px;">${i.ts === 'live' ? '⚡ AO VIVO' : i.ts}</span>
                </span>`;
              }).join('<span style="color:#374151;">·</span>');
              document.getElementById('rb-ticker-track').innerHTML = html;
              const ts = d.atualizado ? new Date(d.atualizado).toLocaleString('pt-BR') : '';
              document.getElementById('rb-ticker-ts').textContent = ts;
            })
            .catch(() => {});
        })();
      </script>

      <!-- BANNER PACOTE BIT ADICT (TOPO) -->
