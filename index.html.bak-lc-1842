  <script>
  (function(){
    // Alcance total acumulado — estimativa honesta (~6.000 em jul/2026), cresce com o tempo
    var BASE = 6000, REF = Date.UTC(2026,6,15), POR_DIA = 28;
    var countEl = document.getElementById('listener-count');
    if(!countEl) return;
    function calc(){
      var dias = Math.max(0,(Date.now()-REF)/86400000);
      return Math.floor(BASE + dias*POR_DIA);
    }
    function tick(){ countEl.textContent = calc().toLocaleString('pt-BR'); }
    tick();
    setInterval(tick, 30000);
  })();
  </script>

