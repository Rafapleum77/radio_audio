<script>
(function(){
  var capas=[
    {title:"A Voz Não Se Apaga",img:"/capa_01_a_voz_nao_se_apaga.png",alt:"Capa A Voz Não Se Apaga — Bitcoin rompendo censura digital",col:"Liberdade Digital",isNew:true},
    {title:"Firewall da Liberdade",img:"/capa_02_firewall_da_liberdade.png",alt:"Capa Firewall da Liberdade — escudo de código aberto",col:"Liberdade Digital",isNew:true},
    {title:"Código Livre",img:"/capa_03_codigo_livre.png",alt:"Capa Código Livre — rede descentralizada de código aberto",col:"Liberdade Digital",isNew:true},
    {title:"Sinal Fora do Controle",img:"/capa_04_sinal_fora_do_controle.png",alt:"Capa Sinal Fora do Controle — ondas de rádio livres",col:"Liberdade Digital",isNew:false},
    {title:"Resistência Descentralizada",img:"/capa_05_resistencia_descentralizada.png",alt:"Capa Resistência Descentralizada — nós Bitcoin em malha global",col:"Liberdade Digital",isNew:false}
  ];
  var g=document.getElementById('ncGrid');if(!g)return;
  capas.forEach(function(c){
    var d=document.createElement('div');d.className='nc__card';
    d.innerHTML=(c.isNew?'<span class="nc__new">NOVO</span>':'')
      +'<img src="'+c.img+'" alt="'+c.alt+'" loading="lazy" width="300" height="300">'
      +'<div class="nc__info"><div class="nc__name">'+c.title+'</div><div class="nc__col">'+c.col+'</div></div>';
    g.appendChild(d);
  });
})();
</script>
