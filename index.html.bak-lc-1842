      <style>
/* ===== PAINEL ROTINA DO TREZOITÃO — prefixo .trz- ===== */
#trezoitao{background:#0d1018;border:1px solid rgba(242,169,0,.3);border-radius:8px;overflow:hidden;font-family:'Share Tech Mono',monospace;}
.trz-header{background:linear-gradient(135deg,#0d1018 0%,#1a1200 50%,#0d1018 100%);border-bottom:1px solid rgba(242,169,0,.4);padding:20px 20px 14px;display:flex;align-items:center;gap:16px;position:relative;flex-wrap:wrap;}
.trz-header::before{content:'▶ CANAL PARCEIRO · YOUTUBE';position:absolute;top:7px;left:20px;font-size:9px;color:#00ff88;letter-spacing:2px;font-family:'Orbitron',monospace;}
.trz-logo-container{flex-shrink:0;width:76px;height:76px;border-radius:50%;overflow:hidden;border:2px solid #f2a900;box-shadow:0 0 16px rgba(242,169,0,.4),0 0 32px rgba(242,169,0,.12);margin-top:6px;}
.trz-logo-container img{width:76px;height:76px;object-fit:cover;display:block;border-radius:50%;}
.trz-header-info{flex:1;margin-top:8px;}
.trz-channel-name{font-family:'Orbitron',monospace;font-size:20px;font-weight:900;color:#f2a900;text-shadow:0 0 10px rgba(242,169,0,.5);letter-spacing:1px;line-height:1.1;margin:0 0 3px;}
.trz-channel-sub{font-family:'Rajdhani',sans-serif;font-size:11px;color:#00f5ff;letter-spacing:2px;text-transform:uppercase;margin:0 0 8px;}
.trz-stats{display:flex;gap:18px;align-items:center;}
.trz-stat{text-align:center;}
.trz-stat-value{font-family:'VT323',monospace;font-size:20px;color:#00ff88;display:block;line-height:1;}
.trz-stat-label{font-size:8px;color:rgba(200,208,220,.6);text-transform:uppercase;letter-spacing:1px;}
.trz-header-actions{display:flex;flex-direction:column;gap:6px;margin-left:auto;}
.trz-btn-subscribe{background:#f2a900;color:#000;border:none;padding:7px 14px;font-family:'Orbitron',monospace;font-size:9px;font-weight:700;letter-spacing:1px;cursor:pointer;border-radius:3px;text-decoration:none;display:inline-block;text-align:center;transition:.2s;}
.trz-btn-subscribe:hover{background:#ff6b00;box-shadow:0 0 10px rgba(242,169,0,.6);}
.trz-btn-refresh{background:transparent;color:#00f5ff;border:1px solid #00f5ff;padding:6px 14px;font-family:'Orbitron',monospace;font-size:9px;letter-spacing:1px;cursor:pointer;border-radius:3px;transition:.2s;}
.trz-btn-refresh:hover{background:rgba(0,245,255,.1);box-shadow:0 0 8px rgba(0,245,255,.3);}
.trz-update-time{font-size:9px;color:rgba(200,208,220,.5);text-align:right;margin-top:2px;}
.trz-toolbar{background:#111622;border-bottom:1px solid rgba(0,245,255,.15);padding:10px 16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap;}
.trz-filter-btn{background:transparent;color:rgba(200,208,220,.7);border:1px solid rgba(200,208,220,.2);padding:4px 10px;font-family:'Rajdhani',sans-serif;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer;border-radius:3px;transition:.2s;}
.trz-filter-btn:hover,.trz-filter-btn.active{background:rgba(242,169,0,.15);color:#f2a900;border-color:#f2a900;}
.trz-search{flex:1;min-width:140px;background:#0a0e1a;border:1px solid rgba(0,245,255,.15);color:#c8d0dc;padding:5px 10px;font-family:'Share Tech Mono',monospace;font-size:12px;border-radius:3px;outline:none;}
.trz-search:focus{border-color:#f2a900;box-shadow:0 0 6px rgba(242,169,0,.2);}
.trz-view-btns{display:flex;gap:4px;margin-left:auto;}
.trz-view-btn{background:transparent;color:rgba(200,208,220,.5);border:1px solid rgba(200,208,220,.15);padding:4px 8px;font-size:14px;cursor:pointer;border-radius:3px;transition:.2s;}
.trz-view-btn.active,.trz-view-btn:hover{color:#f2a900;border-color:#f2a900;}
.trz-grid{padding:14px;display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:12px;}
.trz-grid.list-mode{grid-template-columns:1fr;}
.trz-card{background:#111622;border:1px solid rgba(0,245,255,.1);border-radius:6px;overflow:hidden;cursor:pointer;transition:.2s;text-decoration:none;display:block;color:#c8d0dc;}
.trz-card:hover{border-color:#f2a900;box-shadow:0 0 12px rgba(242,169,0,.2);transform:translateY(-2px);}
.trz-thumb-wrap{position:relative;width:100%;padding-top:56.25%;background:#000;overflow:hidden;}
.trz-thumb-wrap img{position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover;transition:transform .3s;}
.trz-card:hover .trz-thumb-wrap img{transform:scale(1.05);}
.trz-badge-new{position:absolute;top:6px;left:6px;background:#00ff88;color:#000;font-family:'Orbitron',monospace;font-size:8px;font-weight:700;padding:2px 6px;border-radius:2px;letter-spacing:1px;z-index:2;}
.trz-play-icon{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s;background:rgba(0,0,0,.3);}
.trz-card:hover .trz-play-icon{opacity:1;}
.trz-play-icon span{width:40px;height:40px;background:rgba(242,169,0,.9);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:16px;color:#000;padding-left:4px;}
.trz-card-body{padding:8px 10px;}
.trz-card-title{font-family:'Share Tech Mono',monospace;font-size:11px;color:#c8d0dc;line-height:1.4;margin:0 0 4px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.trz-card-date{font-size:10px;color:rgba(200,208,220,.4);}
.trz-card.list-card{display:flex;align-items:center;gap:12px;}
.trz-card.list-card .trz-thumb-wrap{width:160px;min-width:160px;padding-top:0;height:90px;flex-shrink:0;}
.trz-card.list-card .trz-thumb-wrap img{position:static;width:100%;height:100%;}
.trz-card.list-card .trz-card-title{-webkit-line-clamp:2;font-size:12px;}
.trz-footer{background:#111622;border-top:1px solid rgba(0,245,255,.1);padding:8px 16px;display:flex;align-items:center;justify-content:space-between;font-size:10px;color:rgba(200,208,220,.4);font-family:'Share Tech Mono',monospace;}
.trz-loading{text-align:center;padding:40px;color:#f2a900;font-family:'VT323',monospace;font-size:22px;letter-spacing:2px;}
.trz-error{text-align:center;padding:30px;color:rgba(200,208,220,.5);font-size:12px;font-family:'Share Tech Mono',monospace;}
@media(max-width:600px){.trz-grid{grid-template-columns:repeat(2,1fr);gap:8px;padding:10px;}.trz-channel-name{font-size:15px;}.trz-header-actions{display:none;}.trz-stats{gap:10px;}}
/* ===== FIM TREZOITÃO ===== */
      </style>
      <!-- ========== PAINEL ROTINA DO TREZOITÃO ========== -->
      <section id="trezoitao" style="margin:20px 0;">
        <div class="trz-header">
          <div class="trz-logo-container">
            <img loading="lazy" decoding="async" src="trz_foto_real.jpg" alt="Rotina do Trezoitão">
          </div>
          <div class="trz-header-info">
            <h2 class="trz-channel-name">ROTINA DO TREZOITÃO</h2>
            <p class="trz-channel-sub">Liberdade · Escola Austríaca · Bitcoin · Soberania</p>
            <div class="trz-stats">
              <div class="trz-stat"><span class="trz-stat-value" id="trz-subs">135K</span><span class="trz-stat-label">Inscritos</span></div>
              <div class="trz-stat"><span class="trz-stat-value" id="trz-total">—</span><span class="trz-stat-label">Vídeos</span></div>
              <div class="trz-stat"><span class="trz-stat-value" id="trz-last">—</span><span class="trz-stat-label">Último vídeo</span></div>
            </div>
          </div>
          <div class="trz-header-actions">
            <a href="https://www.youtube.com/@rotinadotrezoitao?sub_confirmation=1" target="_blank" class="trz-btn-subscribe">▶ INSCREVER-SE</a>
            <button class="trz-btn-refresh" onclick="trzLoadVideos(true)">↺ ATUALIZAR</button>
            <div class="trz-update-time" id="trz-update-time">Aguardando...</div>
          </div>
        </div>
        <div class="trz-toolbar">
          <button class="trz-filter-btn active" onclick="trzFilter('all',this)">TODOS</button>
          <button class="trz-filter-btn" onclick="trzFilter('bitcoin',this)">₿ BITCOIN</button>
          <button class="trz-filter-btn" onclick="trzFilter('liberdade',this)">LIBERDADE</button>
          <button class="trz-filter-btn" onclick="trzFilter('entrevista',this)">ENTREVISTAS</button>
          <input type="text" id="trz-search" class="trz-search" placeholder="Buscar vídeo..." oninput="trzSearch(this.value)">
          <div class="trz-view-btns">
            <button class="trz-view-btn active" id="trz-grid-btn" onclick="trzSetView('grid')" title="Grade">⊞</button>
            <button class="trz-view-btn" id="trz-list-btn" onclick="trzSetView('list')" title="Lista">☰</button>
          </div>
        </div>
        <div class="trz-grid" id="trz-grid"><div class="trz-loading">CARREGANDO VÍDEOS...</div></div>
        <div class="trz-footer">
          <span id="trz-count">Carregando...</span>
          <div style="display:flex;gap:12px;align-items:center;">
            <span style="color:rgba(200,208,220,.4);font-size:10px;">↺ Auto-atualização: 30min</span>
            <a href="https://www.youtube.com/@rotinadotrezoitao" target="_blank" style="color:var(--orange);text-decoration:none;font-family:'Orbitron',monospace;font-size:9px;letter-spacing:1px;">▶ VER CANAL →</a>
          </div>
        </div>
      </section>
      <!-- ========== FIM PAINEL ROTINA DO TREZOITÃO ========== -->
      <script>
(function(){
  var CHANNEL_ID = 'UCC-r6vnXtcwBYq0VxZYhoXg';
  var RSS = 'https://www.youtube.com/feeds/videos.xml?channel_id=' + CHANNEL_ID;
  var PROXIES = [
    'https://api.allorigins.win/get?url=' + encodeURIComponent(RSS),
    'https://corsproxy.io/?' + encodeURIComponent(RSS),
    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(RSS)
  ];
  var allVideos = [], currentFilter = 'all', currentView = 'grid', proxyIdx = 0;

  function relDate(d){
    var diff = Math.floor((Date.now() - new Date(d)) / 86400000);
    if(diff === 0) return 'Hoje';
    if(diff === 1) return 'Ontem';
    if(diff < 7)  return diff + ' dias atrás';
    if(diff < 30) return Math.floor(diff/7) + ' sem. atrás';
    if(diff < 365) return Math.floor(diff/30) + ' meses atrás';
    return Math.floor(diff/365) + ' ano(s) atrás';
  }

  function parseRSS(xml){
    var parser = new DOMParser();
    var doc = parser.parseFromString(xml, 'text/xml');
    var entries = doc.querySelectorAll('entry');
    var videos = [];
    entries.forEach(function(e){
      var id = (e.querySelector('videoId') || e.querySelector('id')).textContent.replace('yt:video:','');
      var title = e.querySelector('title').textContent;
      var published = e.querySelector('published').textContent;
      videos.push({
        id: id,
        title: title,
        date: published.substring(0,10),
        thumb: 'https://i.ytimg.com/vi/' + id + '/mqdefault.jpg',
        isNew: (Date.now() - new Date(published)) < 86400000 * 3
      });
    });
    return videos;
  }

  function trzRender(){
    var grid = document.getElementById('trz-grid');
    if(!grid) return;
    var q = (document.getElementById('trz-search')||{}).value || '';
    var filtered = allVideos.filter(function(v){
      var matchFilter = currentFilter === 'all' ||
        v.title.toLowerCase().includes(currentFilter === 'bitcoin' ? 'bitcoin' :
          currentFilter === 'liberdade' ? 'liber' :
          currentFilter === 'entrevista' ? 'entrev' : currentFilter);
      var matchSearch = !q || v.title.toLowerCase().includes(q.toLowerCase());
      return matchFilter && matchSearch;
    });

    if(!filtered.length){
      grid.innerHTML = '<div class="trz-error">Nenhum vídeo encontrado.</div>';
      return;
    }

    var isList = currentView === 'list';
    grid.className = 'trz-grid' + (isList ? ' list-mode' : '');
    grid.innerHTML = filtered.map(function(v, i){
      return '<a class="trz-card' + (isList ? ' list-card' : '') + '" href="https://www.youtube.com/watch?v=' + v.id + '" target="_blank" rel="noopener">' +
        '<div class="trz-thumb-wrap">' +
        '<img src="' + v.thumb + '" alt="' + v.title.replace(/"/g,'') + '" loading="lazy">' +
        (v.isNew ? '<span class="trz-badge-new">NOVO</span>' : '') +
        '<div class="trz-play-icon"><span>▶</span></div>' +
        '</div>' +
        '<div class="trz-card-body">' +
        '<div class="trz-card-title">' + v.title + '</div>' +
        '<div class="trz-card-date">' + relDate(v.date) + '</div>' +
        '</div></a>';
    }).join('');

    var countEl = document.getElementById('trz-count');
    var totalEl = document.getElementById('trz-total');
    var lastEl  = document.getElementById('trz-last');
    if(countEl) countEl.textContent = 'Exibindo ' + filtered.length + ' de ' + allVideos.length + ' vídeos';
    if(totalEl) totalEl.textContent = allVideos.length;
    if(lastEl && allVideos[0]) lastEl.textContent = relDate(allVideos[0].date);
  }

  // timeout helper — evita travar em "CARREGANDO" se um proxy pendurar
  function fetchT(url, ms){
    var ctrl = new AbortController();
    var tid = setTimeout(function(){ ctrl.abort(); }, ms || 6000);
    return fetch(url, {signal: ctrl.signal}).then(function(r){ clearTimeout(tid); return r; });
  }

  // 1ª opção: trezoitao.json estático (gerado no servidor, sem CORS — confiável)
  function fetchStatic(){
    return fetchT('./trezoitao.json?t=' + Date.now(), 5000)
      .then(function(r){ if(!r.ok) throw new Error('http'); return r.json(); })
      .then(function(j){
        var videos = (j.videos || []).map(function(v){
          return { id: v.id, title: v.title, date: v.date,
                   thumb: 'https://i.ytimg.com/vi/' + v.id + '/mqdefault.jpg',
                   isNew: (Date.now() - new Date(v.date)) < 86400000 * 3 };
        });
        if(!videos.length) throw new Error('empty');
        allVideos = videos;
        trzRender();
        var t = document.getElementById('trz-update-time');
        if(t) t.textContent = 'Atualizado: ' + new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
        return true;
      });
  }

  function fetchProxy(idx, force){
    if(idx >= PROXIES.length){ useFallback(); return; }
    fetchT(PROXIES[idx], 7000)
      .then(function(r){ return r.json(); })
      .then(function(j){
        var xml = j.contents || j.data || j;
        var videos = parseRSS(typeof xml === 'string' ? xml : JSON.stringify(xml));
        if(!videos.length) throw new Error('empty');
        allVideos = videos;
        trzRender();
        var t = document.getElementById('trz-update-time');
        if(t) t.textContent = 'Atualizado: ' + new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
      })
      .catch(function(){ fetchProxy(idx + 1, force); });
  }

  function useFallback(){
    // Gera cards placeholder com thumbs reais do canal
    var grid = document.getElementById('trz-grid');
    if(grid) grid.innerHTML = '<div class="trz-error">Feed offline — <a href="https://www.youtube.com/@rotinadotrezoitao" target="_blank" style="color:#f2a900;">Ver canal no YouTube ▶</a></div>';
    var countEl = document.getElementById('trz-count');
    if(countEl) countEl.textContent = 'Feed RSS temporariamente indisponível';
  }

  window.trzLoadVideos = function(force){
    var grid = document.getElementById('trz-grid');
    if(grid && (!allVideos.length || force)) {
      grid.innerHTML = '<div class="trz-loading">CARREGANDO VÍDEOS...</div>';
      // Estático primeiro (confiável); se falhar, tenta os proxies CORS
      fetchStatic().catch(function(){ fetchProxy(0, force); });
    }
  };

  window.trzFilter = function(f, btn){
    currentFilter = f;
    document.querySelectorAll('.trz-filter-btn').forEach(function(b){ b.classList.remove('active'); });
    if(btn) btn.classList.add('active');
    trzRender();
  };

  window.trzSearch = function(q){ trzRender(); };

  window.trzSetView = function(v){
    currentView = v;
    document.getElementById('trz-grid-btn').classList.toggle('active', v==='grid');
    document.getElementById('trz-list-btn').classList.toggle('active', v==='list');
    trzRender();
  };

  // Inicializa quando o DOM estiver pronto
  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', function(){ window.trzLoadVideos(false); });
  } else {
    window.trzLoadVideos(false);
  }

  // Auto-atualiza a cada 30 min
  setInterval(function(){ window.trzLoadVideos(true); }, 10 * 60 * 1000); // auto 10min
})();
      </script>

