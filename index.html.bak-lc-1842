<script>
(function(){try{
  var b=localStorage.getItem('rb_btc_cache'), bl=localStorage.getItem('rb_block_cache');
  function set(id,v){var e=document.getElementById(id); if(e&&v)e.textContent=v;}
  if(b){set('qpBtc',b);set('qpChipBtc',b);}
  if(bl)set('qpBlock',bl);
}catch(e){}})();
</script>
</body>
</html>