    .hr-share{--aic:#ff8c3c;display:inline-flex;flex-direction:column;align-items:center;gap:9px;cursor:pointer;padding:15px 18px;border-radius:18px;background:linear-gradient(160deg,color-mix(in srgb,var(--aic) 15%,transparent),rgba(8,14,26,.6));border:1px solid color-mix(in srgb,var(--aic) 50%,transparent);transition:transform .18s,box-shadow .2s,border-color .2s;min-width:112px;font-family:inherit}
    .hr-share:hover{transform:translateY(-3px);box-shadow:0 12px 30px -8px var(--aic);border-color:var(--aic)}
    .hr-share-img{display:block;width:50px;height:50px;object-fit:cover;border-radius:12px}
    .hr-share span{font-size:11px;font-weight:800;letter-spacing:.04em;color:#eef4ff;text-align:center;line-height:1.2;text-transform:uppercase}
    .hr-share-menu{display:none;position:absolute;left:50%;transform:translateX(-50%);top:calc(100% + 8px);background:#12121c;border:1px solid #2c2c3a;border-radius:12px;padding:6px;z-index:20;min-width:190px;box-shadow:0 14px 44px rgba(0,0,0,.65)}
