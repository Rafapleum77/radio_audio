      <!-- MAPA BITCOIN GLOBAL -->
      <div class="panel" id="mapa-bitcoin" style="background:linear-gradient(180deg,#040a06 0%,#050c07 100%);border-color:rgba(0,255,136,0.25);">
        <div class="pt" style="color:#00ff88;letter-spacing:3px;">⚡ MAPA BITCOIN — REDE DE APOIO GLOBAL</div>

        <style>
        #btcmap-leaflet{height:340px;border-radius:10px;border:1px solid rgba(0,255,136,0.2);overflow:hidden;margin:10px 0;}
        .btcmap-bar{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-bottom:10px;}
        .btcmap-filter{font-family:ui-monospace,Menlo,monospace;font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:5px 10px;border-radius:5px;cursor:pointer;border:1px solid rgba(0,255,136,0.2);color:#4b5563;background:#040a06;transition:all .15s;white-space:nowrap;}
        .btcmap-filter.active,.btcmap-filter:hover{color:#00ff88;border-color:rgba(0,255,136,0.65);background:rgba(0,255,136,0.08);}
        .btcmap-locbtn{font-family:ui-monospace,Menlo,monospace;font-size:8px;font-weight:700;letter-spacing:1px;padding:5px 12px;border-radius:5px;cursor:pointer;border:1px solid rgba(242,169,0,0.4);color:#f2a900;background:rgba(242,169,0,0.08);transition:all .15s;margin-left:auto;white-space:nowrap;}
        .btcmap-locbtn:hover{border-color:rgba(242,169,0,0.8);box-shadow:0 0 10px rgba(242,169,0,0.2);}
        .btcmap-stats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;}
        .btcmap-stat{background:rgba(0,255,136,0.06);border:1px solid rgba(0,255,136,0.15);border-radius:6px;padding:6px 12px;text-align:center;flex:1;min-width:70px;}
        .btcmap-stat .n{font-family:ui-monospace,Menlo,monospace;font-size:16px;font-weight:900;color:#00ff88;}
        .btcmap-stat .l{font-size:7.5px;color:#374151;letter-spacing:1px;text-transform:uppercase;font-family:ui-monospace,Menlo,monospace;}

        /* anuncio de voz */
        .btcmap-voice-bar{display:flex;align-items:center;gap:8px;background:rgba(242,169,0,0.07);border:1px solid rgba(242,169,0,0.2);border-radius:8px;padding:8px 12px;margin-bottom:10px;}
        .btcmap-voice-text{flex:1;font-size:9px;color:#9ca3af;font-family:ui-monospace,Menlo,monospace;line-height:1.4;}
        .btcmap-voice-text b{color:#f2a900;}
        .btcmap-voice-btn{font-size:9px;font-family:ui-monospace,Menlo,monospace;font-weight:700;padding:5px 10px;border-radius:5px;cursor:pointer;border:1px solid rgba(242,169,0,0.4);color:#f2a900;background:rgba(242,169,0,0.1);white-space:nowrap;transition:all .15s;}
        .btcmap-voice-btn:hover{background:rgba(242,169,0,0.2);}
        .btcmap-voice-bar.hidden{display:none;}

        /* lista */
        .btcmap-list{display:flex;flex-direction:column;gap:6px;margin-top:8px;max-height:320px;overflow-y:auto;}
        .btcmap-item{display:flex;gap:8px;align-items:flex-start;padding:9px 10px;background:#050c07;border:1px solid rgba(0,255,136,0.1);border-radius:8px;transition:border-color .15s;}
        .btcmap-item:hover{border-color:rgba(0,255,136,0.3);}
        .btcmap-item.apoio{border-color:rgba(242,169,0,0.3);background:linear-gradient(90deg,rgba(242,169,0,0.04),#050c07);}
        .btcmap-item-icon{font-size:20px;flex-shrink:0;width:28px;text-align:center;margin-top:1px;}
        .btcmap-item-body{flex:1;min-width:0;}
        .btcmap-item-name{font-size:10px;font-weight:700;color:#e5e7eb;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .btcmap-item-addr{font-size:8px;color:#4b5563;margin-top:1px;}
        .btcmap-item-tags{display:flex;gap:3px;flex-wrap:wrap;margin-top:4px;}
        .btcmap-tag{font-size:7px;font-family:ui-monospace,Menlo,monospace;font-weight:700;letter-spacing:.5px;padding:1px 6px;border-radius:8px;text-transform:uppercase;}
        .btcmap-tag.ln{background:rgba(0,255,136,0.1);color:#00ff88;border:1px solid rgba(0,255,136,0.25);}
        .btcmap-tag.onchain{background:rgba(242,169,0,0.1);color:#f2a900;border:1px solid rgba(242,169,0,0.25);}
        .btcmap-tag.atm{background:rgba(0,220,255,0.1);color:#00dcff;border:1px solid rgba(0,220,255,0.25);}
        .btcmap-tag.wifi{background:rgba(168,85,247,0.1);color:#c084fc;border:1px solid rgba(168,85,247,0.25);}
        .btcmap-tag.apoio{background:rgba(242,169,0,0.12);color:#f2a900;border:1px solid rgba(242,169,0,0.4);}
        .btcmap-tag.checkin{background:rgba(0,255,136,0.12);color:#00ff88;border:1px solid rgba(0,255,136,0.4);}
        .btcmap-item-right{display:flex;flex-direction:column;gap:4px;align-items:flex-end;flex-shrink:0;}
        .btcmap-navbtn{font-size:8px;padding:3px 7px;border-radius:4px;text-decoration:none;font-weight:700;font-family:ui-monospace,Menlo,monospace;white-space:nowrap;transition:all .15s;display:block;text-align:center;}
        .btcmap-navbtn.maps{background:rgba(66,133,244,0.15);color:#60a5fa;border:1px solid rgba(66,133,244,0.3);}
        .btcmap-navbtn.waze{background:rgba(0,212,70,0.1);color:#00d446;border:1px solid rgba(0,212,70,0.25);}
        .btcmap-navbtn.checkin-btn{background:rgba(0,255,136,0.08);color:#00ff88;border:1px solid rgba(0,255,136,0.25);cursor:pointer;}
        .btcmap-navbtn.checkin-btn:hover{background:rgba(0,255,136,0.2);}
        .btcmap-navbtn.checked{background:rgba(0,255,136,0.2);color:#00ff88;border-color:rgba(0,255,136,0.6);}
        .btcmap-loading{font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#374151;padding:20px;text-align:center;letter-spacing:1px;}
        .btcmap-src{font-size:7.5px;color:#374151;margin-top:10px;font-family:ui-monospace,Menlo,monospace;}
        .btcmap-checkin-modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;align-items:center;justify-content:center;}
        .btcmap-checkin-modal.open{display:flex;}
        .btcmap-checkin-box{background:#050c07;border:1px solid rgba(0,255,136,0.4);border-radius:12px;padding:20px;max-width:320px;width:90%;}
        .btcmap-checkin-title{font-size:12px;font-weight:900;color:#00ff88;margin-bottom:12px;font-family:ui-monospace,Menlo,monospace;}
        .btcmap-checkin-name{font-size:14px;font-weight:800;color:#e5e7eb;margin-bottom:14px;}
        .btcmap-checkin-opts{display:flex;flex-direction:column;gap:8px;margin-bottom:16px;}
        .btcmap-checkin-opt{display:flex;align-items:center;gap:8px;padding:8px 10px;border-radius:6px;border:1px solid rgba(255,255,255,0.08);cursor:pointer;font-size:11px;color:#9ca3af;transition:all .15s;}
        .btcmap-checkin-opt:hover,.btcmap-checkin-opt.sel{border-color:rgba(0,255,136,0.5);color:#e5e7eb;background:rgba(0,255,136,0.07);}
        .btcmap-checkin-stars{display:flex;gap:6px;margin-bottom:14px;}
        .btcmap-star{font-size:22px;cursor:pointer;opacity:.3;transition:opacity .1s;}
        .btcmap-star.lit{opacity:1;}
        .btcmap-checkin-btns{display:flex;gap:8px;}
        .btcmap-checkin-confirm{flex:1;padding:9px;border-radius:6px;background:rgba(0,255,136,0.15);color:#00ff88;border:1px solid rgba(0,255,136,0.4);font-family:ui-monospace,Menlo,monospace;font-weight:700;font-size:10px;cursor:pointer;letter-spacing:1px;}
        .btcmap-checkin-cancel{padding:9px 14px;border-radius:6px;background:transparent;color:#4b5563;border:1px solid rgba(255,255,255,0.08);font-family:ui-monospace,Menlo,monospace;font-size:10px;cursor:pointer;}
        </style>

        <!-- modal check-in -->
        <div class="btcmap-checkin-modal" id="bm-modal">
          <div class="btcmap-checkin-box">
            <div class="btcmap-checkin-title">⚡ CHECK-IN BITCOIN</div>
            <div class="btcmap-checkin-name" id="bm-modal-name"></div>
            <div style="font-size:9px;color:#6b7280;margin-bottom:10px;font-family:ui-monospace,Menlo,monospace;">Avalie o pagamento com Lightning:</div>
            <div class="btcmap-checkin-stars" id="bm-stars">
              <span class="btcmap-star" data-s="1">⭐</span>
              <span class="btcmap-star" data-s="2">⭐</span>
              <span class="btcmap-star" data-s="3">⭐</span>
              <span class="btcmap-star" data-s="4">⭐</span>
              <span class="btcmap-star" data-s="5">⭐</span>
            </div>
            <div class="btcmap-checkin-opts">
              <div class="btcmap-checkin-opt" data-v="ln_ok" onclick="bmSelOpt(this)">⚡ Lightning funcionou perfeitamente</div>
              <div class="btcmap-checkin-opt" data-v="onchain_ok" onclick="bmSelOpt(this)">₿ Paguei on-chain, funcionou</div>
              <div class="btcmap-checkin-opt" data-v="wifi" onclick="bmSelOpt(this)">📶 Tem Wi-Fi aberto para clientes BTC</div>
              <div class="btcmap-checkin-opt" data-v="problema" onclick="bmSelOpt(this)">⚠️ Tive algum problema</div>
            </div>
            <div class="btcmap-checkin-btns">
              <button class="btcmap-checkin-cancel" onclick="bmCloseModal()">Cancelar</button>
              <button class="btcmap-checkin-confirm" onclick="bmConfirmCheckin()">✅ CONFIRMAR CHECK-IN</button>
            </div>
          </div>
        </div>

        <!-- stats -->
        <div class="btcmap-stats">
          <div class="btcmap-stat"><div class="n" id="bm-total">6.800+</div><div class="l">Locais no mundo</div></div>
          <div class="btcmap-stat"><div class="n" id="bm-ln">…</div><div class="l">Lightning ⚡</div></div>
          <div class="btcmap-stat"><div class="n" id="bm-nearby">…</div><div class="l">Perto de você</div></div>
          <div class="btcmap-stat"><div class="n" id="bm-apoio">…</div><div class="l">Pontos de Apoio</div></div>
          <div class="btcmap-stat"><div class="n" id="bm-checkins">0</div><div class="l">Seus check-ins</div></div>
        </div>

        <!-- barra de anúncio de voz -->
        <div class="btcmap-voice-bar hidden" id="bm-voice-bar">
          <div class="btcmap-voice-text" id="bm-voice-text"><b>Radio Bitcoin:</b> …</div>
          <button class="btcmap-voice-btn" onclick="bmFalarAnuncio()">🔊 OUVIR</button>
        </div>

        <!-- filtros -->
        <div class="btcmap-bar">
          <button class="btcmap-filter active" onclick="bmFilter(this,'all')">🌐 Todos</button>
          <button class="btcmap-filter" onclick="bmFilter(this,'food')">☕ Café & Food</button>
          <button class="btcmap-filter" onclick="bmFilter(this,'atm')">🏧 ATM</button>
          <button class="btcmap-filter" onclick="bmFilter(this,'hotel')">🏨 Hotel</button>
          <button class="btcmap-filter" onclick="bmFilter(this,'shop')">🛍️ Loja</button>
          <button class="btcmap-filter" onclick="bmFilter(this,'apoio')" style="border-color:rgba(242,169,0,0.3);color:#f2a900;">🏅 Ponto de Apoio</button>
          <button class="btcmap-locbtn" onclick="bmMinhaLoc()">📍 Minha localização</button>
        </div>

        <!-- mapa -->
        <div id="btcmap-leaflet"><div class="btcmap-loading">Carregando mapa…</div></div>

        <!-- lista próximos -->
        <div id="btcmap-list-wrap" style="display:none;margin-top:10px;">
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#00ff88;margin-bottom:6px;letter-spacing:1px;">⚡ LOCAIS PRÓXIMOS — CLIQUE EM ✅ PARA FAZER CHECK-IN</div>
          <div class="btcmap-list" id="btcmap-list"></div>
        </div>

        <div class="btcmap-src">Dados: <a href="https://btcmap.org" target="_blank" style="color:#00ff88;">BTCMap.org</a> (open source) · Check-ins salvos localmente · <a href="https://btcmap.org/add-location" target="_blank" style="color:#00ff88;">Adicionar local »</a></div>

        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        
      </div>

      <!-- CALENDÁRIO BITCOIN -->
      <div class="panel" id="calendario-btc" style="background:linear-gradient(180deg,#050a08 0%,#060c09 100%);border-color:rgba(0,255,136,0.2);">
        <div class="pt" style="color:#00ff88;letter-spacing:3px;">📅 CALENDÁRIO BITCOIN 2026 — CONFERÊNCIAS GLOBAIS</div>

        <style>
        /* ── CALENDÁRIO BTC ── */
        .cal-months{display:flex;gap:4px;flex-wrap:wrap;margin:10px 0 14px;}
        .cal-month-btn{font-family:ui-monospace,Menlo,monospace;font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:5px 10px;border-radius:5px;cursor:pointer;border:1px solid rgba(0,255,136,0.2);color:#4b5563;background:#050a08;transition:all .15s;white-space:nowrap;}
        .cal-month-btn.has-event{color:#6b7280;border-color:rgba(0,255,136,0.3);}
        .cal-month-btn.active,.cal-month-btn:hover{color:#00ff88;border-color:rgba(0,255,136,0.7);background:rgba(0,255,136,0.08);box-shadow:0 0 10px rgba(0,255,136,0.1);}
        .cal-month-btn.active{font-weight:900;}

        .cal-events-list{display:flex;flex-direction:column;gap:8px;min-height:60px;}
        .cal-event{display:flex;gap:10px;align-items:flex-start;padding:10px 12px;border-radius:8px;background:#060c09;border:1px solid rgba(255,255,255,0.07);transition:border-color .15s;text-decoration:none;}
        .cal-event:hover{border-color:rgba(0,255,136,0.3);}
        .cal-event.tier1{border-left:3px solid #00ff88;}
        .cal-event.tier2{border-left:3px solid #00dcff;}
        .cal-event.tier3{border-left:3px solid #f2a900;}
        .cal-event.tier4{border-left:3px solid #a855f7;}
        .cal-ev-date{font-family:ui-monospace,Menlo,monospace;font-size:20px;font-weight:900;line-height:1;flex-shrink:0;width:32px;text-align:center;}
        .cal-event.tier1 .cal-ev-date{color:#00ff88;}
        .cal-event.tier2 .cal-ev-date{color:#00dcff;}
        .cal-event.tier3 .cal-ev-date{color:#f2a900;}
        .cal-event.tier4 .cal-ev-date{color:#a855f7;}
        .cal-ev-month-mini{font-family:ui-monospace,Menlo,monospace;font-size:7px;color:#374151;text-transform:uppercase;letter-spacing:1px;text-align:center;}
        .cal-ev-body{flex:1;}
        .cal-ev-name{font-size:11px;font-weight:800;color:#e5e7eb;margin-bottom:2px;}
        .cal-ev-loc{font-size:9px;color:#6b7280;}
        .cal-ev-loc b{color:#9ca3af;}
        .cal-ev-tags{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;}
        .cal-ev-tag{font-size:7px;font-family:ui-monospace,Menlo,monospace;font-weight:700;letter-spacing:.8px;padding:2px 7px;border-radius:10px;text-transform:uppercase;}
        .cal-ev-tag.g{background:rgba(0,255,136,0.1);color:#00ff88;border:1px solid rgba(0,255,136,0.25);}
        .cal-ev-tag.b{background:rgba(0,220,255,0.1);color:#00dcff;border:1px solid rgba(0,220,255,0.25);}
        .cal-ev-tag.o{background:rgba(242,169,0,0.1);color:#f2a900;border:1px solid rgba(242,169,0,0.25);}
        .cal-ev-tag.p{background:rgba(168,85,247,0.1);color:#c084fc;border:1px solid rgba(168,85,247,0.25);}
        .cal-ev-tag.r{background:rgba(239,68,68,0.1);color:#f87171;border:1px solid rgba(239,68,68,0.25);}

        .cal-empty{font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#374151;padding:16px;text-align:center;letter-spacing:1px;}
        .cal-legend{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px;}
        .cal-leg{display:flex;align-items:center;gap:4px;font-size:8px;color:#4b5563;font-family:ui-monospace,Menlo,monospace;}
        .cal-leg-bar{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
        .cal-all-btn{font-family:ui-monospace,Menlo,monospace;font-size:8px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:5px 12px;border-radius:5px;cursor:pointer;border:1px solid rgba(255,255,255,0.1);color:#6b7280;background:transparent;transition:all .15s;margin-left:auto;}
        .cal-all-btn.active,.cal-all-btn:hover{color:#e5e7eb;border-color:rgba(255,255,255,0.3);}
        .cal-header-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px;}
        </style>

        <div class="cal-legend">
          <div class="cal-leg"><div class="cal-leg-bar" style="background:#00ff88;"></div>Tier 1 — Must-go global</div>
          <div class="cal-leg"><div class="cal-leg-bar" style="background:#00dcff;"></div>Tier 2 — Top regional</div>
          <div class="cal-leg"><div class="cal-leg-bar" style="background:#f2a900;"></div>Tier 3 — LATAM / BR</div>
          <div class="cal-leg"><div class="cal-leg-bar" style="background:#a855f7;"></div>Tier 4 — Mining / Tech</div>
        </div>

        <div class="cal-header-row">
          <div class="cal-months" id="cal-months-row"></div>
          <button class="cal-all-btn" id="cal-all-btn" onclick="calShowAll()">VER TODOS</button>
        </div>

        <div class="cal-events-list" id="cal-events-list"></div>

        <div style="font-size:7.5px;color:#374151;margin-top:12px;font-family:ui-monospace,Menlo,monospace;">* Datas estimadas com base em edições anteriores. Confirme no site oficial antes de viajar.</div>

        <script>
        (function(){
          var EVENTS = [
            // JAN
            {day:20,month:1,name:'Bitcoin Policy Summit',loc:'Washington D.C., EUA',desc:'Lobby e política Bitcoin nos EUA',tags:[{l:'Política',c:'b'},{l:'EUA',c:'b'}],tier:2,url:''},
            // FEV
            {day:10,month:2,name:'Consensus Hong Kong',loc:'Hong Kong',desc:'CoinDesk — maior conferência de crypto da Ásia',tags:[{l:'Crypto',c:'b'},{l:'Ásia',c:'b'},{l:'Altcoins',c:'r'}],tier:2,url:''},
            // MAR
            {day:5,month:3,name:'BTC Policy Fly-In',loc:'Washington D.C., EUA',desc:'Advocacia Bitcoin no Congresso americano',tags:[{l:'Política',c:'b'},{l:'EUA',c:'b'}],tier:2,url:''},
            // ABR
            {day:14,month:4,name:'Bitconf Brasil',loc:'São Paulo, Brasil 🇧🇷',desc:'Maior evento Bitcoin do Brasil — palestrantes nacionais e internacionais',tags:[{l:'Brasil',c:'o'},{l:'LATAM',c:'o'},{l:'Bitcoin',c:'g'}],tier:3,url:'https://bitconf.com.br'},
            // MAI
            {day:5,month:5,name:'Bitcoin 2026',loc:'Nashville, Tennessee, EUA',desc:'O maior evento Bitcoin do mundo — dezenas de milhares de presentes, Michael Saylor, etc.',tags:[{l:'Must Go',c:'g'},{l:'EUA',c:'b'},{l:'Global',c:'g'}],tier:1,url:'https://b.tc/conference'},
            {day:19,month:5,name:'Consensus Austin',loc:'Austin, Texas, EUA',desc:'CoinDesk Consensus — foco em Crypto & AI',tags:[{l:'Crypto',c:'b'},{l:'EUA',c:'b'}],tier:2,url:''},
            // JUN
            {day:5,month:6,name:'BTC Prague',loc:'Praga, República Tcheca 🇨🇿',desc:'Maior conferência Bitcoin da Europa — 100% Bitcoin only, sem altcoins',tags:[{l:'Must Go',c:'g'},{l:'Europa',c:'b'},{l:'Bitcoin Only',c:'g'}],tier:1,url:'https://btcprague.com'},
            {day:18,month:6,name:'Bitcoin Summit Africa',loc:'Nairobi, Quênia',desc:'Adoção Bitcoin na África — Lightning, remessas, inclusão financeira',tags:[{l:'África',c:'p'},{l:'Lightning',c:'g'},{l:'Bitcoin',c:'g'}],tier:2,url:''},
            // JUL
            {day:8,month:7,name:'Mining Disrupt',loc:'Miami, Florida, EUA',desc:'Conferência de mineração Bitcoin — ASIC, energia, hashrate',tags:[{l:'Mining',c:'p'},{l:'EUA',c:'b'},{l:'Tech',c:'b'}],tier:4,url:''},
            // AGO
            {day:12,month:8,name:'Bitcoin Alive',loc:'Sydney, Austrália',desc:'Principal evento Bitcoin da Oceania — autocustódia e Lightning',tags:[{l:'Austrália',c:'b'},{l:'Bitcoin',c:'g'}],tier:2,url:''},
            {day:22,month:8,name:'Satoshi Spritz',loc:'Berlim, Alemanha',desc:'Comunidade Bitcoin europeia — meetup premium com palestrantes globais',tags:[{l:'Europa',c:'b'},{l:'Bitcoin Only',c:'g'}],tier:2,url:''},
            // SET
            {day:5,month:9,name:'Baltic Honeybadger',loc:'Riga, Letônia 🇱🇻',desc:'Conferência Bitcoin mais antiga da Europa — puristas Bitcoin only, sem hype',tags:[{l:'Must Go',c:'g'},{l:'Europa',c:'b'},{l:'Bitcoin Only',c:'g'},{l:'OG',c:'o'}],tier:1,url:'https://baltichoneybadger.com'},
            {day:18,month:9,name:'TABConf',loc:'Atlanta, Georgia, EUA',desc:'Conferência técnica Bitcoin — devs, Lightning, protocolos',tags:[{l:'Técnico',c:'p'},{l:'Devs',c:'b'},{l:'Lightning',c:'g'}],tier:2,url:'https://tabconf.com'},
            // OUT
            {day:7,month:10,name:'Bitcoin Amsterdam',loc:'Amsterdam, Holanda 🇳🇱',desc:'Top conferência Bitcoin da Europa Ocidental — 100% Bitcoin only',tags:[{l:'Europa',c:'b'},{l:'Bitcoin Only',c:'g'}],tier:1,url:'https://bitcoin.nl'},
            {day:21,month:10,name:'Plan B Forum Lugano',loc:'Lugano, Suíça 🇨🇭',desc:'Cidade suíça que adotou Bitcoin como moeda — evento anual de adoção municipal',tags:[{l:'Europa',c:'b'},{l:'Adoção',c:'g'},{l:'Suíça',c:'b'}],tier:2,url:'https://planb.lugano.ch'},
            {day:28,month:10,name:'Labitconf',loc:'Montevidéu, Uruguai',desc:'Maior conferência Bitcoin/Crypto da LATAM — foco em Argentina, Brasil, Uruguai',tags:[{l:'LATAM',c:'o'},{l:'Brasil',c:'o'},{l:'Argentina',c:'o'}],tier:3,url:'https://labitconf.com'},
            // NOV
            {day:10,month:11,name:'Adopting Bitcoin',loc:'El Salvador 🇸🇻',desc:'Na terra onde BTC é moeda legal — Lightning e adoção nacional',tags:[{l:'Must Go',c:'g'},{l:'El Salvador',c:'o'},{l:'Lightning',c:'g'}],tier:1,url:'https://adoptingbitcoin.org'},
            {day:24,month:11,name:'Bitcoin Atlantis',loc:'Açores / Lisboa, Portugal 🇵🇹',desc:'Evento Bitcoin na Europa lusófona — ótimo para brasileiros',tags:[{l:'Europa',c:'b'},{l:'Portugal',c:'o'},{l:'LATAM friendly',c:'o'}],tier:2,url:''},
            // DEZ
            {day:3,month:12,name:'Bitconf de Encerramento',loc:'São Paulo, Brasil 🇧🇷',desc:'Edição de encerramento do ano Bitconf — review do mercado e previsões',tags:[{l:'Brasil',c:'o'},{l:'LATAM',c:'o'}],tier:3,url:''},
            {day:12,month:12,name:'Year in Bitcoin — Livestream',loc:'Online / Global',desc:'Retrospectiva anual da comunidade Bitcoin global',tags:[{l:'Online',c:'b'},{l:'Global',c:'g'}],tier:3,url:''},
          ];

          var MONTHS = ['JAN','FEV','MAR','ABR','MAI','JUN','JUL','AGO','SET','OUT','NOV','DEZ'];
          var currentMonth = null;

          function render(events){
            var el = document.getElementById('cal-events-list');
            if(!events.length){el.innerHTML='<div class="cal-empty">— Nenhum evento neste mês —</div>';return;}
            el.innerHTML = events.map(function(e){
              var tags = e.tags.map(function(t){return '<span class="cal-ev-tag '+t.c+'">'+t.l+'</span>';}).join('');
              var tierCls = 'tier'+e.tier;
              var wrap = e.url ? 'a href="'+e.url+'" target="_blank"' : 'div';
              var wrapEnd = e.url ? 'a' : 'div';
              return '<'+wrap+' class="cal-event '+tierCls+'">'+
                '<div>'+
                  '<div class="cal-ev-date">'+e.day+'</div>'+
                  '<div class="cal-ev-month-mini">'+MONTHS[e.month-1]+'</div>'+
                '</div>'+
                '<div class="cal-ev-body">'+
                  '<div class="cal-ev-name">'+e.name+'</div>'+
                  '<div class="cal-ev-loc"><b>📍</b> '+e.loc+' · '+e.desc+'</div>'+
                  '<div class="cal-ev-tags">'+tags+'</div>'+
                '</div>'+
              '</'+wrapEnd+'>';
            }).join('');
          }

          function calMonth(m){
            currentMonth = m;
            document.querySelectorAll('.cal-month-btn').forEach(function(b){b.classList.remove('active');});
            document.getElementById('cal-all-btn').classList.remove('active');
            document.querySelectorAll('.cal-month-btn[data-m="'+m+'"]').forEach(function(b){b.classList.add('active');});
            render(EVENTS.filter(function(e){return e.month===m;}));
          }
          function calShowAll(){
            currentMonth = null;
            document.querySelectorAll('.cal-month-btn').forEach(function(b){b.classList.remove('active');});
            document.getElementById('cal-all-btn').classList.add('active');
            render(EVENTS);
          }
          window.calMonth = calMonth;
          window.calShowAll = calShowAll;

          // build month buttons
          var row = document.getElementById('cal-months-row');
          var eventMonths = EVENTS.map(function(e){return e.month;});
          MONTHS.forEach(function(m,i){
            var btn = document.createElement('button');
            btn.className = 'cal-month-btn' + (eventMonths.indexOf(i+1)>-1?' has-event':'');
            btn.dataset.m = i+1;
            btn.textContent = m;
            btn.onclick = function(){calMonth(i+1);};
            row.appendChild(btn);
          });

          // default: show current month or next event
          var now = new Date();
          var curM = now.getMonth()+1;
          var firstM = EVENTS.filter(function(e){return e.month>=curM;})[0];
          setTimeout(function(){calMonth(firstM?firstM.month:1);},200);
        })();
        </script>
      </div>

      <!-- DONOS DO BITCOIN -->
      <div class="panel" id="donos-bitcoin" style="background:linear-gradient(180deg,#050810 0%,#060a0d 100%);border-color:rgba(242,169,0,0.25);">
        <div class="pt" style="color:#f2a900;letter-spacing:3px;">₿ QUEM SÃO OS DONOS DO BITCOIN? — 2026</div>

        <style>
        /* ── DONOS BTC ── */
        .dbtc-tabs{display:flex;gap:5px;margin:10px 0 14px;flex-wrap:wrap;}
        .dbtc-tab{font-family:ui-monospace,Menlo,monospace;font-size:8px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;padding:5px 12px;border-radius:5px;cursor:pointer;border:1px solid rgba(242,169,0,0.25);color:#6b7280;background:#070c10;transition:all .18s;}
        .dbtc-tab.active,.dbtc-tab:hover{color:#f2a900;border-color:rgba(242,169,0,0.6);background:rgba(242,169,0,0.08);}
        .dbtc-view{display:none;}.dbtc-view.active{display:block;}

        /* barras */
        .dbtc-bar-row{display:flex;align-items:center;gap:8px;margin-bottom:9px;}
        .dbtc-bar-label{width:130px;flex-shrink:0;font-size:9px;color:#9ca3af;text-align:right;font-family:ui-monospace,Menlo,monospace;line-height:1.2;}
        .dbtc-bar-label small{display:block;font-size:7px;color:#4b5563;}
        .dbtc-bar-track{flex:1;height:18px;background:rgba(255,255,255,0.04);border-radius:4px;overflow:hidden;position:relative;}
        .dbtc-bar-fill{height:100%;border-radius:4px;width:0;transition:width 1.2s cubic-bezier(.16,1,.3,1);display:flex;align-items:center;justify-content:flex-end;padding-right:6px;}
        .dbtc-bar-fill span{font-size:8px;font-weight:900;font-family:ui-monospace,Menlo,monospace;white-space:nowrap;}
        .dbtc-bar-btc{width:80px;flex-shrink:0;font-size:8px;font-family:ui-monospace,Menlo,monospace;color:#f2a900;text-align:right;}

        /* timeline */
        .dbtc-timeline{position:relative;padding-left:18px;}
        .dbtc-timeline::before{content:'';position:absolute;left:5px;top:0;bottom:0;width:2px;background:linear-gradient(180deg,rgba(242,169,0,0.6),rgba(242,169,0,0.05));}
        .dbtc-titem{position:relative;margin-bottom:14px;}
        .dbtc-titem::before{content:'';position:absolute;left:-15px;top:4px;width:8px;height:8px;border-radius:50%;border:2px solid #f2a900;background:#050810;}
        .dbtc-tyear{font-family:ui-monospace,Menlo,monospace;font-size:10px;font-weight:900;color:#f2a900;margin-bottom:3px;}
        .dbtc-tdesc{font-size:10px;color:#6b7280;line-height:1.5;}
        .dbtc-tdesc b{color:#d1d5db;}
        .dbtc-ttags{display:flex;gap:4px;flex-wrap:wrap;margin-top:5px;}
        .dbtc-ttag{font-size:7px;font-family:ui-monospace,Menlo,monospace;font-weight:700;letter-spacing:.8px;padding:2px 7px;border-radius:10px;text-transform:uppercase;}
        .dbtc-ttag.g{background:rgba(0,255,136,0.1);color:#00ff88;border:1px solid rgba(0,255,136,0.25);}
        .dbtc-ttag.o{background:rgba(242,169,0,0.1);color:#f2a900;border:1px solid rgba(242,169,0,0.25);}
        .dbtc-ttag.b{background:rgba(0,220,255,0.1);color:#00dcff;border:1px solid rgba(0,220,255,0.25);}
        .dbtc-ttag.r{background:rgba(239,68,68,0.1);color:#f87171;border:1px solid rgba(239,68,68,0.25);}
        .dbtc-ttag.p{background:rgba(168,85,247,0.1);color:#c084fc;border:1px solid rgba(168,85,247,0.25);}

        /* legenda mini */
        .dbtc-legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;}
        .dbtc-leg{display:flex;align-items:center;gap:4px;font-size:8px;color:#6b7280;font-family:ui-monospace,Menlo,monospace;}
        .dbtc-leg-dot{width:8px;height:8px;border-radius:2px;flex-shrink:0;}
        </style>

        <!-- tabs -->
        <div class="dbtc-tabs">
          <div class="dbtc-tab active" onclick="dbtcTab('holders')">🏆 Maiores Holders</div>
          <div class="dbtc-tab" onclick="dbtcTab('categorias')">🗂️ Por Categoria</div>
          <div class="dbtc-tab" onclick="dbtcTab('timeline')">📅 Evolução 2009→2026</div>
        </div>

        <!-- VIEW 1: Maiores Holders individuais -->
        <div class="dbtc-view active" id="dbtc-holders">
          <div class="dbtc-legend">
            <div class="dbtc-leg"><div class="dbtc-leg-dot" style="background:#f2a900;"></div>Satoshi / Cypherpunks</div>
            <div class="dbtc-leg"><div class="dbtc-leg-dot" style="background:#00dcff;"></div>ETFs & Institucional</div>
            <div class="dbtc-leg"><div class="dbtc-leg-dot" style="background:#00ff88;"></div>Empresas públicas</div>
            <div class="dbtc-leg"><div class="dbtc-leg-dot" style="background:#a855f7;"></div>Governos</div>
            <div class="dbtc-leg"><div class="dbtc-leg-dot" style="background:#f87171;"></div>Exchanges</div>
          </div>
          <div id="dbtc-bars-holders">
            <!-- JS renderiza -->
          </div>
          <div style="font-size:8px;color:#374151;margin-top:10px;font-family:ui-monospace,Menlo,monospace;">* Estimativas 2026. Satoshi ~1M BTC nunca movidos. Total supply: 21M BTC.</div>
        </div>

        <!-- VIEW 2: Por Categoria -->
        <div class="dbtc-view" id="dbtc-categorias">
          <div id="dbtc-bars-cat"></div>
          <div style="font-size:8px;color:#374151;margin-top:10px;font-family:ui-monospace,Menlo,monospace;">* ~3-4M BTC considerados perdidos para sempre (wallets sem chave).</div>
        </div>

        <!-- VIEW 3: Timeline -->
        <div class="dbtc-view" id="dbtc-timeline">
          <div class="dbtc-timeline">

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🟡 2009 — Gênese</div>
              <div class="dbtc-tdesc"><b>Satoshi Nakamoto</b> minera o bloco genesis em 3 jan. Era apenas ele e poucos cypherpunks. Hal Finney recebe a 1ª transação. O Bitcoin não valia nada.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag o">Satoshi</span><span class="dbtc-ttag g">Hal Finney</span><span class="dbtc-ttag b">Cypherpunks</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🍕 2010 — Pizza e Primeiros Preços</div>
              <div class="dbtc-tdesc"><b>Laszlo Hanyecz</b> paga 10.000 BTC por duas pizzas (hoje ~$1 bilhão). Primeiras exchanges surgem. Preço: $0,003. Donos: mineradores e entusiastas.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag o">Mineradores</span><span class="dbtc-ttag b">Laszlo</span><span class="dbtc-ttag g">Mt.Gox</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🌑 2013 — Silk Road & $1.000</div>
              <div class="dbtc-tdesc">Bitcoin atinge <b>$1.000</b> pela 1ª vez. Silk Road derrubado pelo FBI (confisca ~170k BTC). Winklevoss twins compram 1% de todo o supply. China proíbe pela 1ª vez.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag b">Winklevoss</span><span class="dbtc-ttag r">FBI/Governos</span><span class="dbtc-ttag p">Especuladores</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🚀 2017 — Retail Mania & $20k</div>
              <div class="dbtc-tdesc">Explosão de ICOs. Bitcoin atinge <b>$20.000</b>. Milhões de varejo entram via Coinbase. Futures CME lançados — Wall Street chega. Hard fork BCash divide comunidade.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag p">Retail</span><span class="dbtc-ttag b">CME Futures</span><span class="dbtc-ttag r">Mt.Gox legado</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🏦 2020-21 — Institucional entra</div>
              <div class="dbtc-tdesc"><b>MicroStrategy</b> começa a comprar (hoje +580k BTC). Tesla compra $1,5B. El Salvador adota BTC como moeda legal. NFTs e DeFi trazem novo público. BTC: $69.000.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag g">MicroStrategy</span><span class="dbtc-ttag o">El Salvador</span><span class="dbtc-ttag b">Tesla</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🏛️ 2024 — ETFs aprovados nos EUA</div>
              <div class="dbtc-tdesc">SEC aprova ETFs Bitcoin spot em jan/2024. <b>BlackRock IBIT</b> vira o maior ETF da história em velocidade de captação. Bilhões fluem. BTC: $100.000.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag b">BlackRock</span><span class="dbtc-ttag b">Fidelity</span><span class="dbtc-ttag g">ETF Spot</span></div>
            </div>

            <div class="dbtc-titem">
              <div class="dbtc-tyear">🇺🇸 2025-26 — EUA compra Bitcoin</div>
              <div class="dbtc-tdesc"><b>Trump</b> cria Reserva Estratégica Nacional de Bitcoin. EUA se torna o maior holder soberano declarado (~200k BTC). Países competem por reservas. BTC: $100-150k.</div>
              <div class="dbtc-ttags"><span class="dbtc-ttag r">EUA Gov</span><span class="dbtc-ttag p">Reservas soberanas</span><span class="dbtc-ttag g">Autocustódia global</span></div>
            </div>

          </div>
        </div>

        <script>
        (function(){
          var HOLDERS = [
            {label:'Satoshi Nakamoto',sub:'~1M BTC — nunca movidos',btc:1000000,pct:4.76,color:'#f2a900'},
            {label:'BlackRock IBIT',sub:'ETF Bitcoin EUA',btc:620000,pct:2.95,color:'#00dcff'},
            {label:'MicroStrategy',sub:'Michael Saylor',btc:580000,pct:2.76,color:'#00ff88'},
            {label:'Fidelity FBTC',sub:'ETF Bitcoin EUA',btc:200000,pct:0.95,color:'#00dcff'},
            {label:'Grayscale GBTC',sub:'Trust histórico',btc:195000,pct:0.93,color:'#00dcff'},
            {label:'EUA — Governo',sub:'Reserva Estratégica Nacional',btc:200000,pct:0.95,color:'#a855f7'},
            {label:'Binance',sub:'Exchange — reservas custodiais',btc:580000,pct:2.76,color:'#f87171'},
            {label:'Coinbase',sub:'Exchange + custódia ETFs',btc:900000,pct:4.28,color:'#f87171'},
            {label:'Winklevoss / Gemini',sub:'Desde 2013',btc:100000,pct:0.48,color:'#00ff88'},
            {label:'El Salvador',sub:'Reserva soberana + bond',btc:6000,pct:0.03,color:'#a855f7'},
          ];
          var CATS = [
            {label:'ETFs & Fundos',sub:'BlackRock, Fidelity, Grayscale…',btc:1200000,pct:5.7,color:'#00dcff'},
            {label:'Exchanges (custódia)',sub:'Binance, Coinbase, Kraken…',btc:1800000,pct:8.6,color:'#f87171'},
            {label:'Satoshi / Primeiros',sub:'Wallets 2009-2011 inativas',btc:1100000,pct:5.2,color:'#f2a900'},
            {label:'Empresas Públicas',sub:'MicroStrategy, Tesla, Marathon…',btc:700000,pct:3.3,color:'#00ff88'},
            {label:'Governos',sub:'EUA, Alemanha, China (apreensões)…',btc:450000,pct:2.1,color:'#a855f7'},
            {label:'Retail — Autocustódia',sub:'Milhões de wallets individuais',btc:5000000,pct:23.8,color:'#00ff88'},
            {label:'BTC Perdidos / Inacessíveis',sub:'Wallets sem chave, hard drives',btc:3500000,pct:16.7,color:'#374151'},
            {label:'Em circulação / outros',sub:'Exchanges menores, DeFi, etc.',btc:5800000,pct:27.6,color:'#6b7280'},
          ];

          function fmt(n){return n>=1000000?(n/1000000).toFixed(2)+'M':(n>=1000?(n/1000).toFixed(0)+'k':n);}

          function renderBars(data, containerId){
            var max = Math.max.apply(null, data.map(function(d){return d.btc;}));
            var el = document.getElementById(containerId);
            if(!el) return;
            el.innerHTML = data.map(function(d){
              var w = Math.round(d.btc/max*100);
              return '<div class="dbtc-bar-row">'+
                '<div class="dbtc-bar-label">'+d.label+'<small>'+d.sub+'</small></div>'+
                '<div class="dbtc-bar-track">'+
                  '<div class="dbtc-bar-fill" style="background:'+d.color+';opacity:0.85;width:0" data-w="'+w+'%">'+
                    '<span style="color:'+(d.color==='#f2a900'||d.color==='#00ff88'?'#000':'#fff')+'">'+d.pct+'%</span>'+
                  '</div>'+
                '</div>'+
                '<div class="dbtc-bar-btc">'+fmt(d.btc)+'</div>'+
              '</div>';
            }).join('');
            // animate
            setTimeout(function(){
              el.querySelectorAll('.dbtc-bar-fill').forEach(function(b){b.style.width=b.dataset.w;});
            },80);
          }

          function dbtcTab(name){
            document.querySelectorAll('.dbtc-tab').forEach(function(t){t.classList.remove('active');});
            document.querySelectorAll('.dbtc-view').forEach(function(v){v.classList.remove('active');});
            event.target.classList.add('active');
            document.getElementById('dbtc-'+name).classList.add('active');
            if(name==='holders') renderBars(HOLDERS,'dbtc-bars-holders');
            if(name==='categorias') renderBars(CATS,'dbtc-bars-cat');
          }
          window.dbtcTab = dbtcTab;

          // init first tab
          setTimeout(function(){renderBars(HOLDERS,'dbtc-bars-holders');},300);
        })();
        </script>
      </div>

