.rb-parc__logo{height:86px;display:flex;align-items:center;justify-content:center;background:#f4f6fa;padding:12px}
.rb-parc__logo img{max-height:56px;max-width:80%;object-fit:contain}
.rb-parc__name{padding:9px 6px;font-size:11px;font-weight:800;color:#eef4ff;letter-spacing:.5px}
.rb-parc__tag{display:block;font-size:8.5px;font-weight:600;color:#f2a900;letter-spacing:1.5px;text-transform:uppercase;margin-top:2px}
.rb-parc__logo--dark{background:#131a26!important}
.rb-parc__card--cta .rb-parc__logo{background:linear-gradient(140deg,rgba(242,169,0,.12),rgba(0,212,255,.08));color:#f2a900;font-size:30px}
</style>
