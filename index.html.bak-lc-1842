  .rb-bipa__title b{color:#a78bfa}
  .rb-bipa__sub{font-size:clamp(13px,3vw,15px);color:#c9c2e0;margin:6px auto 14px;max-width:620px;line-height:1.5}
  .rb-bipa__offer{display:inline-block;background:rgba(139,92,246,0.10);border:1px dashed rgba(139,92,246,0.45);border-radius:10px;padding:10px 16px;margin-bottom:18px}
  .rb-bipa__offer b{color:#a78bfa;font-size:clamp(15px,4vw,19px)}
  .rb-bipa__code{font-family:ui-monospace,Menlo,monospace;font-weight:900;letter-spacing:3px;color:#fff;background:rgba(255,255,255,0.06);border:1px solid rgba(139,92,246,0.4);border-radius:8px;padding:4px 12px;display:inline-block;margin:0 4px}
  .rb-bipa__cta{display:inline-block;background:linear-gradient(90deg,#7c3aed,#a78bfa);color:#fff;font-weight:900;font-size:clamp(14px,3.6vw,17px);letter-spacing:1px;text-decoration:none;padding:13px 30px;border-radius:10px;box-shadow:0 6px 20px -6px rgba(139,92,246,0.6);transition:transform .15s}
