<!-- ===== RADAR & CLIMA DO BRASIL AO VIVO (mapa interativo) ===== -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css"/>
<style>
.clm-wrap{max-width:1100px;margin:18px auto;padding:16px 16px 12px;background:linear-gradient(160deg,#eafaf0,#d8f3e2);border:1px solid rgba(22,199,132,.45);border-radius:16px;box-shadow:0 0 40px -14px rgba(22,199,132,.45)}
.clm-head{display:flex;align-items:center;justify-content:center;gap:12px;flex-wrap:wrap;margin-bottom:4px}
.clm-title{font-weight:900;font-size:clamp(16px,4vw,22px);color:#0f3d24;letter-spacing:.3px}
.clm-live{display:inline-flex;align-items:center;gap:6px;font-size:10px;font-weight:800;letter-spacing:1.5px;color:#0a8f4d}
.clm-live i{width:8px;height:8px;border-radius:50%;background:#ea3943;animation:clmPulse 1.2s infinite}
.clm-sub{text-align:center;color:#3d6b52;font-size:11px;margin-bottom:10px}
.clm-tabs{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-bottom:10px}
.clm-tab{font-size:12px;font-weight:700;color:#2f6b4c;background:rgba(255,255,255,.6);border:1px solid #b6e3c8;border-radius:20px;padding:6px 14px;cursor:pointer;transition:.15s;display:inline-flex;align-items:center;gap:6px}
.clm-tab.on{background:rgba(22,199,132,.22);border-color:#16c784;color:#0f5c37}
.clm-mapbox{position:relative;border-radius:12px;overflow:hidden;border:1px solid #a9dcbf}
#clmMap{width:100%;height:clamp(360px,60vw,520px);background:#e8f7ee;z-index:1}
.clm-bar{position:absolute;left:10px;right:10px;bottom:10px;z-index:500;display:flex;align-items:center;gap:10px;background:rgba(255,255,255,.86);backdrop-filter:blur(8px);border:1px solid #b6e3c8;border-radius:12px;padding:8px 12px}
.clm-play{flex:0 0 auto;width:34px;height:34px;border-radius:50%;border:0;background:linear-gradient(90deg,#16c784,#48d69b);color:#fff;font-size:15px;cursor:pointer}
.clm-slider{flex:1;accent-color:#16c784;cursor:pointer}
.clm-time{flex:0 0 auto;min-width:78px;text-align:right;font-family:ui-monospace,Menlo,monospace;font-size:12px;font-weight:800;color:#0f5c37}
.clm-time.now{color:#0a8f4d}
.clm-legend{position:absolute;right:10px;top:10px;z-index:500;background:rgba(255,255,255,.86);border:1px solid #b6e3c8;border-radius:10px;padding:7px 10px;font-size:10px;color:#2f6b4c;display:flex;flex-direction:column;gap:3px}
.clm-legend .row{display:flex;align-items:center;gap:5px}
.clm-legend b{width:11px;height:8px;border-radius:2px;display:inline-block}
.clm-fs{position:absolute;left:10px;top:10px;z-index:500;width:32px;height:32px;border-radius:8px;border:1px solid #b6e3c8;background:rgba(255,255,255,.86);color:#0f5c37;cursor:pointer;font-size:14px}
.clm-src{text-align:center;color:#6f9a82;font-size:10px;margin-top:9px}
.leaflet-container{background:#e8f7ee}
.clm-pin{background:#16c784;border:2px solid #fff;border-radius:50%;color:#fff;font-weight:800;font-size:11px;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 4px rgba(0,0,0,.35);font-family:ui-monospace,Menlo,monospace}
@keyframes clmPulse{0%,100%{opacity:1}50%{opacity:.25}}
.clm-wrap:fullscreen{display:flex;flex-direction:column;justify-content:center;padding:20px}
.clm-wrap:fullscreen #clmMap{height:82vh}
</style>
<section class="clm-wrap" id="clmWrap">
  <div class="clm-head"><span class="clm-title">🌧️ Radar &amp; Clima do Brasil — ao vivo</span><span class="clm-live"><i></i> AO VIVO</span></div>
  <div class="clm-sub">Radar de chuva animado das últimas 2 horas · toque nas capitais pra ver a temperatura</div>
  <div class="clm-tabs">
    <button class="clm-tab on" id="clmTabRain">🌧️ Chuva (radar)</button>
    <button class="clm-tab on" id="clmTabTemp">🌡️ Temperatura</button>
  </div>
  <div class="clm-mapbox">
    <div id="clmMap"></div>
    <button class="clm-fs" id="clmFs" title="Tela cheia">⛶</button>
    <div class="clm-legend">
      <div class="row"><b style="background:#00e676"></b>Fraca</div>
      <div class="row"><b style="background:#ffee58"></b>Moderada</div>
      <div class="row"><b style="background:#ff9800"></b>Forte</div>
      <div class="row"><b style="background:#e53935"></b>Intensa</div>
    </div>
    <div class="clm-bar">
      <button class="clm-play" id="clmPlay">⏸</button>
      <input type="range" class="clm-slider" id="clmSlider" min="0" max="12" value="12"/>
      <span class="clm-time now" id="clmTime">AGORA</span>
    </div>
  </div>
  <div class="clm-src">Radar: RainViewer · Mapa: OpenStreetMap/CARTO · Temperatura: Open-Meteo · atualiza sozinho</div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function(){
  var CAPS=[{"n":"Rio Branco","s":"AC","lat":-9.97,"lon":-67.81},{"n":"Maceió","s":"AL","lat":-9.65,"lon":-35.73},{"n":"Macapá","s":"AP","lat":0.03,"lon":-51.07},{"n":"Manaus","s":"AM","lat":-3.1,"lon":-60.02},{"n":"Salvador","s":"BA","lat":-12.97,"lon":-38.5},{"n":"Fortaleza","s":"CE","lat":-3.72,"lon":-38.54},{"n":"Brasília","s":"DF","lat":-15.78,"lon":-47.93},{"n":"Vitória","s":"ES","lat":-20.32,"lon":-40.34},{"n":"Goiânia","s":"GO","lat":-16.68,"lon":-49.25},{"n":"São Luís","s":"MA","lat":-2.53,"lon":-44.3},{"n":"Cuiabá","s":"MT","lat":-15.6,"lon":-56.1},{"n":"Campo Grande","s":"MS","lat":-20.44,"lon":-54.65},{"n":"Belo Horizonte","s":"MG","lat":-19.92,"lon":-43.94},{"n":"Belém","s":"PA","lat":-1.46,"lon":-48.5},{"n":"João Pessoa","s":"PB","lat":-7.12,"lon":-34.88},{"n":"Curitiba","s":"PR","lat":-25.43,"lon":-49.27},{"n":"Recife","s":"PE","lat":-8.05,"lon":-34.88},{"n":"Teresina","s":"PI","lat":-5.09,"lon":-42.8},{"n":"Rio de Janeiro","s":"RJ","lat":-22.91,"lon":-43.17},{"n":"Natal","s":"RN","lat":-5.79,"lon":-35.21},{"n":"Porto Alegre","s":"RS","lat":-30.03,"lon":-51.23},{"n":"Porto Velho","s":"RO","lat":-8.76,"lon":-63.9},{"n":"Boa Vista","s":"RR","lat":2.82,"lon":-60.67},{"n":"Florianópolis","s":"SC","lat":-27.59,"lon":-48.55},{"n":"São Paulo","s":"SP","lat":-23.55,"lon":-46.63},{"n":"Aracaju","s":"SE","lat":-10.91,"lon":-37.07},{"n":"Palmas","s":"TO","lat":-10.18,"lon":-48.33}];
  var tries=0;
  function init(){
    if(typeof L==='undefined'){ if(tries++<40){setTimeout(init,300);} return; }
    var map=L.map('clmMap',{zoomControl:true,attributionControl:false,minZoom:3,maxZoom:11}).setView([-15.5,-52],4);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png',{maxZoom:11,subdomains:'abcd'}).addTo(map);
    // ---- Radar RainViewer ----
    var host='', frames=[], layers={}, idx=0, lastPast=0, timer=null, rainOn=true, COLOR=4;
    var slider=document.getElementById('clmSlider'), lbl=document.getElementById('clmTime'), btnPlay=document.getElementById('clmPlay');
    function url(fr){ return host+fr.path+'/256/{z}/{x}/{y}/'+COLOR+'/1_1.png'; }
    function show(i){
      if(!frames.length)return;
      idx=(i%frames.length+frames.length)%frames.length;
      frames.forEach(function(fr,j){
        var ly=layers[fr.path];
        if(!ly){ ly=L.tileLayer(url(fr),{opacity:0,zIndex:5}); layers[fr.path]=ly; if(rainOn)ly.addTo(map); }
        ly.setOpacity(j===idx && rainOn ?0.72:0);
      });
      var d=new Date(frames[idx].time*1000);
      var now=idx>=lastPast;
      lbl.textContent=(now?'AGORA':(('0'+d.getHours()).slice(-2)+':'+('0'+d.getMinutes()).slice(-2)));
      lbl.classList.toggle('now',now);
      slider.value=idx;
    }
    function play(){ btnPlay.textContent='⏸'; clearInterval(timer); timer=setInterval(function(){ show(idx+1); },650); }
    function pause(){ btnPlay.textContent='▶'; clearInterval(timer); timer=null; }
    btnPlay.addEventListener('click',function(){ if(timer)pause(); else play(); });
    slider.addEventListener('input',function(){ pause(); show(parseInt(slider.value,10)); });
    function loadRadar(){
      fetch('https://api.rainviewer.com/public/weather-maps.json').then(function(r){return r.json();}).then(function(d){
        host=d.host; var past=(d.radar&&d.radar.past)||[], nc=(d.radar&&d.radar.nowcast)||[];
        frames=past.concat(nc); lastPast=past.length-1;
        slider.max=Math.max(0,frames.length-1);
        idx=lastPast; show(idx); play();
      }).catch(function(){ lbl.textContent='radar off'; });
    }
    document.getElementById('clmTabRain').addEventListener('click',function(){
      rainOn=!rainOn; this.classList.toggle('on',rainOn);
      if(!rainOn){ pause(); Object.keys(layers).forEach(function(k){layers[k].setOpacity(0);}); }
      else { for(var k in layers){} show(idx); play(); }
    });
    // ---- Temperatura capitais (Open-Meteo) ----
    var tempLayer=L.layerGroup().addTo(map), tempOn=true;
    function tColor(t){ if(t==null)return '#556'; if(t<10)return '#2b6cb0'; if(t<16)return '#3182ce'; if(t<20)return '#38a169'; if(t<24)return '#68d391'; if(t<28)return '#f6e05e'; if(t<32)return '#ed8936'; if(t<36)return '#e53e3e'; return '#c53030'; }
    function loadTemps(){
      var la=CAPS.map(function(c){return c.lat;}).join(','), lo=CAPS.map(function(c){return c.lon;}).join(',');
      fetch('https://api.open-meteo.com/v1/forecast?latitude='+la+'&longitude='+lo+'&current=temperature_2m,weather_code,wind_speed_10m,precipitation&timezone=America%2FSao_Paulo').then(function(r){return r.json();}).then(function(j){
        var arr=Array.isArray(j)?j:[j]; tempLayer.clearLayers();
        CAPS.forEach(function(c,i){
          var cur=arr[i]&&arr[i].current; if(!cur)return;
          var t=Math.round(cur.temperature_2m);
          var ic=L.divIcon({className:'',html:'<div class="clm-pin" style="width:30px;height:30px;background:'+tColor(t)+'">'+t+'°</div>',iconSize:[30,30],iconAnchor:[15,15]});
          var m=L.marker([c.lat,c.lon],{icon:ic}).addTo(tempLayer);
          m.bindPopup('<b>'+c.n+' ('+c.s+')</b><br>'+t+'°C · 💨 '+Math.round(cur.wind_speed_10m)+' km/h · 🌧️ '+(cur.precipitation||0)+' mm');
        });
      }).catch(function(){});
    }
    document.getElementById('clmTabTemp').addEventListener('click',function(){
      tempOn=!tempOn; this.classList.toggle('on',tempOn);
      if(tempOn){ tempLayer.addTo(map); } else { map.removeLayer(tempLayer); }
    });
    // ---- Fullscreen ----
    document.getElementById('clmFs').addEventListener('click',function(){
      var w=document.getElementById('clmWrap');
      if(!document.fullscreenElement){ (w.requestFullscreen||w.webkitRequestFullscreen||function(){}).call(w); }
      else { document.exitFullscreen&&document.exitFullscreen(); }
      setTimeout(function(){ map.invalidateSize(); },300);
    });
    setTimeout(function(){ map.invalidateSize(); },200);
    // move o mapa mais pra baixo na página (abaixo do player / barra de notícias)
    try{
      var _wrap=document.getElementById('clmWrap');
      var _anchor=document.getElementById('newsBar')||document.getElementById('playlist');
      var _host=_anchor&&(_anchor.closest('section')||_anchor.parentElement);
      if(_wrap&&_host&&_host.parentNode&&_host!==_wrap){
        _host.parentNode.insertBefore(_wrap,_host.nextSibling);
        setTimeout(function(){ map.invalidateSize(); },350);
      }
    }catch(e){}
    loadRadar(); loadTemps();
    setInterval(loadRadar, 10*60*1000); setInterval(loadTemps, 15*60*1000);
  }
  if(document.readyState!=='loading') init(); else document.addEventListener('DOMContentLoaded',init);
})();
</script>

  <!-- ===== SORTEIO 50K SATS (gamificação dos locutores) ===== -->
  <a href="https://t.me/Bitadictbot" target="_blank" rel="noopener" style="display:block;text-decoration:none;margin:2px auto 14px;max-width:660px;background:linear-gradient(135deg,#1a1206,#2a1e08);border:1.5px solid rgba(242,169,0,.6);border-radius:12px;padding:12px 16px;box-shadow:0 0 24px -8px rgba(242,169,0,.55);animation:cupomGlow 2.6s ease-in-out infinite;">
    <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;text-align:center;">
      <span style="font-size:28px;">🎁</span>
      <div>
        <div style="font-family:'Orbitron',ui-monospace,monospace;font-size:13px;font-weight:900;color:#f2a900;letter-spacing:.5px;">VOTE E CONCORRA A <span style="color:#fff;">50.000 SATS</span> ⚡</div>
        <div style="font-size:10.5px;color:#c9c2e0;margin-top:3px;line-height:1.4;">Sorteamos um <b style="color:#f2a900;">cartão físico Bitcoin de 50k sats</b> entre quem votar. Toque aqui pra participar pelo Telegram 👉</div>
      </div>
    </div>
  </a>
  <div class="vlc__grid" id="vlcGrid"></div>
  <div class="vlc__foot" id="vlcFoot">Carregando placar…</div>
</section>
<script>
(function(){
  var API='https://radio.radiobitcoin.org';
  var LOCS=[
    {id:'claude', nome:'Claude', cor:'#f2a900', img:'locutor_claude.webp'},
    {id:'gemini', nome:'Gemini', cor:'#4b8bf5', img:'locutor_gemini.webp'},
    {id:'gpt',    nome:'GPT',    cor:'#10a37f', img:'locutor_gpt4o.webp'},
    {id:'grok',   nome:'Grok',   cor:'#9fb2c8', img:'locutor_grok.webp'},
  ];
  var grid=document.getElementById('vlcGrid'), foot=document.getElementById('vlcFoot');
  var meuVoto=null; try{ meuVoto=localStorage.getItem('rb_voto_locutor'); }catch(e){}
  function build(){
    grid.innerHTML='';
    LOCS.forEach(function(l){
      grid.insertAdjacentHTML('beforeend',
        '<div class="vlc__card"><div class="vlc__top">'+
          '<img class="vlc__av" src="'+l.img+'" alt="'+l.nome+'" style="border:2px solid '+l.cor+'">'+
          '<div><div class="vlc__nm">'+l.nome+'</div><div class="vlc__tag">Locutor IA</div></div></div>'+
        '<div class="vlc__barwrap"><div class="vlc__bar" id="vbar-'+l.id+'" style="background:'+l.cor+'"></div></div>'+
        '<div class="vlc__row"><span class="vlc__pct" id="vpct-'+l.id+'" style="color:'+l.cor+'">—</span>'+
          '<span class="vlc__votes" id="vv-'+l.id+'"></span></div>'+
        '<button class="vlc__btn" id="vbtn-'+l.id+'" style="background:'+l.cor+'" data-id="'+l.id+'">Votar no '+l.nome+'</button></div>');
    });
    LOCS.forEach(function(l){ document.getElementById('vbtn-'+l.id).addEventListener('click',function(){ votar(l.id); }); });
  }
  function pintar(votos){
    var total=LOCS.reduce(function(s,l){return s+(votos[l.id]||0);},0)||1;
    LOCS.forEach(function(l){
      var n=votos[l.id]||0, pct=Math.round(100*n/total);
      var bar=document.getElementById('vbar-'+l.id); if(bar)bar.style.width=pct+'%';
      var p=document.getElementById('vpct-'+l.id); if(p)p.textContent=pct+'%';
      var v=document.getElementById('vv-'+l.id); if(v)v.textContent=n+(n===1?' voto':' votos');
      var b=document.getElementById('vbtn-'+l.id);
      if(b){ if(meuVoto===l.id){ b.classList.add('voted'); b.textContent='✓ Seu voto'; }
             b.disabled = !!meuVoto; }
    });
    foot.textContent='Total: '+total+' votos · fonte ao vivo';
  }
  function carregar(){
    fetch(API+'/placar',{cache:'no-store'}).then(function(r){return r.json();}).then(function(d){ pintar(d.votos||{}); })
      .catch(function(){ foot.textContent='Placar indisponível no momento.'; });
  }
  function votar(id){
    if(meuVoto){ return; }
    var b=document.getElementById('vbtn-'+id); if(b){b.disabled=true;b.textContent='Registrando…';}
    fetch(API+'/votar',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({locutor:id})})
      .then(function(r){ return r.json().then(function(j){return {ok:r.ok,j:j};}); })
      .then(function(res){
        if(res.ok && res.j.ok){ meuVoto=id; try{localStorage.setItem('rb_voto_locutor',id);}catch(e){} carregar(); }
        else { foot.textContent = res.j.erro || 'Não foi possível votar agora.'; if(b){b.disabled=false;b.textContent='Votar';} }
      })
      .catch(function(){ foot.textContent='Erro de conexão ao votar.'; if(b){b.disabled=false;b.textContent='Votar';} });
  }
  build(); carregar(); setInterval(carregar, 30000);
})();
</script>
<!-- ===== FIM VOTAÇÃO LOCUTORES ===== -->

<!-- ===== NÓ BITCOIN AO VIVO (BIT ADICT) ===== -->
  <style>
  .btcnode{max-width:1100px;margin:14px auto;padding:16px 20px;background:linear-gradient(135deg,#12100a,#0a0803);border:2px solid rgba(242,169,0,0.55);border-radius:14px;font-family:ui-monospace,Menlo,monospace;box-shadow:0 0 34px -10px rgba(242,169,0,0.4);}
  .btcnode__head{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:12px;}
  .btcnode__dot{width:10px;height:10px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:mbPulse 1.6s infinite;}
  .btcnode__title{font-size:14px;color:#f2a900;font-weight:900;letter-spacing:1.5px;}
  .btcnode__badge{font-size:8px;background:rgba(34,197,94,.15);color:#22c55e;border:1px solid rgba(34,197,94,.4);border-radius:20px;padding:3px 10px;letter-spacing:1px;}
  .btcnode__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;}
  .btcnode__cell{background:rgba(0,0,0,.4);border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:10px 12px;}
  .btcnode__k{font-size:8px;color:#7a8290;letter-spacing:1px;text-transform:uppercase;}
  .btcnode__v{font-size:16px;color:#fff;font-weight:bold;margin-top:3px;}
  .btcnode__foot{font-size:8px;color:#7a8290;margin-top:10px;text-align:right;}
  .btcnode__bar{height:6px;background:rgba(255,255,255,.08);border-radius:4px;overflow:hidden;margin-top:6px;}
  .btcnode__bar>i{display:block;height:100%;background:linear-gradient(90deg,#f2a900,#ffce4d);width:0;transition:width .6s;}
  </style>
  <section class="btcnode" id="btcNode">
    <div class="btcnode__head">
      <span class="btcnode__dot"></span>
      <span class="btcnode__title">🟠 NOSSO NÓ BITCOIN — AO VIVO</span>
      <span class="btcnode__badge" id="bnState">conectando…</span>
      <div style="flex:1"></div>
      <span id="bnListeners" style="font-size:12px;color:#22c55e;font-weight:bold;">🎧 —</span>
      <span style="font-size:9px;color:#9ca3af;margin-left:14px;">Não confie. Verifique.</span>
    </div>
    <div class="btcnode__grid">
      <div class="btcnode__cell"><div class="btcnode__k">Sincronização</div><div class="btcnode__v" id="bnProg">—</div><div class="btcnode__bar"><i id="bnBar"></i></div></div>
      <div class="btcnode__cell"><div class="btcnode__k">Bloco</div><div class="btcnode__v" id="bnBlocks">—</div></div>
      <div class="btcnode__cell"><div class="btcnode__k">Rede</div><div class="btcnode__v" id="bnChain">mainnet</div></div>
      <div class="btcnode__cell" title="Nó 'pruned' (podado): valida 100% das regras da rede com autonomia total, mas guarda só os blocos mais recentes pra economizar espaço em disco — a mesma segurança de um nó completo, sem precisar de 600+ GB."><div class="btcnode__k">Tipo <span style="font-size:9px;color:#6b7280;cursor:help;">ⓘ</span></div><div class="btcnode__v" id="bnType">pruned</div></div>
    </div>
    <div class="btcnode__foot">Nó Bitcoin Core soberano da Rádio Bitcoin · validando a rede sem intermediários</div>
  </section>
  <script>
  (function(){
    function fmt(n){try{return Number(n).toLocaleString('pt-BR');}catch(e){return n;}}
    function upd(){
      fetch('/node_status.json?'+Date.now()).then(function(r){return r.json();}).then(function(d){
        var prog=(d.verificationprogress||0)*100;
        var blocks=d.blocks||0, headers=d.headers||0, ibd=d.initialblockdownload;
        document.getElementById('bnProg').textContent=prog.toFixed(2)+'%';
        document.getElementById('bnBar').style.width=Math.min(prog,100)+'%';
        document.getElementById('bnBlocks').textContent=fmt(blocks)+(headers?(' / '+fmt(headers)):'');
        document.getElementById('bnChain').textContent=(d.chain==='main'?'mainnet':d.chain);
        document.getElementById('bnType').textContent=d.pruned?'pruned':'completo';
        document.getElementById('bnState').textContent=ibd?('sincronizando '+prog.toFixed(1)+'%'):'sincronizado ✓';
        var L=document.getElementById('bnListeners');
        if(L && typeof d.radio_listeners==='number'){ var n=d.radio_listeners; L.textContent='🎧 '+n+' ouvindo agora'; L.style.color=n>0?'#22c55e':'#7a8290'; }
      }).catch(function(){document.getElementById('bnState').textContent='offline';});
    }
    upd(); setInterval(upd, 60000);
  })();
  </script>
