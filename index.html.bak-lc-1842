const SV_MINE     = 'satoshi_my_vote_v1';
const SV_LOCAL    = 'satoshi_votes_local_v1';
const SV_SERVER   = 'https://vote.radiobitcoin.org';
let   _svVotes    = {};
let   _svOnline   = false;

function satoshiGetMine() { return localStorage.getItem(SV_MINE) || null; }
function _svLocalVotes() { try { return JSON.parse(localStorage.getItem(SV_LOCAL))||{}; } catch(e) { return {}; } }

function _svFetch(url, opts) { return _localFetch(url, opts); }

async function satoshiLoadVotes() {
  const r = await _svFetch(SV_SERVER + '/RESULTADOS/satoshi_votes.json?t=' + Date.now());
  if (r && r.ok) {
    _svVotes  = await r.json();
    _svOnline = true;
  } else {
    _svVotes  = _svLocalVotes();
    _svOnline = false;
  }
  satoshiRender();
}

async function satoshiVote(id) {
  if (satoshiGetMine()) return;
  const r = await _svFetch(SV_SERVER + '/votar_satoshi', {
    method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({id})
  });
  if (r && r.ok) {
    const d = await r.json();
    _svVotes = d.votos || _svVotes;
  } else {
    const local = _svLocalVotes();
    local[id] = (local[id]||0) + 1;
    localStorage.setItem(SV_LOCAL, JSON.stringify(local));
    _svVotes = local;
  }
  localStorage.setItem(SV_MINE, id);
  satoshiRender();
  // Toast de confirmação
  const c = SATOSHI_CANDIDATES.find(x => x.id === id);
  svShowToast(c ? c.name : id);
}

function svShowToast(name) {
  let t = document.getElementById('svToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'svToast';
    t.innerHTML = `<div class="t-icon">⚡</div><div class="t-txt"><div class="t-title">VOTO COMPUTADO!</div><div class="t-sub" id="svToastSub"></div></div>`;
    document.body.appendChild(t);
  }
  document.getElementById('svToastSub').textContent = 'Você votou em ' + name + ' como Satoshi Nakamoto';
  t.classList.add('show');
  clearTimeout(window._svToastTimer);
  window._svToastTimer = setTimeout(() => t.classList.remove('show'), 3500);
}

function satoshiReset() {
  localStorage.removeItem(SV_MINE);
  satoshiRender();
}

function satoshiRender() {
  const votes  = _svVotes;
  const mine   = satoshiGetMine();
  const total  = Object.values(votes).reduce((a,b)=>a+b,0);
  const grid   = document.getElementById('satoshiGrid');
  const myEl   = document.getElementById('svMyVote');
  const totEl  = document.getElementById('svTotal');
  const placar = document.getElementById('svPlacar');
  if (!grid) return;

  // Renderiza estatísticas completas
  if (placar) {
    const sorted = SATOSHI_CANDIDATES
      .map(c => ({...c, v: votes[c.id]||0, pct: total>0 ? Math.round((votes[c.id]||0)/total*100) : 0}))
      .sort((a,b) => b.v - a.v);
    const medals = ['🥇','🥈','🥉'];
    const barColorMap = { fav:'#00ff41', alt:'#38bdf8', curi:'#f97316' };
    const statusHtml = _svOnline
      ? '<span style="color:#00ff41;font-size:8px;">● ONLINE</span>'
      : '<span style="color:#f2a900;font-size:8px;">● LOCAL</span>';

    if (total === 0) {
      placar.innerHTML = `<div style="text-align:center;padding:10px 0;font-size:9px;color:#444;font-family:ui-monospace,Menlo,monospace;">
        Nenhum voto ainda — seja o primeiro! 👇
      </div>`;
    } else {
      placar.innerHTML = `
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
          <div style="font-size:8px;color:var(--gold);font-family:ui-monospace,Menlo,monospace;font-weight:900;letter-spacing:1px;">📊 ESTATÍSTICAS — ${total} voto${total!==1?'s':''}</div>
          ${statusHtml}
        </div>
        ${sorted.map((c,i) => `
          <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px;">
            <img loading="lazy" decoding="async" src="${c.img}" alt="${c.name}" style="width:22px;height:22px;border-radius:4px;object-fit:cover;flex-shrink:0;border:1px solid rgba(255,255,255,0.08);"
                 onerror="this.style.display='none'">
            <div style="font-size:8px;font-weight:700;color:${i<3?'#fff':'#9ca3af'};width:74px;flex-shrink:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
              ${i<3?medals[i]:' '} ${c.name.split(' ')[0]}
            </div>
            <div style="flex:1;height:7px;background:rgba(255,255,255,0.05);border-radius:4px;overflow:hidden;">
              <div style="width:${c.pct}%;height:100%;background:${i===0?'linear-gradient(90deg,'+barColorMap[c.tier]+','+barColorMap[c.tier]+'aa)':'linear-gradient(90deg,rgba(255,255,255,0.2),rgba(255,255,255,0.1))'};border-radius:4px;transition:width 0.8s ease;"></div>
            </div>
            <div style="font-size:8px;font-weight:900;color:${i===0?barColorMap[c.tier]:'#6b7280'};min-width:26px;text-align:right;font-family:ui-monospace,Menlo,monospace;">${c.pct}%</div>
            <div style="font-size:7px;color:#374151;min-width:18px;text-align:right;font-family:ui-monospace,Menlo,monospace;">${c.v}v</div>
          </div>`).join('')}
        <div style="margin-top:6px;padding-top:6px;border-top:1px solid rgba(255,255,255,0.05);font-size:7px;color:#374151;font-family:ui-monospace,Menlo,monospace;text-align:right;">
          líder: ${sorted[0].name} com ${sorted[0].pct}% dos votos
        </div>`;
    }
  }

  const barColors = { fav:'linear-gradient(90deg,#00cc33,#00ff41)', alt:'linear-gradient(90deg,#0077cc,#00d4ff)', curi:'linear-gradient(90deg,#cc6600,#ff9900)' };

  grid.innerHTML = SATOSHI_CANDIDATES.map(c => {
    const v   = votes[c.id] || 0;
    const pct = total > 0 ? Math.round(v/total*100) : 0;
    const isVoted = mine === c.id;
    return `<div class="sv-card${isVoted?' voted':''}" onclick="satoshiVote('${c.id}')">
      <div class="sv-card-inner">
        <img class="sv-photo" src="${c.img}" alt="${c.name}" loading="lazy"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
        <div class="sv-photo-fallback" style="display:none">${c.emoji}</div>
        <div class="sv-body">
          <div class="sv-name">${c.name}</div>
          <div class="sv-tier ${c.tier}">${c.tierLabel}</div>
          <div class="sv-desc">${c.desc}</div>
          <div class="sv-bar-wrap"><div class="sv-bar" style="width:${pct}%;background:${barColors[c.tier]}"></div></div>
          <div class="sv-pct">${pct}% · ${v} voto${v!==1?'s':''}</div>
        </div>
      </div>
      <!-- TOOLTIP PREVIEW -->
      <div class="sv-tooltip">
        <img loading="lazy" decoding="async" class="svt-photo" src="${c.img}" alt="${c.name}"
             onerror="this.style.display='none';">
        <div class="svt-body">
          <div class="svt-name">${c.name}</div>
          <div class="svt-tier ${c.tier}">${c.tierLabel}</div>
          <div class="svt-fact">${c.full || c.desc}</div>
          <div class="svt-cta">🗳️ CLIQUE PARA VOTAR</div>
        </div>
      </div>
    </div>`;
  }).join('');

  totEl.textContent = total + ' voto' + (total!==1?'s':'') + ' registrados';

  if (mine) {
    const c = SATOSHI_CANDIDATES.find(x=>x.id===mine);
    myEl.style.display = '';
    myEl.textContent   = '⚡ Seu voto: ' + (c ? c.name : mine);
  } else {
    myEl.style.display = 'none';
    myEl.textContent   = '';
  }
}

satoshiLoadVotes();
setInterval(satoshiLoadVotes, 30000);

</script>
<script>
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('/sw.js').catch(function(){});
}
</script>
<script>
// ══════════════════════════════════════════════
// CAMPEONATO IA — VOTAÇÃO POPULAR
// ══════════════════════════════════════════════
const IA_CANDIDATES = [
  { id:'gemini',   nome:'Gemini 3 Flash',  badge:'Google',    color:'#4285F4', img:'ia_gemini_entry.webp', desc:'Criado pelo Gemini 3.4 Flash para o Campeonato IA & Nana Banana', assinado:'Gemini 3 Flash' },
  { id:'claude',   nome:'Claude',          badge:'Anthropic', color:'#ff6b35', img:'ia_claude_entry.png',  desc:'Em breve — aguardando submissão do Claude', assinado:'Claude Sonnet' },
  { id:'chatgpt',  nome:'ChatGPT',         badge:'OpenAI',    color:'#10a37f', img:'ia_chatgpt_entry.png', desc:'Em breve — aguardando submissão do ChatGPT', assinado:'ChatGPT 4o' },
  { id:'manus',    nome:'Manus',           badge:'Manus AI',  color:'#a855f7', img:'ia_manus_entry.png',   desc:'Em breve — aguardando submissão do Manus', assinado:'Manus AI' },
  { id:'grok',     nome:'Grok',            badge:'xAI',       color:'#1da1f2', img:'ia_grok_entry.png',    desc:'Em breve — aguardando submissão do Grok', assinado:'Grok 3' },
  { id:'llama',    nome:'Meta Llama',      badge:'Meta',      color:'#0668e1', img:'ia_llama_entry.png',   desc:'Em breve — aguardando submissão do Llama (gratuito/open source)', assinado:'Llama 3' },
  { id:'copilot',  nome:'Copilot',         badge:'Microsoft', color:'#00adef', img:'ia_copilot_entry.png', desc:'Em breve — aguardando submissão do Copilot', assinado:'Microsoft Copilot' },
  { id:'deepseek', nome:'DeepSeek',        badge:'DeepSeek',  color:'#00c4cc', img:'ia_deepseek_entry.png',desc:'Em breve — aguardando submissão do DeepSeek (gratuito)', assinado:'DeepSeek V3' },
];

const IA_VOTE_KEY = 'ia_champ_vote';
const IA_VOTES_KEY = 'ia_champ_votes';

function iaGetMyVote() {
  return localStorage.getItem(IA_VOTE_KEY) || null;
}

function iaGetVotes() {
  try { return JSON.parse(localStorage.getItem(IA_VOTES_KEY)) || {}; } catch(e) { return {}; }
}

function iaSaveVotes(votes) {
  localStorage.setItem(IA_VOTES_KEY, JSON.stringify(votes));
}

function iaVote(id) {
  if (iaGetMyVote()) return;
  const votes = iaGetVotes();
  votes[id] = (votes[id] || 0) + 1;
  iaSaveVotes(votes);
  localStorage.setItem(IA_VOTE_KEY, id);
  iaRender();
}

function iaRender() {
  const votes  = iaGetVotes();
  const myVote = iaGetMyVote();
  const total  = Object.values(votes).reduce((a,b)=>a+b,0);

  // Placar
  const placarEl = document.getElementById('ia-placar-rows');
  if (placarEl) {
    const sorted = [...IA_CANDIDATES].sort((a,b)=>(votes[b.id]||0)-(votes[a.id]||0));
    placarEl.innerHTML = sorted.map((c,i)=>{
      const v = votes[c.id] || 0;
      const pct = total > 0 ? Math.round(v/total*100) : 0;
      const medal = i===0?'🥇':i===1?'🥈':i===2?'🥉':'  ';
      const isWinner = i===0 && v>0;
      return `<div style="display:flex;align-items:center;gap:6px;padding:3px 0;">
        <span style="font-size:10px;width:16px;">${medal}</span>
        <span style="font-size:8px;color:${c.color};font-weight:bold;flex:1;letter-spacing:1px;">${c.nome}</span>
        <div style="flex:2;background:rgba(255,255,255,0.05);border-radius:3px;height:6px;overflow:hidden;">
          <div style="width:${pct}%;height:100%;background:${c.color};transition:width 0.5s;"></div>
        </div>
        <span style="font-size:8px;color:#ccc;width:32px;text-align:right;">${v} ${pct>0?'('+pct+'%)':''}</span>
      </div>`;
    }).join('');
    if (total===0) placarEl.innerHTML = '<div style="font-size:8px;color:#444;text-align:center;padding:4px;">Seja o primeiro a votar 👇</div>';
  }

  // Galeria
  const galleryEl = document.getElementById('ia-gallery');
  if (!galleryEl) return;
  galleryEl.innerHTML = IA_CANDIDATES.map(c=>{
    const v = votes[c.id] || 0;
    const isVoted = myVote === c.id;
    const voted   = !!myVote;
    const hasImg  = c.id === 'gemini';
    return `<div style="border:1px solid ${isVoted?c.color:'rgba(255,255,255,0.08)'};border-radius:8px;overflow:hidden;background:rgba(0,10,0,0.6);transition:border 0.3s;">
      ${hasImg
        ? `<img loading="lazy" decoding="async" src="${c.img}" alt="${c.nome}" style="width:100%;display:block;border-radius:6px 6px 0 0;">`
        : `<div style="width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;background:rgba(${hexToRgb(c.color)},0.05);border-radius:6px 6px 0 0;border-bottom:1px solid rgba(255,255,255,0.05);">
             <div style="text-align:center;">
               <div style="font-size:28px;margin-bottom:6px;">⏳</div>
               <div style="font-size:9px;color:#555;letter-spacing:1px;">AGUARDANDO SUBMISSÃO</div>
             </div>
           </div>`
      }
      <div style="padding:10px;">
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:4px;">
          <span style="font-size:10px;font-weight:bold;color:${c.color};">${c.nome}</span>
          <span style="font-size:7px;background:rgba(${hexToRgb(c.color)},0.15);color:${c.color};padding:1px 6px;border-radius:10px;letter-spacing:1px;">${c.badge}</span>
        </div>
        <div style="font-size:8px;color:#888;margin-bottom:8px;">${c.desc}</div>
        <div style="display:flex;align-items:center;justify-content:space-between;">
          <button onclick="${voted?'':\"iaVote('\"+ c.id +\"')\"}" style="background:${isVoted?c.color:'transparent'};color:${isVoted?'#000':c.color};border:1px solid ${c.color};border-radius:4px;padding:5px 12px;font-size:9px;cursor:${voted?'default':'pointer'};letter-spacing:1px;font-weight:bold;transition:all 0.2s;">
            ${isVoted?'✅ SEU VOTO':'👍 VOTAR'}
          </button>
          <span style="font-size:9px;color:#ccc;">${v} voto${v!==1?'s':''}</span>
        </div>
      </div>
    </div>`;
  }).join('');
}

function hexToRgb(hex) {
  const r = parseInt(hex.slice(1,3),16);
  const g = parseInt(hex.slice(3,5),16);
  const b = parseInt(hex.slice(5,7),16);
  return r+','+g+','+b;
}

iaRender();
</script>

