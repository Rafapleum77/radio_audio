<style>
#rbMenuBtn{position:fixed;top:12px;right:12px;z-index:9999;width:46px;height:46px;border-radius:12px;
  background:linear-gradient(160deg,#0d1220,#0a0e18);border:1px solid rgba(0,212,255,.5);color:#00d4ff;
  font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;
  box-shadow:0 6px 20px -6px rgba(0,212,255,.5);backdrop-filter:blur(6px)}
#rbMenuBtn:hover{border-color:#00d4ff;transform:translateY(-1px)}
#rbNavOverlay{position:fixed;inset:0;background:rgba(2,6,14,.72);backdrop-filter:blur(3px);z-index:9998;
  opacity:0;pointer-events:none;transition:opacity .25s}
#rbNavOverlay.on{opacity:1;pointer-events:auto}
#rbNavDrawer{position:fixed;top:0;right:0;height:100%;width:min(84vw,320px);z-index:9999;
  background:linear-gradient(160deg,#0a0e18 0%,#0b1020 100%);border-left:1px solid rgba(0,212,255,.28);
  box-shadow:-14px 0 40px -10px rgba(0,0,0,.7);transform:translateX(100%);transition:transform .28s cubic-bezier(.4,0,.2,1);
  overflow-y:auto;padding:18px 0 40px}
#rbNavDrawer.on{transform:translateX(0)}
.rbnav-h{font-family:ui-monospace,Menlo,monospace;font-size:11px;letter-spacing:3px;color:#00d4ff;
  text-transform:uppercase;padding:6px 22px;opacity:.7;margin-top:14px}
.rbnav-a{display:flex;align-items:center;gap:12px;padding:12px 22px;color:#dfe9ec;text-decoration:none;
  font-size:15px;font-weight:600;border-left:3px solid transparent;transition:background .15s,border-color .15s}
.rbnav-a:hover{background:rgba(0,212,255,.08);border-left-color:#00d4ff}
.rbnav-close{display:flex;align-items:center;justify-content:space-between;padding:4px 18px 14px;border-bottom:1px solid rgba(255,255,255,.08);margin-bottom:6px}
.rbnav-close b{font-family:ui-monospace,Menlo,monospace;font-size:13px;color:#f2a900;letter-spacing:2px}
.rbnav-close button{background:none;border:0;color:#9ca3af;font-size:26px;cursor:pointer;line-height:1}
</style>
