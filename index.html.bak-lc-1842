function initChart(interval, sym) {
  document.getElementById('tv-chart').innerHTML = '';
  tvWidget = new TradingView.widget({
    autosize: true,
    symbol: sym || tvSymbol,
    interval: interval || '60',
    container_id: 'tv-chart',
    library_path: '/charting_library/',
    locale: 'br',
    theme: 'dark',
    style: '1',
    toolbar_bg: '#000',
    enable_publishing: false,
    hide_top_toolbar: true,
    hide_legend: true,
    save_image: false,
    backgroundColor: 'rgba(0,0,0,0)',
    gridColor: 'rgba(0,255,65,0.05)',
  });
}

function setChart(range) {
  document.querySelectorAll('.chart-tab').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
  tvSymbol = 'BINANCE:BTCUSDT';
  const map = {'1D':'60','1W':'240','1M':'D','3M':'W'};
  initChart(map[range] || '60');
}

function setChartSym(sym, interval, btn) {
  document.querySelectorAll('.chart-tab').forEach(t => t.classList.remove('active'));
  if(btn) btn.classList.add('active');
  tvSymbol = sym;
  initChart(interval || '60', sym);
}
