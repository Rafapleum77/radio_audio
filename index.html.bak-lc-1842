    <script>
      function aloEnviar(){
        var m=document.getElementById('aloMsg').value.trim();
        if(!m){document.getElementById('aloMsg').focus();return;}
        var n=document.getElementById('aloNome').value.trim();
        var corpo=m+(n?('\n\n— '+n):'')+'\n\n(via Alô Doçura · radiobitcoin.org)';
        window.location.href='mailto:radiobitcoin.org@gmail.com?subject='+encodeURIComponent('Alô Doçura — dica de '+(n||'um ouvinte'))+'&body='+encodeURIComponent(corpo);
        document.getElementById('aloDocOv').classList.remove('open');
        document.getElementById('aloMsg').value='';document.getElementById('aloNome').value='';
      }
      document.getElementById('aloDocOv').addEventListener('click',function(e){if(e.target===this)this.classList.remove('open');});
    </script>

