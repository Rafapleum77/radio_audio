<!-- ═══════════ PARCEIROS & AMIGOS ═══════════ -->
<style>
.rb-parc{max-width:1100px;margin:18px auto;padding:26px 18px;background:linear-gradient(160deg,#0a0d13 0%,#0e1420 100%);border:1px solid rgba(242,169,0,.25);border-radius:14px;text-align:center}
