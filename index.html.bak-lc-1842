};

let currentVidCat = 'trez';

function switchVidCat(cat, btn) {
  currentVidCat = cat;
  document.querySelectorAll('.vid-tab').forEach(t => t.classList.remove('active'));
  if(btn) btn.classList.add('active');
  const player = document.getElementById('vidPlayer');
  const desc   = document.getElementById('vidDesc');
  const chanSel= document.getElementById('tutChannelSel');
  if (cat === 'tut') {
    if(chanSel) chanSel.style.display = 'flex';
    renderTutChannels();
    loadTutChannel(VID_CATS.tut.currentChannel);
  } else {
    if(chanSel) chanSel.style.display = 'none';
    const catData = VID_CATS[cat];
    if (!catData) return;
    // Canal com handle → overlay "abrir no YouTube"
    if (catData.handle) {
      if(player) player.style.display = 'none';
      const wrap = player ? player.parentElement : null;
      if(wrap) {
        const old = wrap.querySelector('.handle-overlay');
        if(old) old.remove();
        const ov = document.createElement('div');
        ov.className = 'handle-overlay';
        ov.style.cssText = 'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;height:200px;background:#111;border-radius:6px;';
        ov.innerHTML = `<div style="font-size:28px;">📺</div>
          <div style="font-size:13px;color:#fff;font-weight:bold;">${catData.desc}</div>
          <a href="https://www.youtube.com/@${catData.handle}/videos" target="_blank"
             style="background:#ff0000;color:#fff;font-weight:700;font-size:12px;padding:10px 20px;border-radius:6px;text-decoration:none;letter-spacing:1px;">
            ▶ ABRIR NO YOUTUBE
          </a>`;
        wrap.appendChild(ov);
      }
    } else {
      // Canal com src de embed
      const old2 = player && player.parentElement ? player.parentElement.querySelector('.handle-overlay') : null;
      if(old2) old2.remove();
      if(player) { player.style.display = ''; player.src = catData.src || ''; }
    }
    if(desc) desc.textContent = catData.desc || '';
  }
}

function renderTutChannels() {
  const sel = document.getElementById('tutChannelSel');
  if(!sel) return;
  sel.innerHTML = '';
  VID_CATS.tut.channels.forEach((ch, i) => {
    const b = document.createElement('button');
    b.className = 'tut-ch-btn' + (i === VID_CATS.tut.currentChannel ? ' active' : '');
    b.textContent = ch.label;
    b.onclick = () => {
      VID_CATS.tut.currentChannel = i;
      loadTutChannel(i);
      document.querySelectorAll('.tut-ch-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
    };
    sel.appendChild(b);
  });
}

function loadTutChannel(idx) {
  const ch = VID_CATS.tut.channels[idx];
  const player = document.getElementById('vidPlayer');
  const desc   = document.getElementById('vidDesc');
  const wrap   = player ? player.parentElement : null;
  let existing = wrap ? wrap.querySelector('.handle-overlay') : null;
  if (existing) existing.remove();
  if (ch.video) {
    if(player) { player.style.display=''; player.src = `https://www.youtube.com/embed/${ch.video}?rel=0&modestbranding=1`; }
  } else if (ch.playlist) {
    if(player) { player.style.display=''; player.src = `https://www.youtube.com/embed/videoseries?list=${ch.playlist}&rel=0&modestbranding=1`; }
  } else if (ch.handle) {
    if(player) player.style.display='none';
    if(wrap) {
      const ov = document.createElement('div');
      ov.className = 'handle-overlay';
      ov.style.cssText = 'display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;height:200px;background:#111;border-radius:6px;';
      ov.innerHTML = `<div style="font-size:13px;color:#aaa;">📺 ${ch.label}</div>
        <div style="font-size:10px;color:#666;">${ch.desc}</div>
        <a href="https://www.youtube.com/@${ch.handle}/videos" target="_blank"
           style="background:#f00;color:#fff;font-weight:700;font-size:11px;padding:8px 16px;border-radius:4px;text-decoration:none;letter-spacing:1px;">
          ▶ VER NO YOUTUBE
        </a>`;
      wrap.appendChild(ov);
    }
  }
  if(desc) desc.textContent = ch.desc;
}

