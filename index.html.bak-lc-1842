let TRACKS = [];
let currentIdx = 0, isPlaying = false, isShuffle = false, isRepeat = false;
const audio = document.getElementById('audioEl');
const btnPlay = document.getElementById('btnPlay');

async function carregarTracks() {
  try {
    const r = await fetch('tracks.json?t=' + Date.now());
    if (r.ok) {
      TRACKS = await r.json();
      ordenarBitcoinPrimeiro();   // playlist Bitcoin/HODL/Satoshi no topo
      renderPlaylist();
      if (!window._radioAutoStart && TRACKS.length) { window._radioAutoStart = true; autoStartRadio(); }
    }
  } catch(e) {}
}

// Reordena TRACKS pra que as faixas de Bitcoin/HODL/Satoshi toquem primeiro —
// é a "Radio Bitcoin Hype" que abre quando a pessoa entra no site.
function ordenarBitcoinPrimeiro() {
  const KW = ['bitcoin','hodl','satoshi','cripto','autocust','salva','missão','missao','moeda','soberan','btc'];
  const isBtc = t => KW.some(k => String(t.title || '').toLowerCase().includes(k));
  const btc = TRACKS.filter(isBtc);
  const resto = TRACKS.filter(t => !isBtc(t));
  if (btc.length) TRACKS = [...btc, ...resto];
}

// ── Autoplay ao entrar no site ──────────────────────────────
// Navegadores bloqueiam áudio com som antes de uma interação do usuário.
// Estratégia: tenta tocar imediatamente; se for bloqueado, inicia no
// primeiro gesto (clique/toque/tecla/scroll) — o que ocorre em segundos.
function autoStartRadio() {
  // Abre com "Bitcoin é a Salvação" (hit no Spotify)
  const mIdx = TRACKS.findIndex(t => String(t.title || '').toLowerCase().includes('salvação'));
  const mIdx2 = mIdx >= 0 ? mIdx : TRACKS.findIndex(t => String(t.title || '').toLowerCase().includes('salva'));
  currentIdx = mIdx2 >= 0 ? mIdx2 : 0;
  const vs = document.getElementById('volSlider');
  if (vs) {
    vs.value = 0.25;
    audio.volume = 0.25;
    const vv = document.getElementById('volVal');
    if (vv) vv.textContent = '25%';
  }
  loadTrack();
  // autoplay desativado: musica so toca quando o usuario clicar no play
}

async function carregarPedidos() {
  try {
    const r = await fetch('pedidos.json?t=' + Date.now());
    if (!r.ok) return;
    const pedidos = await r.json();
    let el = document.getElementById('pedidos-list');
    if (!el) return;
    if (!pedidos.length) {
      el.innerHTML = '<div style="font-size:9px;color:var(--text-dim);padding:4px">Nenhum pedido ainda. Use /pedir no Telegram.</div>';
      return;
    }
    el.innerHTML = pedidos.slice().reverse().map(p =>
      `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid rgba(0,255,65,0.08);font-size:9px">
        <span style="color:var(--g)">🎵 ${p.musica}</span>
        <span style="color:var(--text-dim)">${p.usuario} · ${p.ts}</span>
      </div>`
    ).join('');
  } catch(e) {}
}

carregarTracks();
carregarPedidos();
setInterval(carregarTracks, 600000);   // recarrega tracks a cada 10 min
setInterval(carregarPedidos, 60000);   // recarrega pedidos a cada 1 min

// Render playlist agrupada por categoria
function renderPlaylist() {
  const pl = document.getElementById('playlist');
  pl.innerHTML = '';
  const cats = {};
  TRACKS.forEach((t, i) => {
    const cat = t.category || 'Geral';
    if (!cats[cat]) cats[cat] = [];
    cats[cat].push({ t, i });
  });
  const catIcons = {
    'IA': '🤖',
    'Rock Internacional Anos 80': '🎸',
    'Sobrevivencialismo & Clima': '🌦️',
    'Alerta & Sobrevivência': '🌦️',
    'Boletim': '📰',
    'Mercado': '📈',
    'Fluxo do Dinheiro': '💰',
    'Escola Austríaca': '🏛️',
    'Alerta': '🚨',
    'Missão Bitcoin': '🎯'
  };
  Object.entries(cats).forEach(([cat, items]) => {
    const header = document.createElement('div');
    header.style.cssText = 'font-size:8px;color:var(--gold);letter-spacing:2px;text-transform:uppercase;padding:6px 4px 3px;border-bottom:1px solid rgba(242,169,0,0.2);margin-bottom:2px;';
    header.textContent = (catIcons[cat] || '🎵') + ' ' + cat;
    pl.appendChild(header);
    items.forEach(({ t, i }) => {
      const div = document.createElement('div');
      div.className = 'pl-item' + (i === currentIdx ? ' active' : '');
      div.innerHTML = `<span class="pl-num">${i + 1}</span><span class="pl-title">${t.title}</span><span class="pl-dur">${t.dur}</span>`;
      div.onclick = () => { currentIdx = i; loadTrack(); playTrack(); };
      pl.appendChild(div);
    });
  });
}

// Sugestões de músicas bitcoinheiras
function enviarSugestao() {
  const input = document.getElementById('sugInput');
  const val = input.value.trim();
  if (!val) return;
  const lista = JSON.parse(localStorage.getItem('sugestoes_radio') || '[]');
  const nova = { musica: val, ts: new Date().toLocaleString('pt-BR') };
  lista.unshift(nova);
  localStorage.setItem('sugestoes_radio', JSON.stringify(lista.slice(0, 30)));
  input.value = '';
  renderSugestoes();
  const msg = encodeURIComponent('🎵 Sugestão de música para a Rádio Bitcoin: ' + val);
  window.open('https://t.me/Bitadictbot' + msg, '_blank');
}

function renderSugestoes() {
  const lista = JSON.parse(localStorage.getItem('sugestoes_radio') || '[]');
  const el = document.getElementById('sugestoes-list');
  if (!el) return;
  if (!lista.length) { el.innerHTML = '<div style="font-size:9px;color:var(--text-dim);padding:4px">Nenhuma sugestão ainda. Seja o primeiro!</div>'; return; }
  el.innerHTML = lista.map(s =>
    `<div style="display:flex;justify-content:space-between;padding:3px 0;border-bottom:1px solid rgba(0,255,65,0.08);font-size:9px">
      <span style="color:var(--g)">🎵 ${s.musica}</span>
      <span style="color:var(--text-dim)">${s.ts}</span>
    </div>`
  ).join('');
}
renderSugestoes();

function loadTrack() {
  const t = TRACKS[currentIdx];
  audio.src = t.file;
  document.getElementById('trackTitle').textContent = t.title;
  document.getElementById('trackDur').textContent = t.dur;
  document.getElementById('progressFill').style.width = '0%';
  document.getElementById('trackCur').textContent = '0:00';
  renderPlaylist();
  // Album art animation
  document.getElementById('albumArt').classList.remove('spinning');
  // MediaSession: mostra faixa no carro/tela de bloqueio e mantém áudio em background
  if ('mediaSession' in navigator) {
    try {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: t.title || 'Rádio Bitcoin',
        artist: 'Rádio Bitcoin · radiobitcoin.org',
        album: 'Bitcoin é Salvação',
        artwork: [
          { src: 'icon-192.png', sizes: '192x192', type: 'image/png' },
          { src: 'icon-512.png', sizes: '512x512', type: 'image/png' }
        ]
      });
    } catch(e) {}
  }
}

// ── Visualizador de frequência (Web Audio API) ──────────────
let _audioCtx = null, _analyser = null, _visRaf = null;

function _setupVisualizer() {
  if (_analyser) return;
  try {
    _audioCtx  = new (window.AudioContext || window.webkitAudioContext)();
    const src  = _audioCtx.createMediaElementSource(audio);
    _analyser  = _audioCtx.createAnalyser();
    _analyser.fftSize = 256;
    src.connect(_analyser);
    _analyser.connect(_audioCtx.destination);
    _drawVisualizer();
  } catch(e) { console.warn('Visualizer:', e); }
}

// Peak holders para o visualizador
const _peaks = [];
const _peakDecay = 0.015;
function _drawVisualizer() {
  _visRaf = requestAnimationFrame(_drawVisualizer);
  const canvas = document.getElementById('visualizer');
  if (!canvas || !_analyser) return;
  const W = canvas.offsetWidth || 300, H = 72;
  canvas.width = W; canvas.height = H;
  const ctx2 = canvas.getContext('2d');
  const data = new Uint8Array(_analyser.frequencyBinCount);
  _analyser.getByteFrequencyData(data);

  // Fundo preto
  ctx2.fillStyle = '#0a0d12';
  ctx2.fillRect(0, 0, W, H);

  // Grid horizontal — estilo gráfico de trade
  ctx2.strokeStyle = 'rgba(255,255,255,0.06)';
  ctx2.lineWidth = 1;
  for (let i = 1; i < 4; i++) {
    const y = (H / 4) * i;
    ctx2.beginPath(); ctx2.moveTo(0, y); ctx2.lineTo(W, y); ctx2.stroke();
  }

  // Marcadores dB no lado direito
  ctx2.fillStyle = 'rgba(255,255,255,0.18)';
  ctx2.font = '6px ui-monospace,monospace';
  ctx2.textAlign = 'right';
  ['0', '-6', '-12', '-18'].forEach((db, i) => {
    ctx2.fillText(db, W - 2, (H / 4) * i + 7);
  });

  const numBars = 48;
  const step = Math.floor(data.length / numBars);
  const bw = Math.floor((W - numBars) / numBars);
  const gap = 1;

  if (_peaks.length < numBars) {
    for (let i = _peaks.length; i < numBars; i++) _peaks.push(0);
  }

  for (let i = 0; i < numBars; i++) {
    let sum = 0;
    for (let j = 0; j < step; j++) sum += data[i * step + j];
    const avg = sum / step;
    const norm = avg / 255;
    const barH = Math.max(2, norm * (H - 4));
    const x = i * (bw + gap);
    const y = H - barH;

    // Peak decay
    if (norm > _peaks[i]) _peaks[i] = norm;
    else _peaks[i] = Math.max(0, _peaks[i] - _peakDecay);

    // Gradiente verde→amarelo→vermelho por segmentos
    const segments = Math.ceil(barH / 4);
    for (let s = 0; s < segments; s++) {
      const pct = s / Math.max(segments - 1, 1);
      let r, g, b;
      if (pct < 0.6) {
        // verde
        r = 0; g = 220; b = 80;
      } else if (pct < 0.82) {
        // amarelo
        r = 242; g = 169; b = 0;
      } else {
        // vermelho
        r = 239; g = 68; b = 68;
      }
      const alpha = 0.85 + pct * 0.15;
      ctx2.fillStyle = `rgba(${r},${g},${b},${alpha})`;
      const sy = H - 2 - s * 4;
      ctx2.fillRect(x, sy, bw, 3);
    }

    // Brilho na barra (glow)
    const pct = norm;
    let glowColor = pct > 0.82 ? 'rgba(239,68,68,0.3)' : pct > 0.6 ? 'rgba(242,169,0,0.25)' : 'rgba(0,220,80,0.2)';
    ctx2.fillStyle = glowColor;
    ctx2.fillRect(x - 1, y - 1, bw + 2, barH + 2);

    // Peak indicator — linha brilhante no topo
    if (_peaks[i] > 0.05) {
      const peakY = H - _peaks[i] * (H - 4) - 2;
      const peakPct = _peaks[i];
      const pc = peakPct > 0.82 ? '#ef4444' : peakPct > 0.6 ? '#f2a900' : '#00dc50';
      ctx2.fillStyle = pc;
      ctx2.shadowColor = pc;
      ctx2.shadowBlur = 4;
      ctx2.fillRect(x, peakY, bw, 2);
      ctx2.shadowBlur = 0;
    }
  }
}

function playTrack() {
  _setupVisualizer();
  if (_audioCtx && _audioCtx.state === 'suspended') _audioCtx.resume();
  const target = parseFloat(volSlider.value);
  audio.volume = 0;
  audio.play().then(() => {
    isPlaying = true;
    btnPlay.textContent = '⏸';
    document.getElementById('albumArt').classList.add('spinning');
    // Fade-in suave
    let v = 0;
    const step = target / 25;
    const fade = setInterval(() => {
      v = Math.min(v + step, target);
      audio.volume = v;
      if (v >= target) clearInterval(fade);
    }, 40);
  }).catch(() => {});
}

function pauseTrack() {
  audio.pause();
  isPlaying = false;
  btnPlay.textContent = '▶';
  document.querySelectorAll('.wbar').forEach(b => b.classList.add('paused'));
  document.getElementById('albumArt').classList.remove('spinning');
}

btnPlay.onclick = () => {
  if (!audio.src || audio.src === window.location.href) {
    loadTrack(); playTrack(); return;
  }
  isPlaying ? pauseTrack() : playTrack();
};

document.getElementById('btnPrev').onclick = () => {
  currentIdx = (currentIdx - 1 + TRACKS.length) % TRACKS.length;
  loadTrack(); if (isPlaying) playTrack();
};

document.getElementById('btnNext').onclick = () => {
  nextTrack();
};

function nextTrack() {
  if (isShuffle) {
    currentIdx = Math.floor(Math.random() * TRACKS.length);
  } else {
    currentIdx = (currentIdx + 1) % TRACKS.length;
  }
  loadTrack(); if (isPlaying) playTrack();
}

document.getElementById('btnShuffle').onclick = function() {
  isShuffle = !isShuffle;
  this.classList.toggle('active', isShuffle);
};

document.getElementById('btnRepeat').onclick = function() {
  isRepeat = !isRepeat;
  this.classList.toggle('active', isRepeat);
};

audio.onended = () => {
  if (isRepeat) { audio.play(); } else { nextTrack(); }
};

// Auto-resume em stall/buffer vazio (conexão do carro)
let _stallTimer = null;
audio.onwaiting = () => {
  _stallTimer = setTimeout(() => {
    if (audio.paused || audio.readyState < 3) {
      const pos = audio.currentTime;
      audio.load();
      audio.currentTime = pos;
      audio.play().catch(() => {});
    }
  }, 3000);
};
audio.onplaying = () => { clearTimeout(_stallTimer); };
audio.onstalled = () => {
  // Tenta retomar sem reload primeiro
  setTimeout(() => {
    if (isPlaying && audio.paused) audio.play().catch(() => {});
  }, 1500);
};

// ── MediaSession: controles no painel do carro / tela de bloqueio ──
// Sem isso, o navegador trata o áudio como "descartável" e corta quando
// a tela apaga ou o app vai pro background (causa raiz do picote no carro).
if ('mediaSession' in navigator) {
  try {
    navigator.mediaSession.setActionHandler('play',  () => { playTrack(); });
    navigator.mediaSession.setActionHandler('pause', () => { pauseTrack(); });
    navigator.mediaSession.setActionHandler('nexttrack',     () => { nextTrack(); });
    navigator.mediaSession.setActionHandler('previoustrack', () => {
      currentIdx = (currentIdx - 1 + TRACKS.length) % TRACKS.length;
      loadTrack(); if (isPlaying) playTrack();
    });
  } catch(e) {}
  // Mantém o estado de playback sincronizado com o SO
  audio.addEventListener('play',  () => { navigator.mediaSession.playbackState = 'playing'; });
  audio.addEventListener('pause', () => { navigator.mediaSession.playbackState = 'paused'; });
}

// ── Keep-alive do AudioContext (anti-picote com tela apagada no carro) ──
// O áudio passa pelo Web Audio API (visualizer). Quando a tela apaga, o
// AudioContext é suspenso pelo SO → o som picota/corta. Aqui retomamos ele
// sempre que a página volta ao foco e periodicamente enquanto toca.
function _resumeAudioCtx() {
  if (_audioCtx && _audioCtx.state === 'suspended') {
    _audioCtx.resume().catch(() => {});
  }
  // Se o áudio devia estar tocando mas pausou (background), retoma
  if (isPlaying && audio.paused) audio.play().catch(() => {});
}
document.addEventListener('visibilitychange', () => {
  if (!document.hidden) _resumeAudioCtx();
});
window.addEventListener('focus', _resumeAudioCtx);
window.addEventListener('pageshow', _resumeAudioCtx);
setInterval(() => { if (isPlaying) _resumeAudioCtx(); }, 5000);

audio.ontimeupdate = () => {
  if (!audio.duration) return;
  const pct = (audio.currentTime / audio.duration) * 100;
  document.getElementById('progressFill').style.width = pct + '%';
  const m = Math.floor(audio.currentTime / 60);
  const s = Math.floor(audio.currentTime % 60).toString().padStart(2, '0');
  document.getElementById('trackCur').textContent = `${m}:${s}`;
};

document.getElementById('progressBar').onclick = function(e) {
  if (!audio.duration) return;
  const rect = this.getBoundingClientRect();
  const pct = (e.clientX - rect.left) / rect.width;
  audio.currentTime = pct * audio.duration;
};

// ── Compartilhar no X ────────────────────────────────────────
function shareOnX() {
  const track = TRACKS[currentIdx]?.title || 'Radio Bitcoin';
  const text  = `🎵 Ouvindo "${track}" na @bitadict ⚡ Radio Bitcoin — a voz da revolução Bitcoin!\n\nhttps://radiobitcoin.org`;
  window.open('https://x.com/intent/tweet?text=' + encodeURIComponent(text), '_blank', 'noopener');
}

const volSlider = document.getElementById('volSlider');

// Volume persistente via localStorage
const _savedVol = parseFloat(localStorage.getItem('radioVol') ?? '0.8');
audio.volume = _savedVol;
volSlider.value = _savedVol;
document.getElementById('volVal').textContent = Math.round(_savedVol * 100) + '%';

volSlider.oninput = function() {
  audio.volume = this.value;
  localStorage.setItem('radioVol', this.value);
  document.getElementById('volVal').textContent = Math.round(this.value * 100) + '%';
};

renderPlaylist();

