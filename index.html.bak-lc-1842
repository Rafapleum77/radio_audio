    <button id="liveBtn" aria-label="Ouvir ao vivo">▶</button>
  </div>
  <div style="line-height:1.15">
    <div class="qp-name"><span id="liveDot"></span><span id="liveTxt">OUVIR AO VIVO</span><span class="qp-wave"><i></i><i></i><i></i><i></i></span></div>
    <div class="qp-sub">RÁDIO BITCOIN · 24H</div>
  </div>
</div>
<script>
// Controlador único do áudio ao vivo — Hero (#hrPlay) + player flutuante (#liveBtn) compartilham 1 <audio>.
(function(){
  var a=document.getElementById('liveAudio');
  var fb=document.getElementById('liveBtn'),fd=document.getElementById('liveDot');
  var hb=document.getElementById('hrPlay'),ht=document.getElementById('hrPlayTxt');
  function set(id,txt,cor){var e=document.getElementById(id); if(e){e.textContent=txt; if(cor)e.style.color=cor;}}
  function sync(playing){
    if(fb){fb.textContent=playing?'⏸':'▶';}
    if(fd){fd.style.background=playing?'#ef4444':'#6b7280';fd.style.animation=playing?'qpPulseDot 1.1s infinite':'none';}
    var _lr=document.getElementById('liveRadio'); if(_lr)_lr.classList.toggle('qp-playing',playing);
    var _lt=document.getElementById('liveTxt'); if(_lt)_lt.textContent=playing?'AO VIVO':'OUVIR AO VIVO';
    if(hb){hb.querySelector('.ic').textContent=playing?'⏸':'▶';}
    if(ht){ht.textContent=playing?'TOCANDO AO VIVO':'OUVIR AO VIVO';}
    if(hb){hb.classList.toggle('hr-pulsa', !playing);}
    // HUD: estados inequívocos (resolve STANDBY/IDLE eterno)
    set('qpChipStatusTxt', playing?'● AO VIVO':'TOQUE PARA OUVIR', playing?'#ef4444':'');
    set('qpStatus', playing?'AO VIVO':'PARADO', playing?'#22c55e':'var(--qdim)');
    set('qpStatusSub', playing?'Transmitindo agora':'Toque para ouvir');
    set('qpMode', playing?'LIVE':'IDLE', playing?'#00d4ff':'var(--qdim)');
    set('qpModeSub', playing?'Stream 24h':'\u2014');
    set('qpLiveLbl', playing?'AO VIVO':'STANDBY', playing?'#ef4444':'');
  }
  function toggle(){
    if(a.paused){ a.load(); a.play().then(function(){sync(true);}).catch(function(){sync(false);}); }
    else { a.pause(); }
  }
  if(fb)fb.addEventListener('click',toggle);
  if(hb)hb.addEventListener('click',toggle);
  a.addEventListener('playing',function(){sync(true);});
  a.addEventListener('pause',function(){sync(false);});
})();
</script>

<script>
// Player "Só Economia (IA)" — toca em fila os boletins de economia/mercado/fluxo gerados pelas IAs.
// Puxa do tracks.json por categoria, então novos boletins entram sozinhos. O gerente global de
// áudio (mais abaixo) garante que isto pausa o stream ao vivo e vice-versa.
(function(){
  var btn=document.getElementById('econPlay'), txt=document.getElementById('econPlayTxt'),
      ic=btn?btn.querySelector('.ic'):null, now=document.getElementById('econNow'),
      au=document.getElementById('econAudio');
  if(!btn||!au) return;
  var fila=[], idx=0, carregado=false;
  var CATS=['mercado','fluxo','boletim','economia','austriaca','austríaca','alerta','noticia','notícia'];
  function ehEcon(cat){ cat=(cat||'').toLowerCase(); return CATS.some(function(c){return cat.indexOf(c)>=0;}); }
  function setUI(playing){
    if(ic)ic.textContent=playing?'⏸':'📊';
    if(txt)txt.textContent=playing?'ECONOMIA TOCANDO':'SÓ ECONOMIA (IA)';
  }
  function tocaAtual(){
    if(!fila.length) return;
    var t=fila[idx%fila.length];
    au.src=t.file;
    au.play().then(function(){ setUI(true); if(now)now.textContent='📊 '+(t.title||t.file); })
             .catch(function(){ setUI(false); if(now)now.textContent='Não foi possível tocar o boletim.'; });
  }
  function carregar(){
    return fetch('tracks.json',{cache:'no-store'}).then(function(r){return r.json();}).then(function(ts){
      fila=ts.filter(function(t){return t && t.file && ehEcon(t.category);});
      carregado=true;
    });
  }
  btn.addEventListener('click',function(){
    if(!au.paused){ au.pause(); return; }
    if(!carregado){
      if(now)now.textContent='Carregando boletins de economia…';
      carregar().then(function(){
        if(!fila.length){ if(now)now.textContent='Nenhum boletim de economia disponível agora.'; return; }
        idx=0; tocaAtual();
      }).catch(function(){ if(now)now.textContent='Erro ao carregar os boletins.'; });
    } else {
      if(!fila.length) return;
      tocaAtual();
    }
  });
  au.addEventListener('ended',function(){ idx=(idx+1)%(fila.length||1); tocaAtual(); });
  au.addEventListener('playing',function(){ setUI(true); });
  au.addEventListener('pause',function(){ setUI(false); });
})();
</script>
<style>@keyframes livePulse{0%,100%{opacity:1}50%{opacity:.3}}</style>

<script>
// Gerente global de áudio: só 1 player toca por vez (evita música + notícia/stream juntos).
// Usa captura (true) porque eventos de mídia não sobem por bubbling.
(function(){
  document.addEventListener('play', function(e){
    var t = e.target;
    if(!t || t.tagName !== 'AUDIO') return;
    var musicEl = document.getElementById('audioEl');   // player de música da página (tem auto-resume)
    document.querySelectorAll('audio').forEach(function(a){
      if(a !== t && !a.paused){
        // no player de música chama pauseTrack() p/ zerar isPlaying (senão volta sozinho a cada 5s)
        if(a === musicEl && typeof window.pauseTrack === 'function'){ try{ window.pauseTrack(); }catch(_){ a.pause(); } }
        else { try{ a.pause(); }catch(_){} }
      }
    });
    // players criados via new Audio() (locução)
    ['locAudio'].forEach(function(k){
      var o = window[k];
      if(o && o !== t && typeof o.pause === 'function' && !o.paused){ try{ o.pause(); }catch(_){} }
    });
  }, true);
})();
</script>


<script src="assets/site.js" defer></script>
<script>
(function(){
  function fetchListeners(){
    fetch('https://stream.radiobitcoin.org/status-json.xsl')
      .then(function(r){ return r.json(); })
      .then(function(d){
        var src = d.icestats && d.icestats.source;
        if(Array.isArray(src)) src = src[0];
        var n = (src && typeof src.listeners === 'number') ? src.listeners : null;
        if(n === null) return;
        var lisEl  = document.getElementById('qpListeners');
        var chipEl = document.getElementById('qpChipLis');
        if(lisEl){
          lisEl.textContent = n;
          lisEl.style.color = n > 0 ? '#22d3ee' : '#7a8290';
          var sub = lisEl.parentElement && lisEl.parentElement.querySelector('.s');
          if(sub) sub.textContent = n > 0 ? 'ao vivo agora' : 'nenhum agora';
        }
        if(chipEl){
          chipEl.textContent = n + ' ouvinte' + (n !== 1 ? 's' : '') + ' ao vivo';
          chipEl.style.color = n > 0 ? '#22d3ee' : '#7a8290';
        }
      })
      .catch(function(){});
  }
  fetchListeners();
  setInterval(fetchListeners, 60000);
})();
</script>
