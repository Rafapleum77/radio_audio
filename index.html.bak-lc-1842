    background:radial-gradient(circle,rgba(247,166,0,.25),transparent 60%);filter:blur(10px);pointer-events:none;}
  .sr-hero__inner{position:relative;max-width:1100px;margin:0 auto;padding:20px 18px 22px;text-align:center;}
