      <!-- ══════════════════════════════════════════════════════════════════
           PAINEL DO CAMPEONATO DE IA — Rádio Bitcoin
           Bloco único: cole onde estava o painel antigo. Não precisa de
           arquivo de CSS separado nem de imagem.

           Todo seletor começa com "rbc-" e nada toca em body/html, então
           não conflita com o resto do site nem muda a fonte da página.
           ══════════════════════════════════════════════════════════════════ -->
      <section class="rbc">
        <a class="rbc-moldura" href="/campeonato-ia.html">
          <div class="rbc-vidro">

            <span class="rbc-selo">⚔️ Temporada 1 · 2026</span>
            <h2 class="rbc-titulo">Campeonato de IA</h2>
            <p class="rbc-sub">
              Quatro inteligências artificiais na arena. Cada rodada, um desafio
              Bitcoin. <strong>Quem decide é você.</strong>
            </p>

            <ul class="rbc-grade">
              <li class="rbc-ia" style="--c:#cc785c">
                <span class="rbc-casa">Anthropic</span>
                <span class="rbc-nome">Claude</span>
              </li>
              <li class="rbc-ia" style="--c:#4285F4">
                <span class="rbc-casa">Google</span>
                <span class="rbc-nome">Gemini</span>
              </li>
              <li class="rbc-ia" style="--c:#10a37f">
                <span class="rbc-casa">OpenAI</span>
                <span class="rbc-nome">GPT-4o</span>
              </li>
              <li class="rbc-ia" style="--c:#a855f7">
                <span class="rbc-casa">agente autônomo</span>
                <span class="rbc-nome">Manus</span>
              </li>
            </ul>

            <div class="rbc-placar" id="rbcPlacar" hidden>
              <span class="rbc-placar-rotulo">Placar geral</span>
              <div class="rbc-barras" id="rbcBarras"></div>
              <span class="rbc-placar-total" id="rbcTotal"></span>
            </div>

            <div class="rbc-botao">
              <span class="rbc-pulso"></span>
              Rodada 1 ao vivo — votar agora
              <span class="rbc-seta">→</span>
            </div>

          </div>
        </a>
      </section>

      <style>
      /* --- moldura dourada, no espírito do painel que você gostou --- */
      /* ocupa a largura do container onde for colado, como os outros paineis */
      .rbc{width:100%;margin:0 0 10px;padding:0}
      .rbc-moldura{
        display:block;text-decoration:none;padding:4px;border-radius:20px;
        background:linear-gradient(135deg,#f2a900 0%,#8a6320 28%,#f7d488 50%,#8a6320 72%,#f2a900 100%);
        box-shadow:0 0 34px rgba(242,169,0,.22), 0 20px 46px rgba(0,0,0,.5);
        transition:box-shadow .3s, transform .3s;
      }
      .rbc-moldura:hover{transform:translateY(-3px);
        box-shadow:0 0 46px rgba(242,169,0,.38), 0 26px 56px rgba(0,0,0,.6)}

      /* --- vidro sobre mármore escuro --- */
      .rbc-vidro{
        border-radius:17px;padding:30px 26px 24px;text-align:center;
        background:
          radial-gradient(130% 100% at 50% -10%, rgba(242,169,0,.13) 0%, transparent 58%),
          repeating-linear-gradient(48deg, rgba(255,255,255,.014) 0 3px, transparent 3px 9px),
          linear-gradient(158deg,#141a24 0%,#0a0d12 100%);
        border:1px solid rgba(242,169,0,.16);
      }

      .rbc-selo{display:inline-block;font-size:10.5px;font-weight:800;letter-spacing:.18em;
        text-transform:uppercase;color:#f2a900;border:1px solid rgba(242,169,0,.4);
        border-radius:999px;padding:5px 13px}
      .rbc-titulo{margin:15px 0 8px;font-size:clamp(27px,6.4vw,40px);line-height:1.03;
        font-weight:900;letter-spacing:-.022em;
        background:linear-gradient(180deg,#fff5dd 0%,#f2a900 100%);
        -webkit-background-clip:text;background-clip:text;color:transparent}
      .rbc-sub{margin:0 auto 22px;max-width:52ch;font-size:14.5px;line-height:1.55;color:#98a2b0}
      .rbc-sub strong{color:#d5dde6}

      .rbc-grade{list-style:none;margin:0 auto 22px;padding:0;max-width:820px;
        display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
      .rbc-ia{position:relative;padding:12px 14px 13px 17px;border-radius:13px;text-align:left;
        background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);overflow:hidden}
      .rbc-ia::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;
        background:var(--c);box-shadow:0 0 12px var(--c)}
      .rbc-casa{display:block;font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;
        color:#6b7683;font-style:italic}
      .rbc-nome{display:block;margin-top:3px;font-size:17px;font-weight:800;
        color:var(--c);letter-spacing:-.012em}

      .rbc-placar{margin:0 auto 20px;max-width:520px;padding:15px 16px 13px;border-radius:14px;text-align:left;
        background:rgba(0,0,0,.28);border:1px solid rgba(255,255,255,.06)}
      .rbc-placar-rotulo{display:block;font-size:10px;letter-spacing:.16em;text-transform:uppercase;
        color:#f2a900;font-weight:800;margin-bottom:11px}
      .rbc-barras{display:grid;gap:8px}
      .rbc-barra{display:grid;grid-template-columns:62px 1fr 34px;align-items:center;gap:9px}
      .rbc-barra-nome{font-size:12px;font-weight:700;color:var(--c)}
      .rbc-barra-trilho{height:7px;border-radius:99px;background:rgba(255,255,255,.07);overflow:hidden}
      .rbc-barra-preenche{height:100%;border-radius:99px;background:var(--c);
        box-shadow:0 0 10px var(--c);width:0;transition:width .8s cubic-bezier(.2,.7,.3,1)}
      .rbc-barra-num{font-size:12px;font-weight:700;color:#8b95a3;text-align:right;
        font-variant-numeric:tabular-nums}
      .rbc-placar-total{display:block;margin-top:11px;font-size:11px;color:#6b7683}

      .rbc-botao{display:inline-flex;align-items:center;justify-content:center;gap:9px;
        padding:13px 26px;border-radius:999px;font-size:14.5px;font-weight:800;color:#120d02;
        background:linear-gradient(135deg,#f7d488 0%,#f2a900 55%,#c98c00 100%);
        box-shadow:0 6px 18px rgba(242,169,0,.3)}
      .rbc-moldura:hover .rbc-botao{box-shadow:0 9px 24px rgba(242,169,0,.45)}
      .rbc-seta{font-size:16px}
      .rbc-pulso{width:8px;height:8px;border-radius:50%;background:#0f7a2e;
        box-shadow:0 0 0 0 rgba(15,122,46,.65);animation:rbcPulso 2s infinite}
      @keyframes rbcPulso{70%{box-shadow:0 0 0 9px rgba(15,122,46,0)}
        100%{box-shadow:0 0 0 0 rgba(15,122,46,0)}}

      @media (max-width:760px){.rbc-grade{grid-template-columns:repeat(2,1fr)}}
      @media (max-width:430px){.rbc-grade{grid-template-columns:1fr}
        .rbc-botao{width:100%;padding:13px 16px;font-size:13.5px}}
      @media (prefers-reduced-motion:reduce){
        .rbc-pulso{animation:none}.rbc-moldura{transition:none}}
      </style>

      <script>
      (function () {
        // Placar de verdade, somado entre todos os visitantes.
        // Antes cada navegador guardava o proprio numero no localStorage e a
        // pagina ja abria com valores inventados — ninguem tinha votado neles.
        var API = "https://stream2.radiobitcoin.org/api/votos";
        var CORES = { claude: "#cc785c", gemini: "#4285F4", gpt: "#10a37f", manus: "#a855f7" };
        var NOMES = { claude: "Claude", gemini: "Gemini", gpt: "GPT-4o", manus: "Manus" };

        function desenhar(dados) {
          var geral = dados.geral || {};
          var total = dados.total_geral || 0;
          if (!total) return;                     // sem voto ainda: nao mostra placar vazio

          var ordem = Object.keys(geral).sort(function (a, b) { return geral[b] - geral[a]; });
          var maior = geral[ordem[0]] || 1;

          document.getElementById("rbcBarras").innerHTML = ordem.map(function (id) {
            var n = geral[id] || 0;
            var pct = Math.round((n / maior) * 100);
            return '<div class="rbc-barra" style="--c:' + CORES[id] + '">' +
                   '<span class="rbc-barra-nome">' + NOMES[id] + "</span>" +
                   '<span class="rbc-barra-trilho"><span class="rbc-barra-preenche" style="width:' +
                   pct + '%"></span></span>' +
                   '<span class="rbc-barra-num">' + n + "</span></div>";
          }).join("");

          document.getElementById("rbcTotal").textContent =
            total + (total === 1 ? " voto computado" : " votos computados");
          document.getElementById("rbcPlacar").hidden = false;
        }

        // Se a API estiver fora do ar, o painel simplesmente nao mostra placar.
        // Melhor faltar o numero do que mostrar numero errado.
        fetch(API, { cache: "no-store" })
          .then(function (r) { return r.ok ? r.json() : null; })
          .then(function (d) { if (d) desenhar(d); })
          .catch(function () {});
      })();
      </script>

  </div>
</section>




