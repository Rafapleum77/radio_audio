<script>
(function(){
  function fmtDate(s){
    var d=new Date(s);
    if(isNaN(d))return s.slice(0,16);
    return d.toLocaleDateString('pt-BR',{day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'});
  }
  fetch('/livecoins.json?t='+Date.now())
    .then(function(r){return r.json();})
    .then(function(data){
      var grid=document.getElementById('lcGrid');
      var upd=document.getElementById('lcUpdated');
      if(!grid)return;
      if(upd&&data.updated) upd.textContent='atualizado '+fmtDate(data.updated);
      var arts=data.articles||[];
      if(!arts.length){grid.innerHTML='<div class="lc-empty">Sem artigos.</div>';return;}
      grid.innerHTML='';
      arts.forEach(function(a){
        var c=document.createElement('a');
        c.className='lc-card';
        c.href=a.link; c.target='_blank'; c.rel='noopener';
        c.innerHTML='<div class="lc-card__title">'+a.title+'</div>'
          +(a.desc?'<div class="lc-card__desc">'+a.desc+'</div>':'')
          +'<div class="lc-card__meta">'+fmtDate(a.date)+'</div>';
        grid.appendChild(c);
      });
    })
    .catch(function(){
      var g=document.getElementById('lcGrid');
      if(g) g.innerHTML='<div class="lc-empty">Feed temporariamente indisponível.</div>';
    });
})();
</script>
