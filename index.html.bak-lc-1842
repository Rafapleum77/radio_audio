          <p style="font-size:10px;color:#ffd966;margin:0 0 8px;line-height:1.5;">USB com <strong style="color:#fff;">código completo dos 4 bots</strong> que rodam na minha frota + Recovery Kit + Moeda BTC + Barrinha Ouro + Cartão Lightning. <strong style="color:#fff;">Infraestrutura testada</strong> · Circuit Breaker · watchdog · painel ao vivo. <span style="color:#9ca3af;">Material educacional. Bot real perde também — não há promessa de retorno.</span></p>
          <div style="border-top:1px solid #222;border-bottom:1px solid #222;padding:7px 0;margin-bottom:8px;">
            <div style="color:#f2a900;font-size:11px;margin:3px 0;">💎 PACOTE COMPLETO &nbsp;·&nbsp; <strong style="color:#fff;">4 BOTS + EXTRAS</strong> &nbsp;→&nbsp; <strong style="color:#ffd966;">$149</strong></div>
            <div style="color:#f2a900;font-size:11px;margin:3px 0;">🛡️ RECOVERY KIT &nbsp;·&nbsp; <strong style="color:#fff;">PEN DRIVE</strong> &nbsp;→&nbsp; <strong style="color:#ffd966;">$49</strong></div>
          </div>
          <div style="display:flex;align-items:center;justify-content:center;gap:8px;margin-bottom:8px;">
            <span style="font-size:9px;color:#888;">⚡ Lightning · 💵 USDT · 💶 Euro em espécie</span>
          </div>
          <a href="https://t.me/Bitadictbot" target="_blank"
             style="display:block;background:linear-gradient(180deg,#f2a900 0%,#cc8e00 100%);color:#000;font-weight:800;font-size:12px;padding:12px;border-radius:6px;text-decoration:none;letter-spacing:1.5px;text-transform:uppercase;border:1px solid rgba(255,217,102,0.6);box-shadow:0 4px 14px rgba(242,169,0,0.35), inset 0 1px 0 rgba(255,255,255,0.25);transition:transform .15s, box-shadow .15s;"
             onmouseover="this.style.transform='translateY(-1px)';this.style.boxShadow='0 6px 18px rgba(242,169,0,0.55), inset 0 1px 0 rgba(255,255,255,0.3)';"
             onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 4px 14px rgba(242,169,0,0.35), inset 0 1px 0 rgba(255,255,255,0.25)';">
            🛡️ COMPRA SEGURA — Telegram
          </a>
          <div style="font-size:9px;color:#9ca3af;margin-top:5px;letter-spacing:1px;text-transform:uppercase;text-align:center;">🔒 Atendimento verificado · sem intermediários</div>
        </div>
      </div>



      <!-- MINI WIDGET CARTEIRA (live) -->
      <div id="rb-carteira-widget" style="display:block;color:inherit;background:linear-gradient(160deg,#07090d 0%,#0b0e11 100%);border:1px solid rgba(242,169,0,0.25);border-radius:12px;padding:14px;margin:0 0 10px;box-shadow:0 4px 18px -8px rgba(242,169,0,0.3);">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;">
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:10px;color:#f2a900;letter-spacing:2px;text-transform:uppercase;">📊 Carteira BIT ADICT</div>
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:9px;color:#9ca3af;letter-spacing:1px;">balanço de hoje</div>
        </div>
        <div id="rb-cw-summary" style="display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:8px;">
          <div style="background:rgba(74,222,128,0.08);border:1px solid rgba(74,222,128,0.3);border-radius:6px;padding:6px;text-align:center;"><div style="font-size:18px;font-weight:800;color:#4ade80;" id="rb-cw-buy">·</div><div style="font-family:ui-monospace,Menlo,monospace;font-size:8px;color:#9ca3af;letter-spacing:1px;">BUY</div></div>
          <div style="background:rgba(107,114,128,0.08);border:1px solid rgba(107,114,128,0.3);border-radius:6px;padding:6px;text-align:center;"><div style="font-size:18px;font-weight:800;color:#9ca3af;" id="rb-cw-hold">·</div><div style="font-family:ui-monospace,Menlo,monospace;font-size:8px;color:#9ca3af;letter-spacing:1px;">HOLD</div></div>
          <div style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.3);border-radius:6px;padding:6px;text-align:center;"><div style="font-size:18px;font-weight:800;color:#ef4444;" id="rb-cw-sell">·</div><div style="font-family:ui-monospace,Menlo,monospace;font-size:8px;color:#9ca3af;letter-spacing:1px;">SELL</div></div>
        </div>
        <div id="rb-cw-picks" style="display:flex;flex-direction:column;gap:4px;">
          <div style="color:#9ca3af;font-size:11px;text-align:center;padding:8px 0;">carregando…</div>
        </div>
        <div id="rb-cw-ts" style="font-family:ui-monospace,Menlo,monospace;font-size:8px;color:#6b7280;text-align:center;margin-top:8px;letter-spacing:1px;">--</div>
      </div>
      <script>
      (async function(){
        try {
          const r = await fetch('/carteira.json?t=' + Date.now());
          if (!r.ok) throw new Error('http ' + r.status);
          const d = await r.json();
          document.getElementById('rb-cw-buy').textContent  = d.resumo.buy_signals;
          document.getElementById('rb-cw-hold').textContent = d.resumo.hold_signals;
          document.getElementById('rb-cw-sell').textContent = d.resumo.sell_signals;
          const ts = new Date(d.gerado_em);
          document.getElementById('rb-cw-ts').textContent = '⟳ ' + ts.toLocaleString('pt-BR', {hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit'});
          // Nomes dos ativos ficam no painel pago "Onde Investir Hoje".
          // Aqui só o teaser com a contagem.
          const nBuy = d.resumo.buy_signals || 0;
          const target = document.getElementById('rb-cw-picks');
          if (nBuy === 0) {
            target.innerHTML = '<div style="color:#9ca3af;font-size:11px;text-align:center;padding:8px 0;">sem oportunidades de compra agora</div>';
          } else {
            target.innerHTML = '<div onclick="document.getElementById(\'oih-panel\').scrollIntoView({behavior:\'smooth\',block:\'center\'})" style="cursor:pointer;text-align:center;background:rgba(0,255,65,0.06);border:1px dashed rgba(0,255,65,0.35);border-radius:8px;padding:10px;">'
              + '<div style="font-size:12px;color:#fff;">🔒 <b style="color:#00ff41;">' + nBuy + ' oportunidades de compra</b> hoje</div>'
              + '<div style="font-size:10px;color:#9ca3af;margin-top:3px;">veja os nomes em <b style="color:#00ff41;">Onde Investir Hoje ↓</b></div></div>';
          }
        } catch(e) {
          document.getElementById('rb-cw-picks').innerHTML = '<div style="color:#ef4444;font-size:10px;text-align:center;">offline</div>';
        }
      })();
      </script>
      <!-- FIM MINI WIDGET CARTEIRA -->

      <!-- ===== ONDE INVESTIR HOJE (conteúdo premium via Lightning) ===== -->
      <div id="oih-panel" style="background:linear-gradient(160deg,#0a1206 0%,#0b0e11 100%);border:1px solid rgba(0,255,65,0.3);border-radius:12px;padding:14px;margin:0 0 10px;box-shadow:0 4px 18px -8px rgba(0,255,65,0.25);">
        <div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;">
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:11px;color:#00ff41;letter-spacing:1.5px;font-weight:700;">💰 ONDE INVESTIR HOJE</div>
          <div style="font-family:ui-monospace,Menlo,monospace;font-size:8px;color:#9ca3af;letter-spacing:1px;">ANÁLISE DA IA · AO VIVO</div>
        </div>
        <div style="font-size:12px;color:#c8d0dc;line-height:1.5;margin-bottom:10px;">
          🤖 Hoje nossa IA analisou o mercado e achou <b id="oih-count" style="color:#00ff41;">--</b> oportunidades de compra.
          <span id="oih-when" style="color:#6b7280;font-size:10px;"></span>
        </div>

        <!-- bloqueado -->
        <div id="oih-locked">
          <div id="oih-blur" style="filter:blur(6px);user-select:none;pointer-events:none;display:flex;flex-direction:column;gap:5px;margin-bottom:10px;opacity:.8;"></div>
          <div style="text-align:center;background:rgba(0,255,65,0.05);border:1px dashed rgba(0,255,65,0.35);border-radius:8px;padding:12px;">
            <div style="font-size:12px;color:#fff;margin-bottom:8px;">🔓 Veja <b>exatamente onde investir</b> agora</div>
            <button id="oih-btn" onclick="oihUnlock(this)" style="width:100%;background:linear-gradient(180deg,#00ff41,#00cc34);color:#000;font-family:'Orbitron',ui-monospace,monospace;font-size:12px;font-weight:800;letter-spacing:.5px;border:none;border-radius:8px;padding:11px;cursor:pointer;box-shadow:0 3px 12px rgba(0,255,65,0.35);">⚡ ABRIR COM BITCOIN</button>
            <div style="font-size:9px;color:#9ca3af;margin-top:7px;line-height:1.4;">1.000 satoshis — os centavinhos do Bitcoin.<br>Pagamento na hora, sem cadastro, sem cartão.</div>
          </div>
        </div>

        <!-- liberado -->
        <div id="oih-unlocked" style="display:none;">
          <div id="oih-picks" style="display:flex;flex-direction:column;gap:5px;"></div>
          <div style="font-size:9px;color:#00ff41;text-align:center;margin-top:8px;">✅ Liberado! Obrigado por apoiar com Bitcoin ⚡</div>
        </div>
        <div style="font-size:8px;color:#4b5563;text-align:center;margin-top:8px;">Não é recomendação de investimento. Análise automatizada por IA.</div>
      </div>

      <script>
      (function(){
        var PRECO_SATS = 1000;
        var LN_ADDR = 'texugorecords@walletofsatoshi.com';
        var picksCache = [];

        function hojeKey(){ var d=new Date(); return 'oih_unlocked_'+d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate(); }
        function jaLiberado(){ try { return localStorage.getItem(hojeKey())==='1'; } catch(e){ return false; } }
        function marcarLiberado(){ try { localStorage.setItem(hojeKey(),'1'); } catch(e){} }

        function renderPicks(el, blur){
          el.innerHTML = picksCache.map(function(p){
            var nome = blur ? '████████' : (p.nome||p.symbol);
            var sym  = blur ? '████' : p.symbol;
            var chg  = (p.change_pct_1d>=0?'▲':'▼')+Math.abs(p.change_pct_1d||0).toFixed(1)+'%';
            var cor  = (p.change_pct_1d>=0)?'#4ade80':'#ef4444';
            return '<div style="display:flex;justify-content:space-between;align-items:center;padding:7px 10px;background:rgba(0,255,65,0.06);border-radius:6px;border-left:3px solid #00ff41;">'
              +'<div><span style="font-family:ui-monospace,Menlo,monospace;font-weight:800;color:#fff;font-size:13px;">'+sym+'</span> <span style="font-size:10px;color:#9ca3af;">'+nome+'</span></div>'
              +'<div style="font-family:ui-monospace,Menlo,monospace;font-size:12px;color:#fff;">'+(blur?'$███':'$'+p.price)+' <span style="color:'+cor+';font-size:10px;">'+chg+'</span></div></div>';
          }).join('');
        }

        function mostrarLiberado(){
          document.getElementById('oih-locked').style.display='none';
          var u=document.getElementById('oih-unlocked'); u.style.display='block';
          renderPicks(document.getElementById('oih-picks'), false);
        }

        fetch('carteira.json?t='+Date.now()).then(function(r){return r.json();}).then(function(d){
          var buys=(d.tickers||[]).filter(function(t){return ['STRONG BUY','BUY','ACUMULAR','COMPRA'].indexOf(t.reco)>=0;});
          picksCache=buys;
          document.getElementById('oih-count').textContent=buys.length;
          if(d.gerado_em){ try{ document.getElementById('oih-when').textContent='· '+new Date(d.gerado_em).toLocaleDateString('pt-BR'); }catch(e){} }
          renderPicks(document.getElementById('oih-blur'), true);
          if(jaLiberado()) mostrarLiberado();
        }).catch(function(){ document.getElementById('oih-count').textContent='—'; });

        async function fetchInvoice(sats){
          var parts=LN_ADDR.split('@');
          var meta=await fetch('https://'+parts[1]+'/.well-known/lnurlp/'+parts[0]).then(function(r){return r.json();});
          var cb=meta.callback+(meta.callback.indexOf('?')>=0?'&':'?')+'amount='+(sats*1000)+'&comment='+encodeURIComponent('Onde Investir Hoje - Radio Bitcoin');
          var inv=await fetch(cb).then(function(r){return r.json();});
          if(!inv.pr) throw new Error('sem invoice');
          return inv.pr;
        }

        window.oihUnlock = async function(btn){
          var orig=btn.textContent;
          // 1) WebLN (Alby) — pagamento verificado em 1 clique
          if(typeof window.webln!=='undefined'){
            try{
              btn.textContent='⏳ gerando...'; btn.disabled=true;
              await window.webln.enable();
              var pr=await fetchInvoice(PRECO_SATS);
              await window.webln.sendPayment(pr); // se completa, pagou
              marcarLiberado(); mostrarLiberado(); return;
            }catch(e){ btn.disabled=false; btn.textContent=orig; }
          }
          // 2) Sem WebLN: abre QR/carteira + botão "já paguei"
          try{
            btn.textContent='⏳ invoice...'; btn.disabled=true;
            var pr2=await fetchInvoice(PRECO_SATS);
            var box=document.createElement('div');
            box.style.cssText='text-align:center;margin-top:10px;';
            box.innerHTML='<img loading="lazy" decoding="async" src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=lightning:'+pr2+'" alt="QR" style="background:#fff;padding:8px;border-radius:8px;width:180px;height:180px;">'
              +'<div style="font-size:9px;color:#9ca3af;margin:6px 0;">Escaneie com sua carteira Lightning</div>'
              +'<a href="lightning:'+pr2+'" style="display:inline-block;font-size:10px;color:#00ff41;margin-bottom:8px;">abrir carteira no celular →</a><br>'
              +'<button onclick="window.__oihPaid()" style="background:#00ff41;color:#000;border:none;border-radius:6px;padding:8px 16px;font-weight:700;font-size:11px;cursor:pointer;">✅ Já paguei, liberar</button>';
            btn.parentNode.appendChild(box);
            btn.style.display='none';
            window.__oihPaid=function(){ marcarLiberado(); mostrarLiberado(); };
          }catch(e2){ btn.disabled=false; btn.textContent=orig; alert('Não consegui gerar o pagamento agora. Tente de novo.'); }
        };
      })();
      </script>
      <!-- ===== FIM ONDE INVESTIR HOJE ===== -->

      <!-- STATS -->
      <div class="stats-row">
        <div class="stat-card">
          <div class="k">DOMINÂNCIA BTC</div>
