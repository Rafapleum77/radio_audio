<script>
(function(){
  var b=document.getElementById('rbMenuBtn'),o=document.getElementById('rbNavOverlay'),
      d=document.getElementById('rbNavDrawer'),x=document.getElementById('rbNavX');
  function open(){o.classList.add('on');d.classList.add('on');}
  function close(){o.classList.remove('on');d.classList.remove('on');}
  b.addEventListener('click',open); x.addEventListener('click',close); o.addEventListener('click',close);
  d.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click',function(e){
      var t=document.querySelector(a.getAttribute('href'));
      if(t){e.preventDefault();close();setTimeout(function(){t.scrollIntoView({behavior:'smooth',block:'start'});},180);}
    });
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape')close();});
})();
</script>


